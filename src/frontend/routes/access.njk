<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <title>Enter Fan Code</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      window.db = getFirestore(app);
      window.doc = doc; window.getDoc = getDoc;
      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
        html, body { height: 100%; overscroll-behavior: none; }
        body { background: #1a1226; height: 100vh; width: 100vw; display: flex; justify-content: center; align-items: center; overflow: hidden; font-family: 'Playfair Display', serif; touch-action: manipulation; }

        .app-wrapper {
            position: relative; width: 100vw; height: 100vh;
            display: flex; flex-direction: column;
            background: linear-gradient(135deg, #1a1226 0%, #2a1b18 50%, #1a1226 100%);
            overflow: hidden;
        }
        .app-wrapper::before {
            content: '';
            position: absolute; inset: 0;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" opacity="0.06"><filter id="noise"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23noise)"/></svg>');
            pointer-events: none;
        }

        /* Language selector top-right */
        .lang-select {
            position: absolute; top: 20px; right: 20px; z-index: 10;
            background: rgba(255,255,255,0.06); color: #d4c4a8;
            border: 1px solid rgba(212,196,168,0.4);
            padding: 6px 12px; border-radius: 6px;
            font-family: sans-serif; font-size: 13px;
            cursor: pointer; outline: none;
            backdrop-filter: blur(5px);
        }
        .lang-select option { background: #1e1e2f; color: white; }

        /* Center stage */
        .stage {
            flex: 1; display: flex; justify-content: center; align-items: center;
            flex-direction: column; padding: 30px; position: relative; z-index: 2;
            transition: transform 0.9s cubic-bezier(0.6, 0.05, 0.28, 0.91);
        }
        .stage.shifted { transform: translateY(-90px); }

        /* Powered by Menai */
        .powered-block {
            text-align: center;
            transition: opacity 0.6s ease;
        }
        .powered-by {
            font-family: sans-serif; font-size: 12px;
            text-transform: uppercase; letter-spacing: 4px;
            color: #d4c4a8; opacity: 0.7; margin-bottom: 12px;
        }
        .brand-name {
            font-family: 'Caveat', cursive; font-size: 54px;
            background: linear-gradient(90deg, #00d2ff, #ff00cc, #00d2ff);
            background-size: 200% 100%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            animation: brandShimmer 4s linear infinite;
            text-shadow: 0 0 40px rgba(255, 0, 204, 0.3);
            line-height: 1.1;
        }
        @keyframes brandShimmer {
            0% { background-position: 0% 0; }
            100% { background-position: 200% 0; }
        }

        /* Code entry form — hidden until stage 2 */
        .code-block {
            width: 100%; max-width: 340px;
            margin-top: 40px;
            opacity: 0; transform: translateY(20px);
            pointer-events: none;
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        .code-block.active {
            opacity: 1; transform: translateY(0);
            pointer-events: auto;
        }
        .code-label {
            font-family: sans-serif; font-size: 11px;
            text-transform: uppercase; letter-spacing: 3px;
            color: #d4c4a8; opacity: 0.7; text-align: center;
            margin-bottom: 12px;
        }
        .code-input {
            width: 100%; padding: 16px 20px;
            background: rgba(255,255,255,0.06);
            border: 2px solid rgba(212,196,168,0.3);
            border-radius: 12px;
            color: white; font-family: monospace;
            font-size: 18px; text-align: center;
            letter-spacing: 3px; outline: none;
            transition: border-color 0.3s, box-shadow 0.3s;
            backdrop-filter: blur(5px);
        }
        .code-input:focus {
            border-color: #00d2ff;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.3);
        }
        .code-input.shake {
            animation: shake 0.4s ease-in-out;
            border-color: #ef4444 !important;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            50% { transform: translateX(10px); }
            75% { transform: translateX(-10px); }
        }
        .code-error {
            font-family: sans-serif; font-size: 13px;
            color: #ef4444; text-align: center;
            margin-top: 10px; min-height: 18px;
            opacity: 0; transition: opacity 0.3s;
        }
        .code-error.active { opacity: 1; }
        .code-submit {
            margin-top: 20px; width: 100%; padding: 16px;
            background: linear-gradient(45deg, #00d2ff, #3a7bd5);
            color: white; border: none; border-radius: 12px;
            font-family: sans-serif; font-size: 16px; font-weight: bold;
            cursor: pointer; letter-spacing: 2px;
            transition: 0.2s;
            box-shadow: 0 4px 20px rgba(0, 210, 255, 0.4);
        }
        .code-submit:hover:not(:disabled) {
            transform: scale(1.02);
            box-shadow: 0 6px 25px rgba(0, 210, 255, 0.6);
        }
        .code-submit:disabled {
            background: #4b5563; cursor: not-allowed;
            box-shadow: none;
        }

        /* ===== SUCCESS LOADING OVERLAY ===== */
        .loading-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(20, 15, 30, 0.97);
            backdrop-filter: blur(12px);
            display: none; justify-content: center; align-items: center;
            flex-direction: column; z-index: 2000; padding: 30px;
        }
        .loading-overlay.active { display: flex; }
        .loading-box { text-align: center; max-width: 360px; width: 90%; }
        .loading-spinner {
            width: 60px; height: 60px; margin: 0 auto 25px auto;
            border: 4px solid rgba(255,255,255,0.1);
            border-left-color: #00d2ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loading-headline {
            font-family: 'Caveat', cursive; font-size: 32px;
            color: #fff; margin-bottom: 10px;
            text-shadow: 0 0 20px rgba(0, 210, 255, 0.5);
        }
        .loading-sub {
            font-family: 'Playfair Display', serif; font-style: italic;
            font-size: 14px; color: #d4c4a8;
            line-height: 1.6; margin-bottom: 25px;
        }
        .loading-progress {
            width: 100%; height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 3px; overflow: hidden;
        }
        .loading-bar {
            height: 100%; width: 0%;
            background: linear-gradient(90deg, #00d2ff, #ff00cc, #00d2ff);
            background-size: 200% 100%;
            animation: barShimmer 2s linear infinite;
            border-radius: 3px;
            transition: width 0.3s linear;
        }
        @keyframes barShimmer {
            0% { background-position: 0% 0; }
            100% { background-position: 200% 0; }
        }
        .loading-pct {
            font-family: sans-serif; font-size: 12px;
            color: #d4c4a8; margin-top: 12px;
            letter-spacing: 2px;
        }

        @media (min-width: 769px) {
            .app-wrapper {
                max-width: 500px; height: 90vh;
                border-radius: 20px;
                box-shadow: 0 20px 60px rgba(0,0,0,0.8);
                overflow: hidden;
            }
        }
    </style>
</head>
<body>

    <div class="app-wrapper">
        <select id="langSelect" class="lang-select" onchange="changeLanguage(this.value)">
            <option value="en">EN</option>
            <option value="pl">PL</option>
            <option value="hu">HU</option>
        </select>

        <div class="stage" id="stage">
            <div class="powered-block">
                <div class="powered-by" id="poweredByLabel">Powered by</div>
                <div class="brand-name" id="brandNameLabel">Menai</div>
            </div>

            <div class="code-block" id="codeBlock">
                <div class="code-label" id="codeLabel">Input Fan Code</div>
                <input type="text" id="codeInput" class="code-input" 
                       inputmode="numeric" autocomplete="off" spellcheck="false">
                <div class="code-error" id="codeError"></div>
                <button class="code-submit" id="codeSubmit" onclick="submitCode()">Enter</button>
            </div>
        </div>
    </div>

    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-box">
            <div class="loading-spinner"></div>
            <div class="loading-headline" id="loadingHeadline">Access granted</div>
            <div class="loading-sub" id="loadingSub">Preparing your fanbook experience…</div>
            <div class="loading-progress"><div class="loading-bar" id="loadingBar"></div></div>
            <div class="loading-pct" id="loadingPct">0%</div>
        </div>
    </div>

<script>
    const translations = {
        en: {
            powered_by: "Powered by",
            default_brand: "Menai",
            input_code_label: "Input Fan Code",
            enter_btn: "Enter",
            error_empty: "Please enter your fan code.",
            error_wrong: "That code is not valid. Please try again.",
            loading_headline: "Access granted",
            loading_sub: "Preparing your fanbook experience…"
        },
        pl: {
            powered_by: "Napędzane przez",
            default_brand: "Menai",
            input_code_label: "Wpisz kod fana",
            enter_btn: "Wejdź",
            error_empty: "Proszę wpisać kod fana.",
            error_wrong: "Ten kod jest nieprawidłowy. Spróbuj ponownie.",
            loading_headline: "Dostęp przyznany",
            loading_sub: "Przygotowujemy Twoje doświadczenie…"
        },
        hu: {
            powered_by: "Működteti",
            default_brand: "Menai",
            input_code_label: "Írja be a rajongói kódot",
            enter_btn: "Belépés",
            error_empty: "Kérjük, adja meg a rajongói kódot.",
            error_wrong: "Ez a kód érvénytelen. Próbálja újra.",
            loading_headline: "Hozzáférés megadva",
            loading_sub: "Előkészítjük az élményét…"
        }
    };

    let currentLang = "en";
    let customPoweredBy = "Powered by";
    let customBrandName = "Menai";
    let validFanCode = "123456789";

    function t(key) {
        if (translations[currentLang] && translations[currentLang][key]) return translations[currentLang][key];
        return translations.en[key] || key;
    }

    function detectLang() {
        const saved = localStorage.getItem('selectedLanguage');
        if (saved && translations[saved]) return saved;
        const nav = (navigator.language || navigator.userLanguage || "en").toLowerCase();
        if (nav.startsWith("pl")) return "pl";
        if (nav.startsWith("hu")) return "hu";
        return "en";
    }

    function applyTranslations() {
        currentLang = detectLang();
        document.getElementById('poweredByLabel').textContent = customPoweredBy || t('powered_by');
        document.getElementById('brandNameLabel').textContent = customBrandName || t('default_brand');
        document.getElementById('codeLabel').textContent = t('input_code_label');
        document.getElementById('codeSubmit').textContent = t('enter_btn');
        document.getElementById('loadingHeadline').textContent = t('loading_headline');
        document.getElementById('loadingSub').textContent = t('loading_sub');
        document.getElementById('langSelect').value = currentLang;
    }

    function changeLanguage(lang) {
        localStorage.setItem('selectedLanguage', lang);
        currentLang = lang;
        applyTranslations();
    }

    // Stage 1 → Stage 2 transition after 2 seconds
    document.addEventListener('DOMContentLoaded', () => {
        applyTranslations();

        setTimeout(() => {
            document.getElementById('stage').classList.add('shifted');
            document.getElementById('codeBlock').classList.add('active');
            // Focus the input after the animation starts
            setTimeout(() => document.getElementById('codeInput').focus(), 400);
        }, 2000);

        // Allow Enter key to submit
        document.getElementById('codeInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') submitCode();
        });
    });

    // Load custom settings from Firestore
    window.addEventListener('firebaseLoaded', async () => {
        try {
            const landingSnap = await window.getDoc(window.doc(window.db, "app_settings", "landing"));
            if (landingSnap.exists()) {
                const data = landingSnap.data();
                if (data.poweredBy) customPoweredBy = data.poweredBy;
                if (data.brandName) customBrandName = data.brandName;
                if (data.fanCode) validFanCode = data.fanCode;
                applyTranslations();
            }
        } catch (e) {
            console.warn("Could not load landing settings, using defaults:", e);
        }
    });

    function submitCode() {
        const input = document.getElementById('codeInput');
        const errorEl = document.getElementById('codeError');
        const submitBtn = document.getElementById('codeSubmit');
        const val = input.value.trim();

        errorEl.classList.remove('active');
        errorEl.textContent = '';

        if (val === '') {
            input.classList.add('shake');
            setTimeout(() => input.classList.remove('shake'), 500);
            errorEl.textContent = t('error_empty');
            errorEl.classList.add('active');
            return;
        }

        if (val !== validFanCode) {
            input.classList.add('shake');
            setTimeout(() => input.classList.remove('shake'), 500);
            errorEl.textContent = t('error_wrong');
            errorEl.classList.add('active');
            input.value = '';
            return;
        }

        // Success — save access and show loading
        sessionStorage.setItem('accessGranted', 'true');
        submitBtn.disabled = true;
        runSuccessLoading();
    }

    function runSuccessLoading() {
        const overlay = document.getElementById('loadingOverlay');
        const bar = document.getElementById('loadingBar');
        const pctEl = document.getElementById('loadingPct');
        overlay.classList.add('active');

        const totalMs = 4000;  // 4 seconds
        const start = Date.now();

        const timer = setInterval(() => {
            const elapsed = Date.now() - start;
            const pct = Math.min(100, Math.round((elapsed / totalMs) * 100));
            bar.style.width = pct + '%';
            pctEl.textContent = pct + '%';
            if (elapsed >= totalMs) {
                clearInterval(timer);
                window.location.href = '/my-website/artists/';
            }
        }, 100);
    }
</script>
</body>
</html>
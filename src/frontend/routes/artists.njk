            input_code_label: "Unesite kod obožavaoca",
            enter_btn: "Uđi",
            error_empty: "Molimo unesite kod obožavaoca.",
            error_wrong: "Taj kod nije važeći. Pokušajte ponovo.",
            success_headline: "Pristup odobren",
            success_sub: "Pripremamo vašu listu umetnika…"
        },
        bs: {
            select_celebrity: "Odaberite svoju zvijezdu",
            page_load_title: "Pripremamo vaše iskustvo",
            page_load_sub: "Povezivanje sa mrežom umjetnika…",
            gate_loading_title: "Provjera vašeg zapisa",
            gate_loading_sub: "Verifikacija statusa članstva…",
            gate_title: "Pristup odbijen",
            gate_btn: "Razumijem",
            powered_by: "Pokreće",
            input_code_label: "Unesite kod obožavatelja",
            enter_btn: "Uđi",
            error_empty: "Molimo unesite kod obožavatelja.",
            error_wrong: "Taj kod nije važeći. Pokušajte ponovo.",
            success_headline: "Pristup odobren",
            success_sub: "Pripremamo vašu listu umjetnika…"
        }
    };

    let currentLang = "en";
    function t(key) {
        if (translations[currentLang] && translations[currentLang][key]) return translations[currentLang][key];
        return translations.en[key] || key;
    }

    function detectLang() {
        const saved = localStorage.getItem('selectedLanguage');
        if (saved && translations[saved]) return saved;
        const nav = (navigator.language || navigator.userLanguage || "en").toLowerCase();
        if (nav.startsWith("pl")) return "pl";
        if (nav.startsWith("hu")) return "hu";
        if (nav.startsWith("sr")) return "sr";
        if (nav.startsWith("bs")) return "bs";
        return "en";
    }

    function applyTranslation() {
        currentLang = detectLang();

        const titleElement = document.getElementById('headerTitle');
        if (titleElement) titleElement.textContent = t('select_celebrity');
        const select = document.getElementById('langSelect');
        if (select) select.value = currentLang;

        document.getElementById('pageLoadTitle').textContent = t('page_load_title');
        document.getElementById('pageLoadSub').textContent = t('page_load_sub');
        document.getElementById('gateLoadingTitle').textContent = t('gate_loading_title');
        document.getElementById('gateLoadingSub').textContent = t('gate_loading_sub');
        document.getElementById('gateTitle').textContent = t('gate_title');
        document.querySelector('.btn-gate-close').textContent = t('gate_btn');

        document.getElementById('poweredByLabel').textContent = customPoweredBy || t('powered_by');
        document.getElementById('brandNameLabel').textContent = customBrandName || 'Menai';
        document.getElementById('accessCodeLabel').textContent = t('input_code_label');
        document.getElementById('accessCodeSubmit').textContent = t('enter_btn');
        document.getElementById('successHeadline').textContent = t('success_headline');
        document.getElementById('successSub').textContent = t('success_sub');
    }

    document.addEventListener("DOMContentLoaded", applyTranslation);
    function changeLanguage(lang) { localStorage.setItem('selectedLanguage', lang); location.reload(); }

    function isAccessValid() {
        const granted = sessionStorage.getItem('accessGranted');
        const at = parseInt(sessionStorage.getItem('accessGrantedAt') || '0', 10);
        if (granted !== 'true' || !at) return false;
        return (Date.now() - at) < ACCESS_TIMEOUT_MS;
    }

    function grantAccess() {
        sessionStorage.setItem('accessGranted', 'true');
        sessionStorage.setItem('accessGrantedAt', String(Date.now()));
    }

    function touchAccess() {
        if (sessionStorage.getItem('accessGranted') === 'true') {
            sessionStorage.setItem('accessGrantedAt', String(Date.now()));
        }
    }

    function startAccessFlow() {
        if (isAccessValid()) {
            const stage = document.getElementById('accessStage');
            if (stage) {
                stage.classList.add('hide');
                setTimeout(() => { if (stage.parentNode) stage.remove(); }, 700);
            }
            runPageLoad();
            return;
        }

        sessionStorage.removeItem('accessGranted');
        sessionStorage.removeItem('accessGrantedAt');

        setTimeout(() => {
            document.getElementById('accessInner').classList.add('shifted');
            document.getElementById('accessCodeBlock').classList.add('active');
            setTimeout(() => document.getElementById('accessCodeInput').focus(), 400);
        }, 2000);

        document.getElementById('accessCodeInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') submitAccessCode();
        });
    }

    function submitAccessCode() {
        const input = document.getElementById('accessCodeInput');
        const errorEl = document.getElementById('accessCodeError');
        const submitBtn = document.getElementById('accessCodeSubmit');
        const val = input.value.trim();

        errorEl.classList.remove('active');
        errorEl.textContent = '';

        if (val === '') {
            input.classList.add('shake');
            setTimeout(() => input.classList.remove('shake'), 500);
            errorEl.textContent = t('error_empty');
            errorEl.classList.add('active');
            return;
        }

        if (val !== validFanCode) {
            input.classList.add('shake');
            setTimeout(() => input.classList.remove('shake'), 500);
            errorEl.textContent = t('error_wrong');
            errorEl.classList.add('active');
            input.value = '';
            return;
        }

        grantAccess();
        submitBtn.disabled = true;
        runSuccessLoading();
    }

    function runSuccessLoading() {
        const overlay = document.getElementById('successOverlay');
        const bar = document.getElementById('successBar');
        const pctEl = document.getElementById('successPct');
        overlay.classList.add('active');

        const totalMs = 4000;
        const start = Date.now();

        const timer = setInterval(() => {
            const elapsed = Date.now() - start;
            const pct = Math.min(100, Math.round((elapsed / totalMs) * 100));
            bar.style.width = pct + '%';
            pctEl.textContent = pct + '%';
            if (elapsed >= totalMs) {
                clearInterval(timer);
                const stage = document.getElementById('accessStage');
                if (stage) stage.classList.add('hide');
                overlay.classList.remove('active');
                setTimeout(() => {
                    if (stage && stage.parentNode) stage.remove();
                    runPageLoad();
                }, 700);
            }
        }, 100);
    }

    function runPageLoad() {
        const overlay = document.getElementById('pageLoadOverlay');
        const bar = document.getElementById('pageLoadBar');
        const pctEl = document.getElementById('pageLoadPct');

        const totalMs = Math.floor(Math.random() * 3000) + 7000;
        const start = Date.now();

        const timer = setInterval(() => {
            const elapsed = Date.now() - start;
            const pct = Math.min(100, Math.round((elapsed / totalMs) * 100));
            bar.style.width = pct + '%';
            pctEl.textContent = pct + '%';
            if (elapsed >= totalMs) {
                clearInterval(timer);
                overlay.classList.add('hide');
                setTimeout(() => overlay.remove(), 900);
            }
        }, 100);
    }

    ['scroll', 'click', 'keydown', 'touchstart'].forEach(evt => {
        document.addEventListener(evt, touchAccess, { passive: true });
    });

    document.addEventListener('DOMContentLoaded', startAccessFlow);

    window.addEventListener('firebaseLoaded', async () => {
        try {
            const landingSnap = await window.getDoc(window.doc(window.db, "app_settings", "landing"));
            if (landingSnap.exists()) {
                const data = landingSnap.data();
                if (data.poweredBy) customPoweredBy = data.poweredBy;
                if (data.brandName) customBrandName = data.brandName;
                if (data.fanCode) validFanCode = data.fanCode;
                applyTranslation();
            }
        } catch (e) {}

        try {
            const supportRef = window.doc(window.db, "app_settings", "support");
            const supportSnap = await window.getDoc(supportRef);
            if (supportSnap.exists() && supportSnap.data().accessDenied) {
                customGateMessage = supportSnap.data().accessDenied;
                document.getElementById('gateMessageText').textContent = customGateMessage;
            }
        } catch (e) {}

        const list = document.getElementById('artistList');
        list.innerHTML = '';

        try {
            const snapshot = await window.getDocs(window.collection(window.db, "celebrities"));
            
            if (snapshot.empty) {
                list.innerHTML = '<p style="text-align: center; color: #888;">No celebrities added yet. Check the Master Editor.</p>';
            } else {
                snapshot.forEach(docSnap => {
                    const artist = docSnap.data();
                    const item = document.createElement('div');
                    item.className = 'artist-list-item';
                    item.onclick = () => handleArtistClick(artist);

                    const avatarHTML = artist.imageUrl 
                        ? `<div class="artist-list-avatar" style="background-image: url('${artist.imageUrl}');"></div>`
                        : `<div class="artist-list-avatar" style="background:${artist.bgColor || '#3a7bd5'}">${artist.name.charAt(0).toUpperCase()}</div>`;

                    const subtitle = artist.customText || "Enter Fanbook";
                    const verifiedHTML = artist.isVerified 
                        ? `<svg class="verified-badge" viewBox="0 0 24 24"><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .495.083.965.238 1.4-1.272.65-2.147 2.018-2.147 3.6 0 1.495.782 2.798 1.942 3.486-.02.17-.032.34-.032.514 0 2.21 1.708 4 3.818 4 .47 0 .92-.086 1.335-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.865.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.174-.012-.344-.033-.513 1.158-.687 1.943-1.99 1.943-3.484zm-6.616-3.334l-4.334 6.5c-.145.217-.382.334-.625.334-.143 0-.288-.04-.416-.126l-.115-.094-2.415-2.415c-.293-.293-.293-.768 0-1.06s.768-.294 1.06 0l1.77 1.767 3.825-5.74c.23-.345.696-.436 1.04-.207.346.23.44.696.21 1.04z"/></svg>` 
                        : '';

                    item.innerHTML = `
                        ${avatarHTML}
                        <div class="artist-list-info">
                            <h3>${artist.name} ${verifiedHTML}</h3>
                            <p>${subtitle}</p>
                        </div>
                    `;
                    list.appendChild(item);
                });
            }
        } catch (e) {
            console.error("Error loading celebrities: ", e);
            list.innerHTML = '<p style="text-align: center; color: red;">Failed to load. Check console.</p>';
        }
        applyTranslation(); 
    });

    function handleArtistClick(artist) {
        if (artist.access === 'gated') {
            showGateSequence();
            return;
        }
        selectArtist(artist);
    }

    function showGateSequence() {
        const gateLoading = document.getElementById('gateLoadingOverlay');
        const gateOverlay = document.getElementById('gateOverlay');
        gateLoading.classList.add('active');
        const totalMs = Math.floor(Math.random() * 2000) + 3000;
        setTimeout(() => {
            gateLoading.classList.remove('active');
            gateOverlay.classList.add('active');
        }, totalMs);
    }

    function closeGate() {
        document.getElementById('gateOverlay').classList.remove('active');
    }

    function selectArtist(artist) {
        const overlay = document.getElementById('transitionOverlay');
        const loading = document.getElementById('loadingState');
        const reveal = document.getElementById('revealCard');

        overlay.classList.add('active');
        loading.style.display = 'block';
        reveal.classList.remove('active');

        const delay = Math.floor(Math.random() * 3000) + 3000;

        setTimeout(() => {
            loading.style.display = 'none';
            
            const avatarElement = document.getElementById('revealAvatar');
            if (artist.imageUrl) {
                avatarElement.style.backgroundImage = `url('${artist.imageUrl}')`;
                avatarElement.textContent = "";
            } else {
                avatarElement.style.backgroundImage = "none";
                avatarElement.style.background = artist.bgColor || '#3a7bd5';
                avatarElement.textContent = artist.name.charAt(0).toUpperCase();
            }

            const nameElement = document.getElementById('revealName');
            nameElement.innerHTML = artist.name;
            if (artist.isVerified) {
                nameElement.innerHTML += ` <svg class="verified-badge" style="width:24px; height:24px;" viewBox="0 0 24 24"><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .495.083.965.238 1.4-1.272.65-2.147 2.018-2.147 3.6 0 1.495.782 2.798 1.942 3.486-.02.17-.032.34-.032.514 0 2.21 1.708 4 3.818 4 .47 0 .92-.086 1.335-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.865.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.174-.012-.344-.033-.513 1.158-.687 1.943-1.99 1.943-3.484zm-6.616-3.334l-4.334 6.5c-.145.217-.382.334-.625.334-.143 0-.288-.04-.416-.126l-.115-.094-2.415-2.415c-.293-.293-.293-.768 0-1.06s.768-.294 1.06 0l1.77 1.767 3.825-5.74c.23-.345.696-.436 1.04-.207.346.23.44.696.21 1.04z"/></svg>`;
            }

            document.getElementById('revealMessage').textContent = artist.message || "Thank you for being a fan!";

            sessionStorage.setItem('selectedArtist', JSON.stringify(artist));
            reveal.classList.add('active');
        }, delay);
    }

    function goToFanbook() {
        window.location.href = '/my-website/fanbook/';
    }
</script>
</body>
</html>
layout: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Support Center</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, addDoc, query, orderBy, onSnapshot, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      const db = getFirestore(app);

      window.db = db;
      window.collection = collection;
      window.addDoc = addDoc;
      window.query = query;
      window.orderBy = orderBy;
      window.onSnapshot = onSnapshot;
      window.serverTimestamp = serverTimestamp;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background: #e5e7eb; height: 100vh; display: flex; justify-content: center; align-items: center; }
        .login-screen { background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); text-align: center; width: 100%; max-width: 350px; }
        .login-screen h2 { color: #ef4444; margin-bottom: 20px; }
        .login-screen input { width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; text-align: center; }
        .login-screen button { width: 100%; padding: 12px; background: #ef4444; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; }
        .dashboard { display: none; width: 100vw; height: 100vh; background: #fff; overflow: hidden; }
        .dashboard.active { display: flex; }
        .sidebar { width: 320px; background: #f9fafb; border-right: 1px solid #e5e7eb; display: flex; flex-direction: column; }
        .sidebar-header { padding: 20px; background: #ef4444; color: white; font-weight: bold; font-size: 18px; }
        .user-list { flex-grow: 1; overflow-y: auto; }
        .user-item { padding: 15px 20px; border-bottom: 1px solid #e5e7eb; cursor: pointer; transition: 0.2s; }
        .user-item:hover { background: #e5e7eb; }
        .user-item.active { background: #fee2e2; border-left: 4px solid #ef4444; }
        .user-item h4 { font-size: 14px; color: #1f2937; margin-bottom: 4px; }
        .user-item p { font-size: 12px; color: #6b7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .chat-main { flex-grow: 1; display: flex; flex-direction: column; background: #f3f4f6; }
        .chat-header { padding: 15px 20px; background: #fff; border-bottom: 1px solid #e5e7eb; font-weight: bold; color: #1f2937; }
        .chat-messages { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 10px; }
        .message { max-width: 70%; padding: 10px 15px; border-radius: 10px; font-size: 14px; }
        .msg-user { align-self: flex-start; background: #fff; border: 1px solid #e5e7eb; color: #1f2937; }
        .msg-agent { align-self: flex-end; background: #ef4444; color: #fff; }
        .chat-input-area { padding: 15px 20px; background: #fff; border-top: 1px solid #e5e7eb; display: flex; gap: 10px; }
        .chat-input-area input { flex-grow: 1; padding: 12px; border: 1px solid #ccc; border-radius: 8px; outline: none; }
        .chat-input-area button { padding: 12px 20px; background: #ef4444; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>

    <div class="login-screen" id="loginScreen">
        <h2>Admin Access</h2>
        <input type="password" id="adminPass" placeholder="Enter password">
        <button onclick="login()">Login</button>
    </div>

    <div class="dashboard" id="dashboard">
        <div class="sidebar">
            <div class="sidebar-header">Support Inbox</div>
            <div class="user-list" id="userList"></div>
        </div>
        <div class="chat-main">
            <div class="chat-header" id="chatHeader">Select a conversation</div>
            <div class="chat-messages" id="chatMessages"></div>
            <div class="chat-input-area">
                <input type="text" id="adminInput" placeholder="Type reply..." onkeypress="handleEnter(event)">
                <button onclick="sendAdminReply()">Send</button>
            </div>
        </div>
    </div>

<script>
    const ADMIN_PASSWORD = "admin123"; 
    let currentRoomId = null;
    let allMessages = [];
    let isFirebaseReady = false;

    window.addEventListener('firebaseLoaded', () => {
        isFirebaseReady = true;
        if (document.getElementById('dashboard').classList.contains('active')) {
            startListening();
        }
    });

    function login() {
        if (document.getElementById('adminPass').value === ADMIN_PASSWORD) {
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('dashboard').classList.add('active');
            if (isFirebaseReady) startListening();
        } else {
            alert("Wrong password");
        }
    }

    function startListening() {
        const q = window.query(window.collection(window.db, "support_messages"), window.orderBy("timestamp"));
        
        window.onSnapshot(q, (snapshot) => {
            allMessages = [];
            snapshot.forEach(doc => {
                allMessages.push({ id: doc.id, ...doc.data() });
            });
            updateUserList();
            if (currentRoomId) renderChat();
        });
    }

    function updateUserList() {
        const list = document.getElementById('userList');
        list.innerHTML = '';

        const rooms = {};
        allMessages.forEach(msg => {
            if (!msg.roomId) return; // Skip messages without a room ID
            if (!rooms[msg.roomId]) rooms[msg.roomId] = [];
            rooms[msg.roomId].push(msg);
        });

        const roomIds = Object.keys(rooms);
        if (roomIds.length === 0) {
            list.innerHTML = '<div style="padding:20px; color:#888;">No messages yet.</div>';
            return;
        }

        roomIds.forEach(id => {
            const roomMessages = rooms[id];
            const lastMsg = roomMessages[roomMessages.length - 1].text;
            
            const div = document.createElement('div');
            div.className = `user-item ${currentRoomId === id ? 'active' : ''}`;
            div.onclick = () => selectRoom(id);
            div.innerHTML = `
                <h4>Fan #${id}</h4>
                <p>${lastMsg}</p>
            `;
            list.appendChild(div);
        });
    }

    function selectRoom(roomId) {
        currentRoomId = roomId;
        document.getElementById('chatHeader').textContent = `Chatting with Fan #${roomId}`;
        updateUserList(); 
        renderChat();
    }

    function renderChat() {
        const chatArea = document.getElementById('chatMessages');
        chatArea.innerHTML = '';
        
        const roomMessages = allMessages.filter(msg => msg.roomId === currentRoomId);
        
        roomMessages.forEach(msg => {
            const div = document.createElement('div');
            div.className = `message msg-${msg.sender}`;
            div.textContent = msg.text;
            chatArea.appendChild(div);
        });
        
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    async function sendAdminReply() {
        if (!currentRoomId) return alert("Select a fan first!");
        const input = document.getElementById('adminInput');
        const text = input.value.trim();
        if (text === "") return;
        input.value = "";
        
        try {
            await window.addDoc(window.collection(window.db, "support_messages"), {
                text: text,
                sender: "agent", 
                roomId: currentRoomId, 
                timestamp: window.serverTimestamp()
            });
        } catch (e) {
            console.error("Error sending: ", e);
        }
    }

    function handleEnter(event) {
        if (event.key === 'Enter') sendAdminReply();
    }
</script>
</body>
</html>
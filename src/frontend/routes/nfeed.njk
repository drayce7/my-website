---
title: "Fanbook Access"
permalink: "/nrewards/"
layout: false
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Fanbook Access</title>
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";
      const firebaseConfig = { apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw", authDomain: "clbomb.firebaseapp.com", projectId: "clbomb", storageBucket: "clbomb.firebasestorage.app", messagingSenderId: "515939060816", appId: "1:515939060816:web:8a68d9d5f40b02c9029555" };
      const app = initializeApp(firebaseConfig); window.db = getFirestore(app);
      window.collection = collection; window.getDocs = getDocs;
      window.firebaseReady = true; window.dispatchEvent(new Event('firebaseLoaded'));
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        body { background: #0a1128; min-height: 100vh; font-family: 'Playfair Display', serif; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        
        .lang-switch { position: absolute; top: 20px; right: 20px; background: transparent; color: #e2e8f0; border: 1px solid #e2e8f0; padding: 5px 10px; border-radius: 5px; outline: none; }
        .lang-switch option { background: #0a1128; }
        
        h1 { color: #e2e8f0; font-family: 'Caveat', cursive; font-size: 42px; margin: 40px 0 20px 0; text-align: center; }
        .list-area { width: 100%; max-width: 600px; display: flex; flex-direction: column; gap: 15px; padding-bottom: 50px; }
        
        .artist-card { background: rgba(17, 24, 39, 0.8); border: 2px solid rgba(226, 232, 240, 0.2); border-radius: 15px; padding: 15px; display: flex; align-items: center; gap: 15px; cursor: pointer; transition: 0.2s; position: relative; }
        .artist-card:hover { transform: scale(1.02); border-color: #3b82f6; }
        .artist-img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; }
        .artist-info h2 { color: #fff; font-size: 20px; margin-bottom: 5px; display: flex; align-items: center; gap: 8px; }
        .artist-info p { color: #8a7b72; font-size: 14px; }
        
        .verified-badge { width: 18px; height: 18px; fill: #1d9bf0; }
        .locked-icon { position: absolute; top: 15px; right: 15px; font-size: 18px; }

        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-overlay.active { display: flex; }
        .modal-box { background: #111827; border: 2px solid #ef4444; padding: 30px; border-radius: 15px; max-width: 320px; text-align: center; }
        .modal-box h2 { color: #ef4444; font-family: 'Caveat', cursive; font-size: 32px; margin-bottom: 10px; }
        .modal-box button { background: #ef4444; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; margin-top: 15px; }
    </style>
</head>
<body>
    <select class="lang-switch" id="langSelect" onchange="changeLanguage(this.value)">
        <option value="en">EN</option>
        <option value="pl">PL</option>
        <option value="hu">HU</option>
        <option value="sr">SR</option>
        <option value="bs">BS</option>
    </select>

    <h1 id="pageTitle">Select Artist Fanbook</h1>
    <div class="list-area" id="listArea"><p style="color:white; text-align:center;">Loading...</p></div>

    <div class="modal-overlay" id="lockModal">
        <div class="modal-box">
            <h2>Access Denied</h2>
            <p>Sorry, you do not have access to this artist's fanbook.</p>
            <button onclick="document.getElementById('lockModal').classList.remove('active')">Understood</button>
        </div>
    </div>

<script>
    const translations = {
        en: "Select Artist Fanbook", pl: "Wybierz Fanbook Artysty", hu: "Válasszon Művész Fanbookot", sr: "Izaberite Fanbook Umetnika", bs: "Odaberite Fanbook Umjetnika"
    };

    function changeLanguage(lang) {
        localStorage.setItem('selectedLanguage', lang);
        document.getElementById('pageTitle').innerText = translations[lang];
    }

    window.addEventListener('firebaseLoaded', async () => {
        const savedLang = localStorage.getItem('selectedLanguage') || 'en';
        document.getElementById('langSelect').value = savedLang;
        changeLanguage(savedLang);

        const snapshot = await window.getDocs(window.collection(window.db, "celebrities"));
        const list = document.getElementById('listArea');
        list.innerHTML = '';
        
        snapshot.forEach(doc => {
            const data = doc.data();
            const card = document.createElement('div');
            card.className = 'artist-card';
            
            const imgUrl = data.imageUrl || 'https://i.postimg.cc/k47Z4Y3F/pexels-photo-220453.jpg';
            const isGated = data.access === 'gated';
            const isVerified = data.isVerified;
            
            card.innerHTML = `
                ${isGated ? '<div class="locked-icon">🔒</div>' : ''}
                <img src="${imgUrl}" class="artist-img">
                <div class="artist-info">
                    <h2>${data.name} ${isVerified ? '<svg class="verified-badge" viewBox="0 0 24 24"><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .495.083.965.238 1.4-1.272.65-2.147 2.018-2.147 3.6 0 1.495.782 2.798 1.942 3.486-.02.17-.032.34-.032.514 0 2.21 1.708 4 3.818 4 .47 0 .92-.086 1.335-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.865.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.174-.012-.344-.033-.513 1.158-.687 1.943-1.99 1.943-3.484zm-6.616-3.334l-4.334 6.5c-.145.217-.382.334-.625.334-.143 0-.288-.04-.416-.126l-.115-.094-2.415-2.415c-.293-.293-.293-.768 0-1.06s.768-.294 1.06 0l1.77 1.767 3.825-5.74c.23-.345.696-.436 1.04-.207.346.23.44.696.21 1.04z"/></svg>' : ''}</h2>
                    <p>Click to view fanbook</p>
                </div>
            `;
            
            card.onclick = () => {
                if (isGated) {
                    document.getElementById('lockModal').classList.add('active');
                } else {
                    sessionStorage.setItem('selectedArtist', JSON.stringify(data));
                    window.location.href = '/my-website/fanbook/';
                }
            };
            list.appendChild(card);
        });
    });
</script>
</body>
</html>
{% endraw %}
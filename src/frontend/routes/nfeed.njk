title: "Exclusive Feed"
permalink: "/nfeed/"
layout: false
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Exclusive Feed</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, doc, getDoc, collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      window.db = getFirestore(app);
      window.doc = doc; window.getDoc = getDoc;
      window.collection = collection; window.getDocs = getDocs;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; user-select: none; }
        html, body { height: 100%; overscroll-behavior: none; }
        
        body { background: #0a1128; height: 100vh; width: 100vw; display: flex; justify-content: center; align-items: center; overflow: hidden; font-family: 'Playfair Display', serif; touch-action: none; }
        .bg-mesh { position: fixed; inset: -50%; width: 200%; height: 200%; background: radial-gradient(circle at 50% 50%, rgba(20, 40, 90, 0.6), transparent 60%); animation: meshMove 15s infinite alternate; z-index: 0; pointer-events: none; }
        @keyframes meshMove { 100% { transform: rotate(10deg) scale(1.1); } }

        .app-wrapper { position: relative; z-index: 10; width: 100%; max-width: 500px; height: 100vh; display: flex; flex-direction: column; background: rgba(10, 17, 40, 0.7); backdrop-filter: blur(15px); border-left: 1px solid rgba(180, 190, 210, 0.1); border-right: 1px solid rgba(180, 190, 210, 0.1); overflow: hidden; }

        .top-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: rgba(5, 10, 25, 0.9); padding: 12px 15px; border-bottom: 1px solid rgba(180, 190, 210, 0.15); z-index: 20; flex-shrink: 0; height: 95px; }
        .ticker-container { flex-grow: 1; height: 60px; overflow: hidden; position: relative; display: flex; flex-direction: column; justify-content: flex-end; }
        .comment-line { font-size: 12px; font-weight: 600; color: #e2e8f0; margin-bottom: 5px; white-space: nowrap; animation: slideUp 0.4s ease-out forwards; font-family: sans-serif; }
        @keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .rainbow-username { font-family: 'Caveat', cursive; font-size: 15px; font-weight: 700; color: #3a7bd5; margin-right: 5px; }

        .button-stack { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }
        .btn-top { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(226, 232, 240, 0.2); color: #e2e8f0; padding: 5px 10px; border-radius: 6px; font-size: 9px; font-weight: bold; text-transform: uppercase; cursor: pointer; width: 72px; text-align: center; }
        .btn-rewards { color: #60a5fa; border-color: rgba(96, 165, 250, 0.3); position: relative; }
        .red-dot { position: absolute; top: -4px; right: -4px; width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; box-shadow: 0 0 5px rgba(239, 68, 68, 0.8); }

        .feed-content { flex-grow: 1; padding: 15px; display: flex; flex-direction: row; gap: 20px; justify-content: center; align-items: center; position: relative; }

        .race-container { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); height: 75vh; width: 30px; display: flex; justify-content: space-between; align-items: flex-end; z-index: 5; pointer-events: none; }
        .race-side { width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; position: relative; }
        .race-pct { font-family: sans-serif; font-size: 10px; font-weight: bold; color: #fff; margin-bottom: 5px; background: rgba(0,0,0,0.8); padding: 2px 6px; border-radius: 4px; position: absolute; transition: bottom 0.1s linear; z-index: 10; }
        .race-line { width: 6px; border-radius: 6px 6px 0 0; position: absolute; bottom: 0; transition: height 0.1s linear; }
        .race-line.left-line { background: linear-gradient(to top, transparent, #00d2ff); }
        .race-line.right-line { background: linear-gradient(to top, transparent, #ff00cc); }

        .image-card { position: relative; flex: 1; height: 82vh; border-radius: 20px; border: 1px solid rgba(180, 190, 210, 0.3); background-color: #111827; background-size: cover; background-position: center; box-shadow: 0 15px 40px rgba(0,0,0,0.9); overflow: hidden; cursor: grab; -webkit-touch-callout: none; -webkit-user-drag: none; }
        
        @keyframes fallTop { 0% { transform: translateY(-100vh) rotate(-10deg); opacity: 0; } 70% { transform: translateY(20px) rotate(5deg); opacity: 1; } 85% { transform: translateY(-10px) rotate(-2deg); } 100% { transform: translateY(0) rotate(0); } }
        @keyframes fallLeft { 0% { transform: translateX(-100vw) rotate(-30deg); opacity: 0; } 70% { transform: translateX(20px) rotate(10deg); opacity: 1; } 85% { transform: translateX(-10px) rotate(-5deg); } 100% { transform: translateX(0) rotate(0); } }
        @keyframes fallRight { 0% { transform: translateX(100vw) rotate(30deg); opacity: 0; } 70% { transform: translateX(-20px) rotate(-10deg); opacity: 1; } 85% { transform: translateX(10px) rotate(5deg); } 100% { transform: translateX(0) rotate(0); } }

        .image-card:active { cursor: grabbing; transform: scale(0.98); }
        .image-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 40%); pointer-events: none; }

        .counter-badge { position: absolute; top: 15px; left: 50%; transform: translateX(-50%); background: rgba(0, 0, 0, 0.7); border: 1px solid rgba(226, 232, 240, 0.4); border-radius: 8px; padding: 4px 8px; color: #e2e8f0; font-family: sans-serif; font-weight: bold; font-size: 10px; display: flex; gap: 4px; pointer-events: none; white-space: nowrap; }
        .lock-icon { font-size: 9px; }

        .floating-icon { position: absolute; pointer-events: none; z-index: 100; animation: floatUp 3s forwards; }
        @keyframes floatUp { 0% { transform: translateY(0) scale(0.5); opacity: 0; } 15% { opacity: 1; transform: translateY(-40px) scale(1.3); } 100% { transform: translateY(-450px) scale(1.8); opacity: 0; } }

        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-overlay.active { display: flex; }
        .modal-box { background: #111827; border: 1px solid #e2e8f0; padding: 30px; border-radius: 15px; max-width: 300px; text-align: center; }
        .modal-box button { background: #e2e8f0; color: #111827; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 20px; }
    </style>
</head>
<body>

    <div class="bg-mesh"></div>

    <div class="app-wrapper">
        <div class="top-bar">
            <div class="ticker-container" id="tickerContainer"></div>
            <div class="button-stack">
                <button class="btn-top" onclick="alert('Sorry you cannot join the conversation at the moment.')">Join</button>
                <button class="btn-top btn-rewards" onclick="alert('Please log into your fan account to view your rewards.')">
                    Rewards <div class="red-dot"></div>
                </button>
            </div>
        </div>

        <div class="feed-content">
            <div class="race-container">
                <div class="race-side">
                    <div class="race-pct" id="race-pct-1" style="bottom: calc(36% + 8px);">36%</div>
                    <div class="race-line left-line" id="race-line-1" style="height: 36%;"></div>
                </div>
                <div class="race-side">
                    <div class="race-pct" id="race-pct-2" style="bottom: calc(36% + 8px);">36%</div>
                    <div class="race-line right-line" id="race-line-2" style="height: 36%;"></div>
                </div>
            </div>

            <div class="image-card" id="card-1" data-counter="count-1" onclick="handleTap(event, 'count-1')" oncontextmenu="return false;" ondragstart="return false;">
                <div class="image-overlay"></div>
                <div class="counter-badge" id="badge-1">
                    <span class="lock-icon" id="lock-1">🔓</span>
                    <span>❤️</span> <span id="count-1">0</span> / <span id="target-1">50,000</span>
                </div>
            </div>

            <div class="image-card" id="card-2" data-counter="count-2" onclick="handleTap(event, 'count-2')" oncontextmenu="return false;" ondragstart="return false;">
                <div class="image-overlay"></div>
                <div class="counter-badge" id="badge-2">
                    <span class="lock-icon" id="lock-2">🔓</span>
                    <span>⭐</span> <span id="count-2">0</span> / <span id="target-2">50,000</span>
                </div>
            </div>
        </div>
    </div>

<script>
    if (!sessionStorage.getItem('loggedInFan')) { window.location.href = '/my-website/nlogin/'; }

    // ====== READ URL PARAMETER ======
    const urlParams = new URLSearchParams(window.location.search);
    const matchupSlug = urlParams.get('m');

    if (!matchupSlug) {
        alert("No matchup selected.");
        window.location.href = '/my-website/nselect/';
    }

    let pos1 = 36, pos2 = 36;
    let dir1 = 1, dir2 = 1;
    let speed1 = 0.4, speed2 = 0.6;
    
    let count1 = 5000, count2 = 5000;
    let target1 = 50000, target2 = 50000;
    let leftPool = [], rightPool = [];
    let img1Locked = false, img2Locked = false;

    function t(key) { return key; }

    window.addEventListener('firebaseLoaded', async () => {
        // 1. Load Matchup Data
        try {
            const snap = await window.getDoc(window.doc(window.db, "matchups", matchupSlug));
            if (snap.exists()) {
                const data = snap.data();
                
                // Set Images (use single image as pool for now)
                if(data.leftImg) { leftPool = [data.leftImg]; document.getElementById('card-1').style.backgroundImage = `url('${data.leftImg}')`; }
                if(data.rightImg) { rightPool = [data.rightImg]; document.getElementById('card-2').style.backgroundImage = `url('${data.rightImg}')`; }
                
                if(data.leftTarget) { target1 = parseInt(data.leftTarget); document.getElementById('target-1').innerText = target1.toLocaleString(); }
                if(data.rightTarget) { target2 = parseInt(data.rightTarget); document.getElementById('target-2').innerText = target2.toLocaleString(); }
                
                img1Locked = data.isLocked;
                document.getElementById('lock-1').innerText = img1Locked ? '🔒' : '🔓';
            }
        } catch(e) { console.log("Matchup load error:", e); }

        // 2. Load Comments
        try {
            const snapshot = await window.getDocs(window.collection(window.db, "feed_comments"));
            const allComments = [];
            snapshot.forEach(d => allComments.push(d.data()));
            startTicker(allComments);
        } catch(e) { console.log(e); }
    });

    // Ticker Logic
    let tickerIndex = 0;
    function startTicker(comments) {
        const container = document.getElementById('tickerContainer');
        if(comments.length === 0) return;
        
        for(let i=0; i < Math.min(3, comments.length); i++) addTicker(comments[i]);
        setInterval(() => {
            tickerIndex = (tickerIndex + 1) % comments.length;
            addTicker(comments[tickerIndex]);
        }, 3000);
    }
    function addTicker(c) {
        const container = document.getElementById('tickerContainer');
        const line = document.createElement('div');
        line.className = 'comment-line';
        line.innerHTML = `<span class="rainbow-username">${c.user}:</span> ${c.text}`;
        container.appendChild(line);
        if(container.children.length > 3) container.removeChild(container.firstChild);
    }

    // Race Logic
    setInterval(function() {
        pos1 += (speed1 * dir1); pos2 += (speed2 * dir2);
        if (pos1 >= 60) { pos1 = 60; dir1 = -1; } if (pos1 <= 12) { pos1 = 12; dir1 = 1; }
        if (pos2 >= 60) { pos2 = 60; dir2 = -1; } if (pos2 <= 12) { pos2 = 12; dir2 = 1; }

        document.getElementById('race-line-1').style.height = pos1 + '%';
        document.getElementById('race-pct-1').innerText = Math.floor(pos1) + '%';
        document.getElementById('race-pct-1').style.bottom = "calc(" + pos1 + "% + 8px)"; 
        document.getElementById('race-line-2').style.height = pos2 + '%';
        document.getElementById('race-pct-2').innerText = Math.floor(pos2) + '%';
        document.getElementById('race-pct-2').style.bottom = "calc(" + pos2 + "% + 8px)";
    }, 100); 

    // Auto Count Logic
    setInterval(function() {
        count1 += Math.floor(Math.random() * 20) + 15; count2 += Math.floor(Math.random() * 20) + 15;
        document.getElementById('count-1').innerText = count1.toLocaleString();
        document.getElementById('count-2').innerText = count2.toLocaleString();
    }, 100); 

    // Interactions
    function handleTap(event, counterId) {
        if (counterId === 'count-1' && img1Locked) return;
        if (counterId === 'count-1') { pos1 += 4; if(pos1>60) pos1=60; count1++; document.getElementById('count-1').innerText = count1.toLocaleString(); }
        if (counterId === 'count-2') { pos2 += 4; if(pos2>60) pos2=60; count2++; document.getElementById('count-2').innerText = count2.toLocaleString(); }
        
        const badge = document.getElementById(counterId).parentElement;
        badge.style.transform = "translateX(-50%) scale(1.2)";
        setTimeout(() => badge.style.transform = "translateX(-50%) scale(1)", 150);

        for (let i = 0; i < 4; i++) {
            setTimeout(() => {
                const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                svg.setAttribute("class", "floating-icon"); svg.setAttribute("viewBox", "0 0 24 24");
                const pathEl = document.createElementNS("http://www.w3.org/2000/svg", "path");
                pathEl.setAttribute("d", "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z");
                svg.appendChild(pathEl);
                svg.style.left = (event.clientX + (Math.random()*80-40)) + "px"; svg.style.top = event.clientY + "px";
                svg.style.fill = '#00FFFF'; svg.style.width = '30px'; svg.style.height = '30px';
                document.body.appendChild(svg); setTimeout(() => svg.remove(), 3000);
            }, i * 150);
        }
    }

    // Random Falling Images
    function fall(cardId, pool) {
        if(pool.length === 0) return;
        const card = document.getElementById(cardId);
        const anims = ['fallTop', 'fallLeft', 'fallRight'];
        card.style.animation = anims[Math.floor(Math.random() * anims.length)] + ' 1.5s forwards';
        setTimeout(() => { card.style.backgroundImage = `url('${pool[Math.floor(Math.random() * pool.length)]}')`; }, 750);
        setTimeout(() => card.style.animation = '', 1600);
    }
    setInterval(() => { if(Math.random() > 0.5) fall('card-1', leftPool); else fall('card-2', rightPool); }, 10000);
</script>
</body>
</html>
{% endraw %}
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Exclusive Feed</title>
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";
      const firebaseConfig = { apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw", authDomain: "clbomb.firebaseapp.com", projectId: "clbomb", storageBucket: "clbomb.firebasestorage.app", messagingSenderId: "515939060816", appId: "1:515939060816:web:8a68d9d5f40b02c9029555" };
      const app = initializeApp(firebaseConfig); window.db = getFirestore(app);
      window.doc = doc; window.getDoc = getDoc;
      window.firebaseReady = true; window.dispatchEvent(new Event('firebaseLoaded'));
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; -webkit-user-select: none; -khtml-user-select: none; -moz-user-select: none; -ms-user-select: none; user-select: none; }
        body { background: #0a1128; height: 100vh; display: flex; justify-content: center; align-items: center; overflow: hidden; font-family: 'Playfair Display', serif; touch-action: none; }
        .app-wrapper { position: relative; z-index: 10; width: 100%; max-width: 500px; height: 100vh; display: flex; flex-direction: column; background: rgba(10, 17, 40, 0.7); backdrop-filter: blur(15px); border-left: 1px solid rgba(180, 190, 210, 0.1); border-right: 1px solid rgba(180, 190, 210, 0.1); overflow: hidden; }
        
        .top-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: rgba(5, 10, 25, 0.9); padding: 12px 15px; border-bottom: 1px solid rgba(180, 190, 210, 0.15); z-index: 20; flex-shrink: 0; height: 95px; }
        .ticker-container { flex-grow: 1; height: 60px; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
        .comment-line { font-size: 12px; color: #e2e8f0; margin-bottom: 5px; white-space: nowrap; animation: slideUp 0.4s ease-out forwards; }
        @keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .rainbow-username { color: #3a7bd5; font-weight: bold; margin-right: 5px; }

        .button-stack { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }
        .btn-top { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(226, 232, 240, 0.2); color: #e2e8f0; padding: 5px 10px; border-radius: 6px; font-size: 9px; font-weight: bold; text-transform: uppercase; cursor: pointer; width: 72px; text-align: center; }
        .btn-rewards { color: #60a5fa; border-color: rgba(96, 165, 250, 0.3); position: relative; }
        .red-dot { position: absolute; top: -4px; right: -4px; width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; }

        .feed-content { flex-grow: 1; padding: 15px; display: flex; flex-direction: row; gap: 20px; justify-content: center; align-items: center; position: relative; }
        .image-card { position: relative; flex: 1; height: 82vh; border-radius: 20px; border: 1px solid rgba(180, 190, 210, 0.3); background-color: #111827; background-size: cover; background-position: center; box-shadow: 0 15px 40px rgba(0,0,0,0.9); overflow: hidden; cursor: grab; }
        .image-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 40%); pointer-events: none; }
        
        .counter-badge { position: absolute; top: 15px; left: 50%; transform: translateX(-50%); background: rgba(0, 0, 0, 0.7); border: 1px solid rgba(226, 232, 240, 0.4); border-radius: 8px; padding: 4px 8px; color: #e2e8f0; font-family: sans-serif; font-weight: bold; font-size: 10px; display: flex; gap: 4px; pointer-events: none; white-space: nowrap; }

        @keyframes fallTop { 0% { transform: translateY(-100vh) rotate(-10deg); opacity: 0; } 70% { transform: translateY(20px) rotate(5deg); opacity: 1; } 85% { transform: translateY(-10px) rotate(-2deg); } 100% { transform: translateY(0) rotate(0); } }
        @keyframes fallLeft { 0% { transform: translateX(-100vw) rotate(-30deg); opacity: 0; } 70% { transform: translateX(20px) rotate(10deg); opacity: 1; } 85% { transform: translateX(-10px) rotate(-5deg); } 100% { transform: translateX(0) rotate(0); } }
        @keyframes fallRight { 0% { transform: translateX(100vw) rotate(30deg); opacity: 0; } 70% { transform: translateX(-20px) rotate(-10deg); opacity: 1; } 85% { transform: translateX(10px) rotate(5deg); } 100% { transform: translateX(0) rotate(0); } }

        .floating-icon { position: absolute; pointer-events: none; z-index: 100; animation: floatUp 3s forwards; }
        @keyframes floatUp { 0% { transform: translateY(0) scale(0.5); opacity: 0; } 15% { opacity: 1; transform: translateY(-40px) scale(1.3); } 100% { transform: translateY(-450px) scale(1.8); opacity: 0; } }
        
        .loading-overlay { position: fixed; inset: 0; background: rgba(10, 17, 40, 0.95); z-index: 9999; display: none; justify-content: center; align-items: center; flex-direction: column; }
        .loader { border: 4px solid rgba(255,255,255,0.1); border-left-color: #3b82f6; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
        @keyframes spin { 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="loading-overlay" id="rewardLoader"><div class="loader"></div><p style="color:#e2e8f0; margin-top:15px; font-family:sans-serif;">Loading Fanbook...</p></div>

    <div class="app-wrapper">
        <div class="top-bar">
            <div class="ticker-container" id="tickerContainer"></div>
            <div class="button-stack">
                <button class="btn-top" onclick="alert('Sorry you cannot join the conversation at the moment.')">Join</button>
                <button class="btn-top btn-rewards" onclick="goToRewards()">Rewards <div class="red-dot"></div></button>
            </div>
        </div>

        <div class="feed-content">
            <div class="image-card" id="card-1" data-counter="count-1" oncontextmenu="return false;" ondragstart="return false;">
                <div class="image-overlay"></div>
                <div class="counter-badge"><span id="count-1">0</span> / <span id="target-1">50,000</span></div>
            </div>
            <div class="image-card" id="card-2" data-counter="count-2" oncontextmenu="return false;" ondragstart="return false;">
                <div class="image-overlay"></div>
                <div class="counter-badge"><span id="count-2">0</span> / <span id="target-2">50,000</span></div>
            </div>
        </div>
    </div>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    const slug = urlParams.get('m');
    if (!slug) { window.location.href = '/my-website/nselect/'; }

    let count1 = 5000, count2 = 5000;
    let leftPool = [], rightPool = [];

    window.addEventListener('firebaseLoaded', async () => {
        const snap = await window.getDoc(window.doc(window.db, "matchups", slug));
        if(snap.exists()) {
            const d = snap.data();
            if(d.leftImg) document.getElementById('card-1').style.backgroundImage = `url('${d.leftImg}')`;
            if(d.rightImg) document.getElementById('card-2').style.backgroundImage = `url('${d.rightImg}')`;
            if(d.leftTarget) document.getElementById('target-1').innerText = parseInt(d.leftTarget).toLocaleString();
            if(d.rightTarget) document.getElementById('target-2').innerText = parseInt(d.rightTarget).toLocaleString();
            
            leftPool = d.leftPool || [d.leftImg];
            rightPool = d.rightPool || [d.rightImg];

            startTicker(d.comments || []);
        }
    });

    // Ticker
    let tickerIndex = 0;
    function startTicker(comments) {
        if(comments.length === 0) return;
        for(let i=0; i < Math.min(3, comments.length); i++) addTicker(comments[i]);
        setInterval(() => {
            tickerIndex = (tickerIndex + 1) % comments.length;
            addTicker(comments[tickerIndex]);
        }, 3000);
    }
    function addTicker(c) {
        const box = document.getElementById('tickerContainer');
        const line = document.createElement('div');
        line.className = 'comment-line';
        line.innerHTML = `<span class="rainbow-username">${c.user}:</span> ${c.text}`;
        box.appendChild(line);
        if(box.children.length > 3) box.removeChild(box.firstChild);
    }

    // 10-15 Minutes Image Change (12 mins = 720000ms)
    setInterval(() => {
        let card = Math.random() > 0.5 ? document.getElementById('card-1') : document.getElementById('card-2');
        let pool = card.id === 'card-1' ? leftPool : rightPool;
        if(pool.length === 0) return;

        const anims = ['fallTop', 'fallLeft', 'fallRight'];
        card.style.animation = anims[Math.floor(Math.random() * 3)] + ' 1.5s forwards';
        setTimeout(() => {
            card.style.backgroundImage = `url('${pool[Math.floor(Math.random() * pool.length)]}')`;
        }, 750);
        setTimeout(() => card.style.animation = '', 1600);
    }, 720000); 

    // Emojis and Swipes
    const colors = ['#FF3366', '#FF9933', '#FFD700', '#33FF57', '#00FA9A', '#00BFFF', '#8A2BE2', '#FF00FF', '#FF1493', '#00FFFF'];
    const emojiPaths = {
        love: 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z',
        kiss: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-6c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1zm2-3c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z'
    };

    let lastTouch = 0;
    function triggerEmoji(x, y) {
        const now = Date.now();
        if(now - lastTouch < 100) return; // throttle
        lastTouch = now;

        for(let i=0; i<4; i++) {
            setTimeout(() => {
                const svgNS = "http://www.w3.org/2000/svg";
                const svg = document.createElementNS(svgNS, "svg");
                svg.setAttribute("class", "floating-icon"); svg.setAttribute("viewBox", "0 0 24 24");
                const p = document.createElementNS(svgNS, "path");
                p.setAttribute("d", Math.random() > 0.5 ? emojiPaths.love : emojiPaths.kiss);
                svg.appendChild(p);
                svg.style.left = (x + (Math.random()*80-40)) + "px"; svg.style.top = (y + (Math.random()*20-10)) + "px";
                const col = colors[Math.floor(Math.random() * colors.length)];
                svg.style.fill = col;
                svg.style.filter = `drop-shadow(0 0 10px ${col})`;
                svg.style.width = '25px'; svg.style.height = '25px';
                document.body.appendChild(svg);
                setTimeout(() => svg.remove(), 3000);
            }, i * 150);
        }
    }

    // Swipe/Tap Logic
    let swipe = false;
    document.querySelectorAll('.image-card').forEach(card => {
        const counterId = card.getAttribute('data-counter');
        
        card.addEventListener('touchmove', (e) => {
            swipe = true;
            const t = e.touches[0];
            triggerEmoji(t.clientX, t.clientY);
            updateCount(counterId);
        }, {passive: true});

        card.addEventListener('touchend', (e) => {
            if(!swipe) {
                const t = e.changedTouches[0];
                triggerEmoji(t.clientX, t.clientY);
                updateCount(counterId);
            }
            swipe = false;
        });

        card.addEventListener('mousemove', (e) => {
            if(e.buttons === 1) { triggerEmoji(e.clientX, e.clientY); updateCount(counterId); }
        });
        card.addEventListener('click', (e) => {
            triggerEmoji(e.clientX, e.clientY); updateCount(counterId);
        });
    });

    function updateCount(id) {
        if(id === 'count-1') { count1++; document.getElementById('count-1').innerText = count1.toLocaleString(); }
        else { count2++; document.getElementById('count-2').innerText = count2.toLocaleString(); }
    }

    // Rewards -> Fanbook routing (6 sec loader)
    function goToRewards() {
        document.getElementById('rewardLoader').style.display = 'flex';
        setTimeout(() => { window.location.href = '/my-website/nrewards/'; }, 6000);
    }
</script>
</body>
</html>
{% endraw %}
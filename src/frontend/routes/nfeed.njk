---
title: "Exclusive Feed"
permalink: "/nfeed/"
layout: false
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <title>Exclusive Feed</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, getDocs, query, orderBy, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      window.db = getFirestore(app);
      window.collection = collection;
      window.getDocs = getDocs;
      window.query = query;
      window.orderBy = orderBy;
      window.doc = doc; window.getDoc = getDoc;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; user-select: none; }
        html, body { height: 100%; overscroll-behavior: none; }
        
        body { 
            background: #0a1128; 
            height: 100vh; width: 100vw; 
            display: flex; justify-content: center; align-items: center; 
            overflow: hidden; font-family: 'Playfair Display', serif; 
            touch-action: none; 
        }
        
        .bg-mesh {
            position: fixed; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle at 50% 50%, rgba(20, 40, 90, 0.6), transparent 60%),
                        radial-gradient(circle at 80% 20%, rgba(180, 190, 210, 0.1), transparent 40%);
            animation: meshMove 15s ease-in-out infinite alternate;
            z-index: 0; pointer-events: none;
        }
        @keyframes meshMove {
            0% { transform: rotate(0deg) scale(1); }
            100% { transform: rotate(10deg) scale(1.1); }
        }

        .app-wrapper {
            position: relative; z-index: 10;
            width: 100%; max-width: 500px; height: 100vh;
            display: flex; flex-direction: column;
            background: rgba(10, 17, 40, 0.7);
            backdrop-filter: blur(15px);
            border-left: 1px solid rgba(180, 190, 210, 0.1);
            border-right: 1px solid rgba(180, 190, 210, 0.1);
            overflow: hidden;
        }

        /* FIXED UPPER REGION (No clipping, restored height) */
        .top-bar {
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
            background: rgba(5, 10, 25, 0.9);
            padding: 12px 15px; border-bottom: 1px solid rgba(180, 190, 210, 0.15);
            z-index: 20; flex-shrink: 0;
            height: 95px; 
        }
        
        .ticker-container { 
            flex-grow: 1; height: 60px;
            overflow: hidden; position: relative; 
            display: flex; flex-direction: column; justify-content: flex-end; 
            /* Removed mask-image so text isn't cut off */
        }
        .comment-line { 
            font-size: 12px; font-weight: 600; color: #e2e8f0; margin-bottom: 5px; 
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
            animation: slideUp 0.4s ease-out forwards; font-family: sans-serif; line-height: 1.3; 
        }
        @keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .rainbow-username { font-family: 'Caveat', cursive; font-size: 15px; font-weight: 700; background: linear-gradient(90deg, #00d2ff, #3a7bd5, #00d2ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-right: 5px; }
        
        .button-stack {
            display: flex; flex-direction: column; gap: 6px; flex-shrink: 0;
        }
        
        .btn-top {
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(226, 232, 240, 0.2);
            color: #e2e8f0; padding: 5px 10px; border-radius: 6px;
            font-size: 9px; font-weight: bold; text-transform: uppercase;
            letter-spacing: 0.5px; cursor: pointer; transition: 0.2s;
            width: 72px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        .btn-top:hover { background: rgba(255, 255, 255, 0.15); border-color: #e2e8f0; }
        
        /* RED DOT FIX */
        .btn-rewards {
            color: #60a5fa;
            border-color: rgba(96, 165, 250, 0.3);
            position: relative; 
        }
        .btn-rewards:hover { background: rgba(96, 165, 250, 0.15); border-color: #60a5fa; }
        
        .red-dot {
            position: absolute; 
            top: -4px; 
            right: -4px;
            width: 8px; 
            height: 8px;
            background-color: #ef4444; 
            border-radius: 50%;
            box-shadow: 0 0 5px rgba(239, 68, 68, 0.8);
        }

        .feed-content {
            flex-grow: 1; padding: 15px;
            display: flex; flex-direction: row; gap: 20px; 
            justify-content: center; align-items: center;
            position: relative;
        }

        /* ORGANIC RACE LINES (12% - 60%) */
        .race-container {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            height: 75vh; width: 30px;
            display: flex; justify-content: space-between; align-items: flex-end;
            z-index: 5; pointer-events: none;
        }

        .race-side {
            width: 100%; height: 100%;
            display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
            position: relative;
        }

        /* FIXED LABEL POSITIONING TO PREVENT DUPLICATES */
        .race-pct {
            font-family: sans-serif; font-size: 10px; font-weight: bold;
            color: #ffffff; margin-bottom: 5px;
            background: rgba(0,0,0,0.8); padding: 2px 6px; border-radius: 4px;
            position: absolute; white-space: nowrap;
            transition: bottom 0.1s linear;
            box-shadow: 0 2px 5px rgba(0,0,0,0.5);
            z-index: 10;
        }

        .race-line {
            width: 6px; border-radius: 6px 6px 0 0;
            position: absolute; bottom: 0;
            transition: height 0.1s linear;
        }

        .race-line.left-line { background: linear-gradient(to top, transparent, #00d2ff); box-shadow: 0 0 10px #00d2ff; }
        .race-line.right-line { background: linear-gradient(to top, transparent, #ff00cc); box-shadow: 0 0 10px #ff00cc; }

        .image-card {
            position: relative;
            flex: 1; 
            height: 82vh; 
            border-radius: 20px;
            border: 1px solid rgba(180, 190, 210, 0.3);
            background-color: #111827;
            background-size: cover; background-position: center;
            box-shadow: 0 15px 40px rgba(0,0,0,0.9);
            overflow: hidden;
            cursor: grab;
            -webkit-touch-callout: none;
            -webkit-user-drag: none;
        }
        
        @keyframes fallTop {
            0% { transform: translateY(-100vh) rotate(-10deg) scale(0.8); opacity: 0; }
            70% { transform: translateY(20px) rotate(5deg) scale(1.02); opacity: 1; }
            85% { transform: translateY(-10px) rotate(-2deg) scale(0.98); }
            100% { transform: translateY(0) rotate(0) scale(1); }
        }
        @keyframes fallLeft {
            0% { transform: translateX(-100vw) rotate(-30deg); opacity: 0; }
            70% { transform: translateX(20px) rotate(10deg); opacity: 1; }
            85% { transform: translateX(-10px) rotate(-5deg); }
            100% { transform: translateX(0) rotate(0); }
        }
        @keyframes fallRight {
            0% { transform: translateX(100vw) rotate(30deg); opacity: 0; }
            70% { transform: translateX(-20px) rotate(-10deg); opacity: 1; }
            85% { transform: translateX(10px) rotate(5deg); }
            100% { transform: translateX(0) rotate(0); }
        }

        .image-card:active { cursor: grabbing; transform: scale(0.98); }

        .image-overlay {
            position: absolute; inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 40%);
            pointer-events: none;
        }

        .counter-badge {
            position: absolute; top: 15px; left: 50%; transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(226, 232, 240, 0.4);
            border-radius: 8px; 
            padding: 4px 8px;
            color: #e2e8f0;
            font-family: sans-serif; font-weight: bold; font-size: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.6);
            display: flex; flex-direction: row; justify-content: center; align-items: center; gap: 4px;
            transition: transform 0.1s;
            pointer-events: none;
            white-space: nowrap;
        }
        .lock-icon { font-size: 9px; opacity: 0.8; }

        .floating-icon {
            position: absolute;
            pointer-events: none;
            z-index: 100;
            animation: floatUpThick 3s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        }
        @keyframes floatUpThick {
            0% { transform: translateY(0) scale(0.5); opacity: 0; }
            15% { opacity: 1; transform: translateY(-40px) scale(1.3); }
            100% { transform: translateY(-450px) scale(1.8); opacity: 0; }
        }

        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.85);
            backdrop-filter: blur(5px); display: none; justify-content: center; align-items: center;
            z-index: 1000;
        }
        .modal-overlay.active { display: flex; animation: fadeIn 0.3s; }
        .modal-box {
            background: #111827; border: 1px solid #e2e8f0;
            padding: 30px; border-radius: 15px; max-width: 300px; text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }
        .modal-box h2 { font-family: 'Caveat', cursive; color: #e2e8f0; font-size: 32px; margin-bottom: 10px; }
        .modal-box p { color: #94a3b8; font-size: 14px; margin-bottom: 20px; line-height: 1.5; }
        .modal-box button { background: #e2e8f0; color: #111827; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; }

    </style>
</head>
<body>

    <div class="bg-mesh"></div>

    <div class="app-wrapper">
        <div class="top-bar">
            <div class="ticker-container" id="tickerContainer"></div>
            <div class="button-stack">
                <button class="btn-top btn-join" onclick="openJoinModal()" data-i18n="btn_join">Join</button>
                <button class="btn-top btn-rewards" onclick="openRewardsModal()" data-i18n="btn_rewards">
                    Rewards
                    <div class="red-dot"></div>
                </button>
            </div>
        </div>

        <div class="feed-content">
            
            <div class="race-container">
                <div class="race-side">
                    <div class="race-pct" id="race-pct-1" style="bottom: calc(36% + 8px);">36%</div>
                    <div class="race-line left-line" id="race-line-1" style="height: 36%;"></div>
                </div>
                <div class="race-side">
                    <div class="race-pct" id="race-pct-2" style="bottom: calc(36% + 8px);">36%</div>
                    <div class="race-line right-line" id="race-line-2" style="height: 36%;"></div>
                </div>
            </div>

            <div class="image-card" id="card-1" data-counter="count-1" onclick="handleTap(event, 'count-1')" oncontextmenu="return false;" ondragstart="return false;" style="background-image: url('https://i.postimg.cc/k47Z4Y3F/pexels-photo-220453.jpg');">
                <div class="image-overlay"></div>
                <div class="counter-badge" id="badge-1">
                    <span class="lock-icon" id="lock-1">🔓</span>
                    <span>❤️</span> <span id="count-1">0</span> / <span id="target-1">50,000</span>
                </div>
            </div>

            <div class="image-card" id="card-2" data-counter="count-2" onclick="handleTap(event, 'count-2')" oncontextmenu="return false;" ondragstart="return false;" style="background-image: url('https://i.postimg.cc/fyZ4Y3F3/pexels-photo-210241.jpg');">
                <div class="image-overlay"></div>
                <div class="counter-badge" id="badge-2">
                    <span class="lock-icon" id="lock-2">🔓</span>
                    <span>⭐</span> <span id="count-2">0</span> / <span id="target-2">50,000</span>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="joinModal" onclick="closeJoinModal()">
        <div class="modal-box" onclick="event.stopPropagation()">
            <h2 data-i18n="join_title">Join the Club</h2>
            <p data-i18n="join_text">Sorry you cannot join the conversation at the moment.</p>
            <button onclick="closeJoinModal()" data-i18n="join_close">Okay</button>
        </div>
    </div>

    <div class="modal-overlay" id="rewardsModal" onclick="closeRewardsModal()">
        <div class="modal-box" onclick="event.stopPropagation()">
            <h2 data-i18n="rewards_title">Fan Rewards</h2>
            <p data-i18n="rewards_text">Please log into your fan account to view your rewards.</p>
            <button onclick="closeRewardsModal()" data-i18n="rewards_close">Okay</button>
        </div>
    </div>

<script>
    if (!sessionStorage.getItem('loggedInFan')) {
        window.location.href = '/my-website/nlogin/';
    }

    const translations = {
        en: { btn_join: "Join", join_title: "Join the Club", join_text: "Sorry you cannot join the conversation at the moment.", join_close: "Okay", btn_rewards: "Rewards", rewards_title: "Fan Rewards", rewards_text: "Please log into your fan account to view your rewards.", rewards_close: "Okay" },
        pl: { btn_join: "Dołącz", join_title: "Dołącz do klubu", join_text: "Przepraszamy, nie możesz teraz dołączyć do rozmowy.", join_close: "Okay", btn_rewards: "Nagrody", rewards_title: "Nagrody dla Fanów", rewards_text: "Zaloguj się na swoje konto fana, aby zobaczyć nagrody.", rewards_close: "Okay" },
        hu: { btn_join: "Csatlakozás", join_title: "Csatlakozz a klubhoz", join_text: "Sajnáljuk, jelenleg nem tud csatlakozni a beszélgetéshez.", join_close: "Rendben", btn_rewards: "Jutalmak", rewards_title: "Rajongói Jutalmak", rewards_text: "Kérjük, jelentkezzen be rajongói fiókjába a jutalmak megtekintéséhez.", rewards_close: "Rendben" },
        sr: { btn_join: "Pridruži se", join_title: "Pridruži se klubu", join_text: "Žao nam je, trenutno se ne možete pridružiti razgovoru.", join_close: "Okay", btn_rewards: "Nagrade", rewards_title: "Nagrade za Fanove", rewards_text: "Molimo prijavite se na svoj fan račun da vidite nagrade.", rewards_close: "Okay" },
        bs: { btn_join: "Pridruži se", join_title: "Pridruži se klubu", join_text: "Žao nam je, trenutno se ne možete pridružiti razgovoru.", join_close: "Okay", btn_rewards: "Nagrade", rewards_title: "Nagrade za Fanove", rewards_text: "Molimo prijavite se na svoj fan račun da vidite nagrade.", rewards_close: "Okay" }
    };

    let currentLang = "en";
    function t(key) {
        if (translations[currentLang] && translations[currentLang][key]) return translations[currentLang][key];
        return translations.en[key] || key;
    }
    function detectLang() {
        const saved = localStorage.getItem('selectedLanguage');
        if (saved && translations[saved]) return saved;
        return "en";
    }
    function applyTranslations() {
        currentLang = detectLang();
        document.querySelectorAll('[data-i18n]').forEach(function(el) { el.textContent = t(el.getAttribute('data-i18n')); });
    }
    document.addEventListener('DOMContentLoaded', applyTranslations);

    function openJoinModal() { document.getElementById('joinModal').classList.add('active'); }
    function closeJoinModal() { document.getElementById('joinModal').classList.remove('active'); }
    function openRewardsModal() { document.getElementById('rewardsModal').classList.add('active'); }
    function closeRewardsModal() { document.getElementById('rewardsModal').classList.remove('active'); }

    const icons = [
        { id: 'heart', path: 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z' },
        { id: 'star', path: 'M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z' },
        { id: 'gift', path: 'M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z' }
    ];
    
    const colors = ['#FF3366', '#FF9933', '#FFD700', '#33FF57', '#00FA9A', '#00BFFF', '#8A2BE2', '#FF00FF', '#FF1493', '#00FFFF'];
    
    let leftPool = ['https://i.postimg.cc/k47Z4Y3F/pexels-photo-220453.jpg'];
    let rightPool = ['https://i.postimg.cc/fyZ4Y3F3/pexels-photo-210241.jpg'];

    let count1 = 5000;
    let count2 = 5000;
    let target1 = 50000;
    let target2 = 50000;
    let img1Locked = false;
    let img2Locked = false;
    
    let swipeCooldown = false;

    function handleSwipe(x, y, counterId) {
        if (swipeCooldown) return;
        swipeCooldown = true;
        triggerReaction(x, y, counterId);
        setTimeout(function() { swipeCooldown = false; }, 300); 
    }

    function handleTap(event, counterId) {
        if (swipeCooldown) return;
        swipeCooldown = true;
        triggerReaction(event.clientX, event.clientY, counterId);
        setTimeout(function() { swipeCooldown = false; }, 300);
    }

    function setupInteractions() {
        const cards = document.querySelectorAll('.image-card');
        cards.forEach(function(card) {
            const counterId = card.getAttribute('data-counter');
            card.addEventListener('touchmove', function(e) {
                const touch = e.touches[0];
                handleSwipe(touch.clientX, touch.clientY, counterId);
            }, { passive: true });
            card.addEventListener('mousemove', function(e) {
                if (e.buttons === 1) { handleSwipe(e.clientX, e.clientY, counterId); }
            });
        });
    }

    function triggerReaction(x, y, counterId) {
        if (counterId === 'count-1' && img1Locked) return;
        if (counterId === 'count-2' && img2Locked) return;

        // Nudge the line up slightly when tapped
        if (counterId === 'count-1') {
            pos1 += 4; 
            if (pos1 > 60) pos1 = 60;
        }
        if (counterId === 'count-2') {
            pos2 += 4; 
            if (pos2 > 60) pos2 = 60;
        }

        const counterEl = document.getElementById(counterId);
        
        if (counterId === 'count-1') {
            count1 += 1;
            counterEl.innerText = count1.toLocaleString();
        } else {
            count2 += 1;
            counterEl.innerText = count2.toLocaleString();
        }
        
        const badge = document.getElementById(counterId).parentElement;
        badge.style.transform = "translateX(-50%) scale(1.2)";
        setTimeout(function() { badge.style.transform = "translateX(-50%) scale(1)"; }, 150);

        const randomIcon = icons[Math.floor(Math.random() * icons.length)];
        for (let i = 0; i < 4; i++) {
            setTimeout(function() { createFloatingIcon(x, y, randomIcon.path); }, i * 150); 
        }
    }

    function createFloatingIcon(x, y, path) {
        const svgNS = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("class", "floating-icon");
        svg.setAttribute("viewBox", "0 0 24 24");
        const pathEl = document.createElementNS(svgNS, "path");
        pathEl.setAttribute("d", path);
        svg.appendChild(pathEl);

        const randomX = x + (Math.random() * 80) - 40;
        const randomY = y + (Math.random() * 20) - 10;
        svg.style.left = randomX + "px";
        svg.style.top = randomY + "px";
        
        const randomColor = colors[Math.floor(Math.random() * colors.length)];
        svg.style.fill = randomColor;
        svg.style.filter = "drop-shadow(0 4px 10px rgba(0,0,0,0.8)) drop-shadow(0 0 15px " + randomColor + ")";

        const size = 20 + Math.random() * 15; 
        svg.style.width = size + "px";
        svg.style.height = size + "px";
        svg.style.stroke = "rgba(0,0,0,0.4)"; 
        svg.style.strokeWidth = "1.5px";

        document.body.appendChild(svg);
        setTimeout(function() { if (svg.parentNode) svg.parentNode.removeChild(svg); }, 3000);
    }

    document.addEventListener('DOMContentLoaded', setupInteractions);

    // ==========================================
    // RACE LINES (SIMPLE BOUNCE 12% - 60%)
    // ==========================================
    let pos1 = 36, pos2 = 36;
    let dir1 = 1, dir2 = 1; // 1 = up, -1 = down
    let speed1 = 0.4, speed2 = 0.6;

    setInterval(function() {
        // Move positions
        pos1 += (speed1 * dir1);
        pos2 += (speed2 * dir2);

        // Bounce limits
        if (pos1 >= 60) { pos1 = 60; dir1 = -1; }
        if (pos1 <= 12) { pos1 = 12; dir1 = 1; }
        
        if (pos2 >= 60) { pos2 = 60; dir2 = -1; }
        if (pos2 <= 12) { pos2 = 12; dir2 = 1; }

        // Update UI
        let line1 = document.getElementById('race-line-1');
        let line2 = document.getElementById('race-line-2');
        let pct1 = document.getElementById('race-pct-1');
        let pct2 = document.getElementById('race-pct-2');

        line1.style.height = pos1 + '%';
        pct1.innerText = Math.floor(pos1) + '%';
        pct1.style.bottom = "calc(" + pos1 + "% + 8px)"; 

        line2.style.height = pos2 + '%';
        pct2.innerText = Math.floor(pos2) + '%';
        pct2.style.bottom = "calc(" + pos2 + "% + 8px)";

    }, 100); // 100ms updates for smooth counting up/down

    // ==========================================
    // INDEPENDENT IMAGE FALLING LOGIC
    // ==========================================
    function triggerLeftFall() {
        let card1 = document.getElementById('card-1');
        const anims = ['fallTop', 'fallLeft', 'fallRight'];
        let randomAnim = anims[Math.floor(Math.random() * anims.length)];
        card1.style.animation = randomAnim + ' 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards';
        
        setTimeout(function() {
            let randomImg = leftPool[Math.floor(Math.random() * leftPool.length)];
            card1.style.backgroundImage = "url('" + randomImg + "')";
        }, 750);

        setTimeout(function() { card1.style.animation = ''; }, 1600);

        let nextTime = Math.random() * 7000 + 8000;
        setTimeout(triggerLeftFall, nextTime);
    }

    function triggerRightFall() {
        let card2 = document.getElementById('card-2');
        const anims = ['fallTop', 'fallLeft', 'fallRight'];
        let randomAnim = anims[Math.floor(Math.random() * anims.length)];
        card2.style.animation = randomAnim + ' 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards';
        
        setTimeout(function() {
            let randomImg = rightPool[Math.floor(Math.random() * rightPool.length)];
            card2.style.backgroundImage = "url('" + randomImg + "')";
        }, 750);

        setTimeout(function() { card2.style.animation = ''; }, 1600);

        let nextTime = Math.random() * 7000 + 8000;
        setTimeout(triggerRightFall, nextTime);
    }

    setTimeout(triggerLeftFall, 10000);
    setTimeout(triggerRightFall, 13000);

    // FAST VISUAL COUNTING
    setInterval(function() {
        count1 += Math.floor(Math.random() * 20) + 15; 
        count2 += Math.floor(Math.random() * 20) + 15;
        
        document.getElementById('count-1').innerText = count1.toLocaleString();
        document.getElementById('count-2').innerText = count2.toLocaleString();
    }, 100); 

    // SLOW MEMORY SAVE
    setInterval(function() {
        localStorage.setItem('feed_count1', count1);
        localStorage.setItem('feed_count2', count2);
    }, 2000);

    // ==========================================
    // IMMEDIATE TICKER START
    // ==========================================
    let allFeedComments = [];
    let tickerIndex = 0;

    const defaultMessages = [
        { user: "Alex", text: "Just unlocked VIP access!" },
        { user: "Sarah", text: "Sent a gift!" },
        { user: "Michael", text: "Is on fire today!" },
        { user: "Emma", text: "Loving the new feed." },
        { user: "David", text: "Just joined the club." },
        { user: "Sophia", text: "Target reached!" }
    ];

    allFeedComments = defaultMessages;
    startTicker();

    window.addEventListener('firebaseLoaded', async function() {
        try {
            const feedSnap = await window.getDoc(window.doc(window.db, "app_settings", "feed"));
            if (feedSnap.exists()) {
                const data = feedSnap.data();
                
                let tempLeft = []; let tempRight = [];
                for(let i=1; i<=10; i++) {
                    if(data['img1Pool_' + i]) tempLeft.push(data['img1Pool_' + i]);
                    if(data['img2Pool_' + i]) tempRight.push(data['img2Pool_' + i]);
                }
                if (tempLeft.length > 0) leftPool = tempLeft;
                if (tempRight.length > 0) rightPool = tempRight;

                document.getElementById('card-1').style.backgroundImage = "url('" + leftPool[0] + "')";
                document.getElementById('card-2').style.backgroundImage = "url('" + rightPool[0] + "')";
                
                let adminBase1 = parseInt(data.img1Likes) || 5000;
                let adminBase2 = parseInt(data.img2Likes) || 5000;

                let storedAdminBase1 = localStorage.getItem('admin_base_1');
                let storedAdminBase2 = localStorage.getItem('admin_base_2');

                if (adminBase1 !== parseInt(storedAdminBase1)) {
                    count1 = adminBase1;
                    localStorage.setItem('admin_base_1', adminBase1);
                    localStorage.setItem('feed_count1', count1);
                    document.getElementById('count-1').innerText = count1.toLocaleString();
                }

                if (adminBase2 !== parseInt(storedAdminBase2)) {
                    count2 = adminBase2;
                    localStorage.setItem('admin_base_2', adminBase2);
                    localStorage.setItem('feed_count2', count2);
                    document.getElementById('count-2').innerText = count2.toLocaleString();
                }
                
                if (data.img1Target) { target1 = parseInt(data.img1Target); document.getElementById('target-1').innerText = target1.toLocaleString(); }
                if (data.img2Target) { target2 = parseInt(data.img2Target); document.getElementById('target-2').innerText = target2.toLocaleString(); }

                img1Locked = data.img1Locked || false;
                img2Locked = data.img2Locked || false;
                document.getElementById('lock-1').innerText = img1Locked ? '🔒' : '🔓';
                document.getElementById('lock-2').innerText = img2Locked ? '🔒' : '🔓';
            }

            const q = window.query(window.collection(window.db, "feed_comments"), window.orderBy("createdAt"));
            const snapshot = await window.getDocs(q);
            
            if (!snapshot.empty) {
                allFeedComments = [];
                snapshot.forEach(function(d) { allFeedComments.push(d.data()); });
                
                const tickerContainer = document.getElementById('tickerContainer');
                tickerContainer.innerHTML = '';
                startTicker();
            }
        } catch(e) { 
            console.log("Load error, keeping defaults:", e); 
        }
    });

    function startTicker() {
        const tickerContainer = document.getElementById('tickerContainer');
        tickerContainer.innerHTML = '';
        if (allFeedComments.length === 0) return;

        for(let i=0; i < Math.min(3, allFeedComments.length); i++) {
            addCommentToTicker(allFeedComments[i]);
        }

        setInterval(function() {
            tickerIndex = (tickerIndex + 1) % allFeedComments.length;
            addCommentToTicker(allFeedComments[tickerIndex]);
        }, 3000);
    }

    function addCommentToTicker(comment) {
        const tickerContainer = document.getElementById('tickerContainer');
        const line = document.createElement('div');
        line.className = 'comment-line';
        line.innerHTML = '<span class="rainbow-username">' + comment.user + ':</span> <span>' + comment.text + '</span>';
        tickerContainer.appendChild(line);
        if (tickerContainer.children.length > 3) {
            tickerContainer.removeChild(tickerContainer.firstChild);
        }
    }
</script>
</body>
</html>
{% endraw %}
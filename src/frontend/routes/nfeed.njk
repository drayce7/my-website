<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <title>Exclusive Feed</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, getDocs, query, orderBy } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      window.db = getFirestore(app);
      window.collection = collection;
      window.getDocs = getDocs;
      window.query = query;
      window.orderBy = orderBy;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; user-select: none; }
        html, body { height: 100%; overscroll-behavior: none; }
        
        /* Vintage Premium Background */
        body { 
            background: #150d12; 
            height: 100vh; width: 100vw; 
            display: flex; justify-content: center; align-items: center; 
            overflow: hidden; font-family: 'Playfair Display', serif; 
            touch-action: manipulation; 
        }
        
        .bg-mesh {
            position: fixed; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle at 50% 50%, rgba(75, 20, 30, 0.4), transparent 60%),
                        radial-gradient(circle at 80% 20%, rgba(150, 100, 30, 0.1), transparent 40%);
            animation: meshMove 20s ease-in-out infinite alternate;
            z-index: 0; pointer-events: none;
        }
        @keyframes meshMove {
            0% { transform: rotate(0deg) scale(1); }
            100% { transform: rotate(10deg) scale(1.1); }
        }

        .bg-grain {
            position: fixed; inset: 0;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" opacity="0.08"><filter id="noise"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23noise)"/></svg>');
            z-index: 1; pointer-events: none;
        }

        .app-wrapper {
            position: relative; z-index: 10;
            width: 100%; max-width: 500px; height: 100vh;
            display: flex; flex-direction: column;
            background: rgba(20, 15, 18, 0.6);
            backdrop-filter: blur(15px);
            border-left: 1px solid rgba(212, 196, 168, 0.1);
            border-right: 1px solid rgba(212, 196, 168, 0.1);
            overflow: hidden;
        }

        /* Top Ticker & Join Button */
        .top-bar {
            display: flex; align-items: center; gap: 10px;
            background: rgba(10, 5, 8, 0.8);
            padding: 10px 15px; border-bottom: 1px solid rgba(212, 196, 168, 0.2);
            z-index: 20;
        }
        
        .ticker-container { 
            flex-grow: 1; height: 40px; overflow: hidden; position: relative; 
            display: flex; flex-direction: column; justify-content: flex-end; 
            mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent); 
            -webkit-mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent); 
        }
        .comment-line { 
            font-size: 12px; font-weight: 600; color: #d4c4a8; margin-bottom: 4px; 
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
            animation: slideUp 0.4s ease-out forwards; font-family: sans-serif; line-height: 1.2; 
        }
        @keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .rainbow-username { font-family: 'Caveat', cursive; font-size: 15px; font-weight: 700; background: linear-gradient(90deg, #ff00cc, #3333ff, #00ffff, #33ff33, #ffff33, #ff9933, #ff00cc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-right: 5px; }
        
        .btn-join {
            background: linear-gradient(45deg, #d4c4a8, #8a7b72);
            color: #150d12; border: none; padding: 8px 20px;
            border-radius: 20px; font-weight: bold; font-size: 13px;
            cursor: pointer; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px;
        }
        .btn-join:hover { transform: scale(1.05); box-shadow: 0 0 15px rgba(212, 196, 168, 0.4); }

        /* Main Content Area */
        .feed-content {
            flex-grow: 1; overflow-y: auto; padding: 20px 15px;
            display: flex; flex-direction: column; gap: 20px;
        }

        /* The 2 Big Images */
        .image-grid {
            display: flex; gap: 10px; width: 100%;
        }
        .big-image {
            flex: 1; aspect-ratio: 3/4;
            background-color: #2a1b18;
            border: 1px solid rgba(212, 196, 168, 0.3);
            border-radius: 12px;
            background-size: cover; background-position: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: relative; overflow: hidden;
        }
        /* Placeholder styling */
        .big-image::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
        }

        /* Action Buttons */
        .action-bar {
            display: flex; justify-content: space-around; align-items: center;
            background: rgba(30, 20, 25, 0.8);
            padding: 15px; border-radius: 30px;
            border: 1px solid rgba(212, 196, 168, 0.2);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
            margin-top: auto;
        }
        .action-btn {
            width: 50px; height: 50px; border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(212, 196, 168, 0.3);
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; transition: 0.2s; font-size: 24px;
        }
        .action-btn:hover { background: rgba(255, 255, 255, 0.15); transform: scale(1.1); }
        .action-btn:active { transform: scale(0.9); }
        
        .action-icon {
            width: 24px; height: 24px; fill: #d4c4a8;
            transition: 0.3s;
        }

        /* Floating Animation */
        .floating-icon {
            position: absolute;
            width: 30px; height: 30px;
            pointer-events: none;
            z-index: 100;
            fill: #d4c4a8;
            animation: floatUp 2s ease-out forwards;
        }
        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.5); opacity: 0; }
            20% { opacity: 1; transform: translateY(-50px) scale(1); }
            100% { transform: translateY(-300px) scale(1.5); opacity: 0; }
        }

        /* Join Modal */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.8);
            backdrop-filter: blur(5px); display: none; justify-content: center; align-items: center;
            z-index: 1000;
        }
        .modal-overlay.active { display: flex; animation: fadeIn 0.3s; }
        .modal-box {
            background: #1f171a; border: 1px solid #d4c4a8;
            padding: 30px; border-radius: 15px; max-width: 300px; text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }
        .modal-box h2 { font-family: 'Caveat', cursive; color: #d4c4a8; font-size: 32px; margin-bottom: 10px; }
        .modal-box p { color: #8a7b72; font-size: 14px; margin-bottom: 20px; line-height: 1.5; }
        .modal-box button {
            background: #d4c4a8; color: #150d12; border: none; padding: 10px 20px;
            border-radius: 8px; font-weight: bold; cursor: pointer;
        }

    </style>
</head>
<body>

    <div class="bg-mesh"></div>
    <div class="bg-grain"></div>

    <div class="app-wrapper">
        <!-- Top Ticker & Join Button -->
        <div class="top-bar">
            <div class="ticker-container" id="tickerContainer"></div>
            <button class="btn-join" onclick="openJoinModal()" data-i18n="btn_join">Join</button>
        </div>

        <div class="feed-content">
            <!-- 2 Big Images -->
            <div class="image-grid">
                <!-- We will make these dynamically uploadable in the next step -->
                <div class="big-image" style="background-image: url('https://i.postimg.cc/k47Z4Y3F/pexels-photo-220453.jpg');"></div>
                <div class="big-image" style="background-image: url('https://i.postimg.cc/fyZ4Y3F3/pexels-photo-210241.jpg');"></div>
            </div>

            <!-- Action Buttons -->
            <div class="action-bar">
                <!-- Heart -->
                <div class="action-btn" onclick="triggerFloat(this)">
                    <svg class="action-icon" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </div>
                <!-- Star -->
                <div class="action-btn" onclick="triggerFloat(this)">
                    <svg class="action-icon" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                </div>
                <!-- Gift -->
                <div class="action-btn" onclick="triggerFloat(this)">
                    <svg class="action-icon" viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/></svg>
                </div>
                <!-- Dislike -->
                <div class="action-btn" onclick="triggerFloat(this)">
                    <svg class="action-icon" viewBox="0 0 24 24"><path d="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Join Modal -->
    <div class="modal-overlay" id="joinModal" onclick="closeJoinModal()">
        <div class="modal-box" onclick="event.stopPropagation()">
            <h2 data-i18n="join_title">Join the Club</h2>
            <p data-i18n="join_text">You have clicked Join! We will add more details here soon.</p>
            <button onclick="closeJoinModal()" data-i18n="join_close">Okay</button>
        </div>
    </div>

<script>
    // Security Check
    if (!sessionStorage.getItem('loggedInFan')) {
        window.location.href = '/my-website/nlogin/';
    }

    const translations = {
        en: {
            btn_join: "Join",
            join_title: "Join the Club",
            join_text: "You have clicked Join! We will add more details here soon.",
            join_close: "Okay"
        },
        pl: {
            btn_join: "Dołącz",
            join_title: "Dołącz do klubu",
            join_text: "Kliknąłeś Dołącz! Wkrótce dodamy więcej szczegółów.",
            join_close: "Okay"
        },
        hu: {
            btn_join: "Csatlakozás",
            join_title: "Csatlakozz a klubhoz",
            join_text: "Rákattintottál a Csatlakozásra! Hamarosan további részleteket adunk hozzá.",
            join_close: "Rendben"
        },
        sr: {
            btn_join: "Pridruži se",
            join_title: "Pridruži se klubu",
            join_text: "Kliknuli ste Pridruži se! Uskoro ćemo dodati više detalja.",
            join_close: "Okay"
        },
        bs: {
            btn_join: "Pridruži se",
            join_title: "Pridruži se klubu",
            join_text: "Kliknuli ste Pridruži se! Uskoro ćemo dodati više detalja.",
            join_close: "Okay"
        }
    };

    let currentLang = "en";
    function t(key) {
        if (translations[currentLang] && translations[currentLang][key]) return translations[currentLang][key];
        return translations.en[key] || key;
    }

    function detectLang() {
        const saved = localStorage.getItem('selectedLanguage');
        if (saved && translations[saved]) return saved;
        return "en";
    }

    function applyTranslations() {
        currentLang = detectLang();
        document.querySelectorAll('[data-i18n]').forEach(el => {
            el.textContent = t(el.getAttribute('data-i18n'));
        });
    }

    document.addEventListener('DOMContentLoaded', applyTranslations);

    // Modal
    function openJoinModal() {
        document.getElementById('joinModal').classList.add('active');
    }
    function closeJoinModal() {
        document.getElementById('joinModal').classList.remove('active');
    }

    // Floating Animation
    const icons = [
        { id: 'heart', path: 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z' },
        { id: 'star', path: 'M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z' },
        { id: 'gift', path: 'M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z' },
        { id: 'dislike', path: 'M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z' }
    ];

    function triggerFloat(btnElement) {
        // Visual click feedback
        btnElement.style.transform = "scale(0.8)";
        setTimeout(() => btnElement.style.transform = "scale(1)", 150);

        // Randomize the icon that floats
        const randomIcon = icons[Math.floor(Math.random() * icons.length)];
        
        // Get position of the button clicked
        const rect = btnElement.getBoundingClientRect();
        const startX = rect.left + (rect.width / 2);
        const startY = rect.top;

        // Spawn 20 floating icons
        for (let i = 0; i < 20; i++) {
            setTimeout(() => {
                createFloatingIcon(startX, startY, randomIcon.path);
            }, i * 50); // Stagger them slightly so it looks like a wave
        }
    }

    function createFloatingIcon(x, y, path) {
        const svgNS = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("class", "floating-icon");
        svg.setAttribute("viewBox", "0 0 24 24");
        
        const pathEl = document.createElementNS(svgNS, "path");
        pathEl.setAttribute("d", path);
        svg.appendChild(pathEl);

        // Randomize starting position slightly so they don't overlap perfectly
        const randomX = x + (Math.random() * 60) - 30;
        const randomY = y + (Math.random() * 20) - 10;

        svg.style.left = `${randomX}px`;
        svg.style.top = `${randomY}px`;
        
        // Randomize rotation and size slightly
        const size = 20 + Math.random() * 20;
        svg.style.width = `${size}px`;
        svg.style.height = `${size}px`;

        document.body.appendChild(svg);

        // Remove from DOM after animation finishes (2 seconds)
        setTimeout(() => {
            if (svg.parentNode) svg.parentNode.removeChild(svg);
        }, 2000);
    }
</script>
</body>
</html>
---
layout: "base.njk"
title: "CLbomb"
permalink: "/clbomb/"
---
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
    body { background-color: #121212; color: #e0e0e0; font-family: sans-serif; }
    .bomb-container { max-width: 1000px; margin: 0 auto; padding: 10px 20px; }

    .top-line { display: flex; gap: 10px; align-items: center; background: #1e1e1e; border: 1px solid #333; border-radius: 10px; padding: 10px 15px; margin-bottom: 15px; }
    .input-group { display: flex; align-items: center; gap: 8px; }
    .input-group label { font-weight: bold; color: #888; font-size: 13px; text-transform: uppercase; }
    
    .number-input { width: 80px; padding: 8px; font-size: 16px; font-weight: bold; text-align: center; background: #111; border: 2px solid #444; color: white; border-radius: 6px; outline: none; }
    .number-input:focus { border-color: #3b82f6; }

    .go-btn { padding: 8px 15px; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 15px; transition: 0.2s; }
    .go-btn:hover { background: #2563eb; }
    .btn-search { background: #8b5cf6; }
    .btn-search:hover { background: #7c3aed; }
    
    .status-text { flex-grow: 1; font-weight: bold; font-size: 14px; color: #aaa; text-align: right; }

    .main-text-container { display: flex; gap: 10px; margin-bottom: 15px; }
    .main-text-box { 
        flex-grow: 1; background-color: #2e8555; border: 2px solid #236b43; border-radius: 8px; 
        padding: 15px; text-align: center; font-size: 18px; font-weight: bold; 
        color: white; transition: 0.2s; min-height: 24px;
        user-select: text; cursor: pointer;
    }
    .main-text-box:hover { background-color: #236b43; }
    .main-text-box.active { border-color: #f59e0b; box-shadow: 0 0 10px rgba(245, 158, 11, 0.3); }
    .main-text-box.void-state { background-color: #4a0000; border-color: #ff0000; color: #ffaaaa; cursor: not-allowed; }
    
    .btn-copy-main { padding: 15px; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 20px; transition: 0.2s;}
    .btn-copy-main:hover { background: #2563eb; }

    .tabs-container { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
    .tab-btn { padding: 8px 12px; background: #222; color: #ccc; border: 1px solid #444; border-radius: 6px; cursor: pointer; font-weight: bold; transition: 0.2s; flex-grow: 1; text-align: center; font-size: 14px;}
    .tab-btn:hover { background: #333; color: white; }
    .tab-btn.active { background: #3b82f6; color: white; border-color: #2563eb; }

    .copy-panel { background: #1e1e1e; border: 1px solid #333; border-radius: 8px; padding: 15px; margin-bottom: 20px; }
    .copy-row { display: flex; gap: 10px; margin-bottom: 10px; align-items: center; }
    .copy-row:last-child { margin-bottom: 0; }
    .copy-text-display { flex-grow: 1; padding: 10px; background: #111; border: 1px solid #444; border-radius: 6px; min-height: 20px; color: #ccc; font-size: 14px; }
    .copy-text-display.void-state { background-color: #330000; border-color: #ff0000; color: #ff5555; font-weight: bold; text-align: center; }
    
    .btn-icon { padding: 10px 15px; border: none; border-radius: 6px; cursor: pointer; background-color: #3b82f6; color: white; font-size: 18px; transition: 0.2s; }
    .btn-icon:hover { background-color: #2563eb; }
    .btn-icon:disabled { background-color: #444; cursor: not-allowed; }

    .manage-section { background: #181818; border-radius: 12px; border: 1px solid #333; padding: 20px; }
    .manage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .manage-category h3 { color: #888; font-size: 14px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-bottom: 10px;}
    .manage-item { display: flex; gap: 8px; margin-bottom: 8px; }
    .manage-item input { flex-grow: 1; padding: 6px; background-color: #222; border: 1px solid #444; color: white; border-radius: 6px; }
    .btn-delete { background-color: #ef4444; padding: 6px 10px; color: white; border: none; border-radius: 6px; cursor: pointer;}
    .btn-add { background-color: #2e8555; width: 100%; margin-top: 5px; color: white; border: none; padding: 8px; border-radius: 6px; cursor: pointer;}
</style>

<main class="bomb-container">
    <h1 style="margin-top: 10px; margin-bottom: 10px;">CLbomb</h1>
    
    <div class="top-line">
        <div class="input-group">
            <label>Number:</label>
            <input type="text" id="mainNumberInput" class="number-input" maxlength="3" placeholder="000">
        </div>
        <button class="go-btn" onclick="actionAdd()">➔</button>
        <button class="go-btn btn-search" onclick="actionSearch()">🔍</button>
        
        <div class="status-text" id="statusDisplay">Ready</div>
    </div>

    <div class="main-text-container" id="mainTextContainer" style="display: none;">
        <div class="main-text-box" id="mainTextDisplay" onclick="handleMainTextClick()">
            Waiting for number...
        </div>
        <button class="btn-copy-main" onclick="copyMainText()">📋</button>
    </div>

    <div class="tabs-container">
        <button class="tab-btn active" id="tab-pca-standard" onclick="switchTab('pca', 'standard')">Standard PCA</button>
        <button class="tab-btn" id="tab-pca-followup1" onclick="switchTab('pca', 'followup1')">Standard PCA 1</button>
        <button class="tab-btn" id="tab-pca-followup2" onclick="switchTab('pca', 'followup2')">Standard PCA 2</button>
        
        <button class="tab-btn" id="tab-pva-standard" onclick="switchTab('pva', 'standard')">Standard PVA</button>
        <button class="tab-btn" id="tab-pva-followup1" onclick="switchTab('pva', 'followup1')">Standard PVA 1</button>
        <button class="tab-btn" id="tab-pva-followup2" onclick="switchTab('pva', 'followup2')">Standard PVA 2</button>
    </div>

    <div class="copy-panel" id="copyPanel">
        <div id="panel-pca">
            <div class="copy-row">
                <div class="copy-text-display" id="pca-display-1">Loading...</div>
                <button class="btn-icon" id="pca-btn-1" onclick="copyToClipboard('pca-display-1', 'pca-btn-1')">📋</button>
            </div>
            <div class="copy-row">
                <div class="copy-text-display" id="pca-display-2">Loading...</div>
                <button class="btn-icon" id="pca-btn-2" onclick="copyToClipboard('pca-display-2', 'pca-btn-2')">📋</button>
            </div>
        </div>

        <div id="panel-pva" style="display: none;">
            <div class="copy-row">
                <div class="copy-text-display" id="pva-display-1">Loading...</div>
                <button class="btn-icon" id="pva-btn-1" onclick="copyToClipboard('pva-display-1', 'pva-btn-1')">📋</button>
            </div>
        </div>
    </div>

    <div class="manage-section">
        <h2>Manage Your Texts</h2>
        <div class="manage-grid">
            <div>
                <div class="manage-category">
                    <h3>Standard PCA</h3>
                    <div id="pca-standard-list"></div>
                    <button class="btn-add" onclick="addNewText('pca', 'standard')">+ Add</button>
                </div>
                <div class="manage-category" style="margin-top:15px;">
                    <h3>Standard PCA 1</h3>
                    <div id="pca-followup1-list"></div>
                    <button class="btn-add" onclick="addNewText('pca', 'followup1')">+ Add</button>
                </div>
                <div class="manage-category" style="margin-top:15px;">
                    <h3>Standard PCA 2</h3>
                    <div id="pca-followup2-list"></div>
                    <button class="btn-add" onclick="addNewText('pca', 'followup2')">+ Add</button>
                </div>
            </div>

            <div>
                <div class="manage-category">
                    <h3>Standard PVA</h3>
                    <div id="pva-standard-list"></div>
                    <button class="btn-add" onclick="addNewText('pva', 'standard')">+ Add</button>
                </div>
                <div class="manage-category" style="margin-top:15px;">
                    <h3>Standard PVA 1</h3>
                    <div id="pva-followup1-list"></div>
                    <button class="btn-add" onclick="addNewText('pva', 'followup1')">+ Add</button>
                </div>
                <div class="manage-category" style="margin-top:15px;">
                    <h3>Standard PVA 2</h3>
                    <div id="pva-followup2-list"></div>
                    <button class="btn-add" onclick="addNewText('pva', 'followup2')">+ Add</button>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    const SUPABASE_URL = 'https://kbdyicxkldqyceorqjcf.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_uoSULCy1-PGGfd3E9dcfww__PxdPjDb';
    const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    let data = JSON.parse(localStorage.getItem('clbomb_data')) || {
        pca: { standard: ["PCA Main 1", "PCA Main 2"], followup1: ["PCA 1 Sub A"], followup2: ["PCA 2 Sub A"] },
        pva: { standard: ["PVA Main"], followup1: ["PVA 1 Sub"], followup2: ["PVA 2 Sub"] }
    };

    let currentNumber = null;
    let currentMode = null; 
    let currentTab = { type: 'pca', category: 'standard' };
    let cloudTextsForNumber = [];
    let searchIndex = 0; 

    // --- ACTIONS ---

    async function actionAdd() {
        const num = document.getElementById('mainNumberInput').value.trim();
        if (!num) return alert("Please enter a number first!");

        currentNumber = num;
        currentMode = 'add';
        
        const textContainer = document.getElementById('mainTextContainer');
        const displayBox = document.getElementById('mainTextDisplay');
        
        textContainer.style.display = 'flex';
        displayBox.classList.add('active');
        displayBox.classList.remove('void-state');
        
        document.getElementById('statusDisplay').textContent = `ADD MODE: ${num}`;
        document.getElementById('statusDisplay').style.color = '#f59e0b';

        await assignNextFromQueue();
    }

    async function actionSearch() {
        const num = document.getElementById('mainNumberInput').value.trim();
        if (!num) return alert("Please enter a number first!");

        currentNumber = num;
        currentMode = 'search';
        searchIndex = 0;

        document.getElementById('statusDisplay').textContent = `SEARCHING ${num}...`;
        document.getElementById('statusDisplay').style.color = '#3b82f6';
        
        const textContainer = document.getElementById('mainTextContainer');
        const displayBox = document.getElementById('mainTextDisplay');
        
        textContainer.style.display = 'flex';
        displayBox.classList.add('active');
        displayBox.classList.remove('void-state');
        
        cloudTextsForNumber = await fetchTextsFromCloud(num);

        if (cloudTextsForNumber.length === 0) {
            displayBox.textContent = "VOID - No history found";
            displayBox.classList.add('void-state');
            document.getElementById('statusDisplay').textContent = `NO TEXTS FOR ${num}`;
        } else {
            displayBox.textContent = cloudTextsForNumber[searchIndex]; 
            document.getElementById('statusDisplay').textContent = `FOUND ${cloudTextsForNumber.length} TEXTS`;
        }

        renderCopyBoxes(currentTab.type, currentTab.category);
    }

    async function handleMainTextClick() {
        if (currentMode === 'add') {
            copyMainText();
            await assignNextFromQueue();
        } 
        else if (currentMode === 'search') {
            copyMainText();
            if (searchIndex < cloudTextsForNumber.length - 1) {
                searchIndex++;
                document.getElementById('mainTextDisplay').textContent = cloudTextsForNumber[searchIndex];
                document.getElementById('statusDisplay').textContent = `VIEWING ${searchIndex + 1} OF ${cloudTextsForNumber.length}`;
            } else {
                document.getElementById('mainTextDisplay').textContent = "VOID - End of history";
                document.getElementById('mainTextDisplay').classList.add('void-state');
                document.getElementById('statusDisplay').textContent = `END OF HISTORY`;
            }
            renderCopyBoxes(currentTab.type, currentTab.category);
        }
    }

    async function assignNextFromQueue() {
        const displayBox = document.getElementById('mainTextDisplay');
        let masterQueue = JSON.parse(localStorage.getItem('clbomb_queue')) || [];
        
        if (masterQueue.length === 0) {
            displayBox.textContent = "VOID - No texts left in Page 1 Queue!";
            displayBox.classList.add('void-state');
            renderCopyBoxes(currentTab.type, currentTab.category);
            return;
        }

        // Temporarily show the text
        const nextText = masterQueue.shift(); 
        displayBox.textContent = nextText;
        document.getElementById('statusDisplay').textContent = `SAVING TO ${currentNumber}...`;

        // Attempt to save to cloud
        const success = await saveTextToCloud(currentNumber, nextText);

        if (success) {
            // Only remove from local queue if the cloud save was successful
            localStorage.setItem('clbomb_queue', JSON.stringify(masterQueue));
            cloudTextsForNumber.push(nextText);
            document.getElementById('statusDisplay').textContent = `SAVED TO ${currentNumber}`;
            document.getElementById('statusDisplay').style.color = '#10b981'; // Green
        } else {
            // Put the text back if it failed
            masterQueue.unshift(nextText);
            document.getElementById('statusDisplay').textContent = `ERROR SAVING TO CLOUD!`;
            document.getElementById('statusDisplay').style.color = '#ef4444'; // Red
            displayBox.textContent = "Error saving to database. Check console (F12).";
            displayBox.classList.add('void-state');
        }

        renderCopyBoxes(currentTab.type, currentTab.category);
    }

    // --- CLOUD FUNCTIONS ---

    async function saveTextToCloud(number, text) {
        try {
            // 1. Fetch existing
            const { data: existing, error: fetchErr } = await supabaseClient
                .from('clbomb_data')
                .select('assigned_texts')
                .eq('number', number)
                .single();

            if (fetchErr && fetchErr.code !== 'PGRST116') {
                console.error("Fetch Error:", fetchErr);
                return false;
            }

            let currentTexts = existing ? existing.assigned_texts : [];
            currentTexts.push(text);

            // 2. Upsert
            const { error: upsertErr } = await supabaseClient
                .from('clbomb_data')
                .upsert({ number: number, assigned_texts: currentTexts });

            if (upsertErr) {
                console.error("Upsert Error:", upsertErr);
                return false;
            }
            return true;

        } catch (err) {
            console.error("Unexpected Error:", err);
            return false;
        }
    }

    async function fetchTextsFromCloud(number) {
        const { data: existing, error } = await supabaseClient
            .from('clbomb_data')
            .select('assigned_texts')
            .eq('number', number)
            .single();

        if (error && error.code !== 'PGRST116') {
            console.error("Fetch error:", error);
        }
        return existing ? existing.assigned_texts : [];
    }

    // --- COPY FUNCTIONS ---

    function copyMainText() {
        const text = document.getElementById('mainTextDisplay').textContent;
        if (text.includes("VOID") || text.includes("Waiting") || text === "") return;

        navigator.clipboard.writeText(text);
        
        const box = document.getElementById('mainTextDisplay');
        const originalBg = box.style.backgroundColor;
        box.style.backgroundColor = "#10b981"; 
        setTimeout(() => { box.style.backgroundColor = originalBg; }, 300);
    }

    function copyToClipboard(displayId, btnId) {
        const text = document.getElementById(displayId).textContent;
        if (text.includes("VOID") || text === "Empty...") return; 
        
        navigator.clipboard.writeText(text);
        const btn = document.getElementById(btnId);
        const originalText = btn.textContent;
        btn.textContent = "✅";
        setTimeout(() => { btn.textContent = originalText; }, 1000);
    }

    // --- UI RENDERING ---

    function switchTab(type, category) {
        currentTab = { type, category };
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${type}-${category}`).classList.add('active');

        if (type === 'pca') {
            document.getElementById('panel-pca').style.display = 'block';
            document.getElementById('panel-pva').style.display = 'none';
        } else {
            document.getElementById('panel-pca').style.display = 'none';
            document.getElementById('panel-pva').style.display = 'block';
        }
        renderCopyBoxes(type, category);
    }

    function renderCopyBoxes(type, category) {
        const list = data[type][category];
        let masterQueue = JSON.parse(localStorage.getItem('clbomb_queue')) || [];
        let isVoid = false;

        if (currentMode === 'search' && searchIndex >= cloudTextsForNumber.length) isVoid = true;
        if (currentMode === 'add' && masterQueue.length === 0 && cloudTextsForNumber.length === 0) isVoid = true;

        const disp1 = document.getElementById(type + '-display-1');
        const btn1 = document.getElementById(type + '-btn-1');
        
        if (isVoid) {
            disp1.textContent = "VOID 🔴";
            disp1.classList.add('void-state');
            btn1.disabled = true;
            if (type === 'pca') {
                const disp2 = document.getElementById(type + '-display-2');
                const btn2 = document.getElementById(type + '-btn-2');
                disp2.textContent = "VOID 🔴";
                disp2.classList.add('void-state');
                btn2.disabled = true;
            }
            return;
        } else {
            disp1.classList.remove('void-state');
            btn1.disabled = false;
            if (type === 'pca') {
                document.getElementById(type + '-display-2').classList.remove('void-state');
                document.getElementById(type + '-btn-2').disabled = false;
            }
        }

        if (!list || list.length === 0) {
            disp1.textContent = "Empty...";
            if (type === 'pca') document.getElementById(type + '-display-2').textContent = "Empty...";
            return;
        }

        disp1.textContent = list[Math.floor(Math.random() * list.length)];
        if (type === 'pca') {
            document.getElementById(type + '-display-2').textContent = list[Math.floor(Math.random() * list.length)];
        }
    }

    // --- MANAGE SECTION ---
    function renderLists() {
        ['pca', 'pva'].forEach(type => {
            ['standard', 'followup1', 'followup2'].forEach(category => {
                const container = document.getElementById(`${type}-${category}-list`);
                if(!container) return;
                container.innerHTML = '';
                data[type][category].forEach((text, index) => {
                    container.innerHTML += `
                        <div class="manage-item">
                            <input type="text" value="${text}" onchange="updateText('${type}', '${category}', ${index}, this.value)">
                            <button class="btn-delete" onclick="deleteText('${type}', '${category}', ${index})">X</button>
                        </div>
                    `;
                });
            });
        });
    }

    function addNewText(type, category) {
        data[type][category].push("New text...");
        localStorage.setItem('clbomb_data', JSON.stringify(data));
        renderLists();
    }
    function deleteText(type, category, index) {
        data[type][category].splice(index, 1);
        localStorage.setItem('clbomb_data', JSON.stringify(data));
        renderLists();
    }
    function updateText(type, category, index, value) {
        data[type][category][index] = value;
        localStorage.setItem('clbomb_data', JSON.stringify(data));
        renderCopyBoxes(currentTab.type, currentTab.category);
    }

    renderLists();
    switchTab('pca', 'standard'); 
</script>
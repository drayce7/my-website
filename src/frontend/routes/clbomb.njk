<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
  import { getFirestore, doc, getDoc, setDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
    authDomain: "clbomb.firebaseapp.com",
    projectId: "clbomb",
    storageBucket: "clbomb.firebasestorage.app",
    messagingSenderId: "515939060816",
    appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  window.db = db;
  window.doc = doc;
  window.getDoc = getDoc;
  window.setDoc = setDoc;
  
  window.firebaseReady = true;
  window.dispatchEvent(new Event('firebaseLoaded'));
</script>

<style>
    body { background-color: #121212; color: #e0e0e0; font-family: sans-serif; margin: 0; }
    .bomb-container { max-width: 1000px; margin: 0 auto; padding: 10px 20px; }
    
    .top-line { display: flex; gap: 10px; align-items: center; background: #1e1e1e; border: 1px solid #333; border-radius: 10px; padding: 10px 15px; margin-bottom: 10px; }
    .input-group { display: flex; align-items: center; gap: 8px; }
    .input-group label { font-weight: bold; color: #888; font-size: 13px; text-transform: uppercase; }
    
    .number-input { width: 70px; padding: 6px; font-size: 14px; font-weight: bold; text-align: center; background: #111; border: 2px solid #444; color: white; border-radius: 6px; outline: none; }
    .number-input:focus { border-color: #3b82f6; }
    .go-btn { padding: 6px 12px; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; transition: 0.2s; }
    .go-btn:hover { background: #2563eb; }
    .btn-search { background: #8b5cf6; }
    .btn-search:hover { background: #7c3aed; }
    .status-text { flex-grow: 1; font-weight: bold; font-size: 13px; color: #aaa; text-align: right; }

    .main-text-container { display: flex; gap: 10px; margin-bottom: 10px; }
    .main-text-box { flex-grow: 1; background-color: #2e8555; border: 2px solid #236b43; border-radius: 8px; padding: 10px; text-align: center; font-size: 16px; font-weight: bold; color: white; transition: 0.2s; min-height: 24px; user-select: text; cursor: pointer; }
    .main-text-box:hover { background-color: #236b43; }
    .main-text-box.active { border-color: #f59e0b; box-shadow: 0 0 10px rgba(245, 158, 11, 0.3); }
    .main-text-box.void-state { background-color: #4a0000; border-color: #ff0000; color: #ffaaaa; cursor: not-allowed; }
    .btn-copy-main { padding: 10px; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 18px; transition: 0.2s;}
    .btn-copy-main:hover { background: #2563eb; }

    .tabs-container { display: flex; gap: 5px; margin-bottom: 10px; flex-wrap: wrap; }
    .tab-btn { padding: 6px 10px; background: #222; color: #ccc; border: 1px solid #444; border-radius: 6px; cursor: pointer; font-weight: bold; transition: 0.2s; flex-grow: 1; text-align: center; font-size: 12px;}
    .tab-btn:hover { background: #333; color: white; }
    .tab-btn.active { background: #3b82f6; color: white; border-color: #2563eb; }

    .copy-panel { background: #1e1e1e; border: 1px solid #333; border-radius: 8px; padding: 10px; margin-bottom: 10px; }
    .copy-row { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; }
    .copy-row:last-child { margin-bottom: 0; }
    .copy-text-display { flex-grow: 1; padding: 8px; background: #111; border: 1px solid #444; border-radius: 6px; min-height: 20px; color: #ccc; font-size: 13px; }
    
    .btn-icon { padding: 8px 12px; border: none; border-radius: 6px; cursor: pointer; background-color: #3b82f6; color: white; font-size: 16px; transition: 0.2s; }
    .btn-icon:hover { background-color: #2563eb; }
    
    .btn-add-plus { padding: 8px 12px; border: none; border-radius: 6px; cursor: pointer; background-color: #10b981; color: white; font-size: 18px; font-weight: bold; transition: 0.2s; }
    .btn-add-plus:hover { background-color: #059669; }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: none; justify-content: center; align-items: center; z-index: 1000; }
    .modal-overlay.active { display: flex; }
    .modal-box { background: #1e1e1e; padding: 20px; border-radius: 12px; width: 400px; border: 1px solid #444; }
    .modal-box h3 { margin-top: 0; color: #f59e0b; font-size: 16px; border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 15px;}
    
    .modal-input-row { display: flex; gap: 10px; margin-bottom: 15px; }
    .modal-input { flex-grow: 1; padding: 10px; background: #111; border: 2px solid #3b82f6; color: white; border-radius: 6px; box-sizing: border-box; outline: none; }
    
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 15px;}
    .btn-cancel { background: #444; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: bold; }
    .btn-add-modal { background: #3b82f6; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: bold; }
    
    .modal-list { max-height: 200px; overflow-y: auto; margin-bottom: 15px; }
    .modal-list-item { display: flex; justify-content: space-between; background: #222; padding: 8px 10px; border-radius: 6px; margin-bottom: 5px; font-size: 13px; align-items: center; gap: 10px;}
    .modal-list-item span { flex-grow: 1; word-break: break-word;}
    
    .modal-btn-edit { background: #eab308; color: #000; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold;}
    .modal-btn-del { background: #ef4444; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold;}
</style>

<main class="bomb-container">
    <h1 style="margin-top: 5px; margin-bottom: 10px; font-size: 20px;">CLbomb <span style="font-size: 12px; color: #f59e0b; background: #333; padding: 2px 8px; border-radius: 4px; vertical-align: middle;">LIMITED V2</span></h1>
    
    <div class="top-line">
        <div class="input-group">
            <label>Number:</label>
            <input type="text" id="mainNumberInput" class="number-input" maxlength="3" placeholder="000">
        </div>
        <button class="go-btn" onclick="actionAdd()">➔</button>
        <button class="go-btn btn-search" onclick="actionSearch()">🔍</button>
        <div class="status-text" id="statusDisplay">Loading...</div>
    </div>
    
    <div class="main-text-container" id="mainTextContainer" style="display: none;">
        <div class="main-text-box" id="mainTextDisplay" onclick="handleMainTextClick()">Waiting...</div>
        <button class="btn-copy-main" onclick="copyMainText()">📋</button>
    </div>
    
    <div class="tabs-container">
        <button class="tab-btn active" id="tab-pca-standard" onclick="switchTab('pca', 'standard')">Standard PCA</button>
        <button class="tab-btn" id="tab-pca-followup1" onclick="switchTab('pca', 'followup1')">PCA 1</button>
        <button class="tab-btn" id="tab-pca-followup2" onclick="switchTab('pca', 'followup2')">PCA 2</button>
        <button class="tab-btn" id="tab-pva-standard" onclick="switchTab('pva', 'standard')">Standard PVA</button>
        <button class="tab-btn" id="tab-pva-followup1" onclick="switchTab('pva', 'followup1')">PVA 1</button>
        <button class="tab-btn" id="tab-pva-followup2" onclick="switchTab('pva', 'followup2')">PVA 2</button>
    </div>

    <div class="copy-panel" id="copyPanel">
        <div id="panel-pca">
            <div class="copy-row">
                <div class="copy-text-display">PCA Main 1</div>
                <button class="btn-icon" id="pca-btn-1" onclick="nextAndCopy('pca', 1)">📋</button>
                <!-- Notice the + button no longer passes 'standard' directly. It passes the current active tab instead -->
                <button class="btn-add-plus" onclick="openModal('pca', 1)">+</button>
            </div>
            <div class="copy-row">
                <div class="copy-text-display">PCA Main 2</div>
                <button class="btn-icon" id="pca-btn-2" onclick="nextAndCopy('pca', 2)">📋</button>
                <button class="btn-add-plus" onclick="openModal('pca', 2)">+</button>
            </div>
        </div>
        <div id="panel-pva" style="display: none;">
            <div class="copy-row">
                <div class="copy-text-display">PVA Main</div>
                <button class="btn-icon" id="pva-btn-1" onclick="nextAndCopy('pva', 1)">📋</button>
                <button class="btn-add-plus" onclick="openModal('pva', 1)">+</button>
            </div>
        </div>
    </div>
</main>

<div class="modal-overlay" id="addModal">
    <div class="modal-box">
        <h3 id="modalTitle">Manage Texts</h3>
        <div class="modal-list" id="modalList"></div>
        <div class="modal-input-row">
            <input type="text" id="modalInput" class="modal-input" placeholder="Type text here...">
            <button class="btn-add-modal" id="modalAddBtn" onclick="saveModalText()">+ Add</button>
        </div>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeModal()">Close</button>
        </div>
    </div>
</div>

<script>
    // CHANGED TO v11
    let data = JSON.parse(localStorage.getItem('clbomb_data_v11')) || {
        "pca-standard-1": [],
        "pca-standard-2": [],
        "pca-followup1-1": [],
        "pca-followup1-2": [],
        "pca-followup2-1": [],
        "pca-followup2-2": [],
        "pva-standard-1": [],
        "pva-followup1-1": [],
        "pva-followup2-1": []
    };

    let pointer1 = 0; 
    let pointer2 = 0; 

    let currentNumber = null;
    let currentMode = null; 
    let currentTab = { type: 'pca', category: 'standard' };
    let cloudTextsForNumber = [];
    let searchIndex = 0; 
    let masterQueue = []; 
    
    let currentModalKey = "";
    let editingIndex = -1; 

    window.addEventListener('firebaseLoaded', async () => {
        document.getElementById('statusDisplay').textContent = "Loading Queue...";
        await fetchCloudQueue();
        document.getElementById('statusDisplay').textContent = masterQueue.length > 0 ? `Ready (${masterQueue.length} texts)` : "Ready (Queue empty)";
    });

    async function fetchCloudQueue() {
        try {
            const docRef = window.doc(window.db, "clbomb_queue", "current_queue");
            const docSnap = await window.getDoc(docRef);
            masterQueue = docSnap.exists() ? docSnap.data().texts || [] : [];
        } catch (e) { console.error("Error loading queue", e); }
    }

    async function actionAdd() {
        const num = document.getElementById('mainNumberInput').value.trim();
        if (!num) return alert("Please enter a number first!");
        if (!window.firebaseReady) return alert("Database still loading...");

        currentNumber = num;
        currentMode = 'add';
        
        const textContainer = document.getElementById('mainTextContainer');
        const displayBox = document.getElementById('mainTextDisplay');
        
        textContainer.style.display = 'flex';
        displayBox.classList.add('active');
        displayBox.classList.remove('void-state');
        
        document.getElementById('statusDisplay').textContent = `Checking queue...`;
        document.getElementById('statusDisplay').style.color = '#f59e0b';

        await fetchCloudQueue();
        document.getElementById('statusDisplay').textContent = `ADD MODE: ${num}`;
        await assignNextFromQueue();
    }

    async function actionSearch() {
        const num = document.getElementById('mainNumberInput').value.trim();
        if (!num) return alert("Please enter a number first!");
        if (!window.firebaseReady) return alert("Database still loading...");

        currentNumber = num;
        currentMode = 'search';
        searchIndex = 0;

        document.getElementById('statusDisplay').textContent = `SEARCHING ${num}...`;
        document.getElementById('statusDisplay').style.color = '#3b82f6';
        
        const textContainer = document.getElementById('mainTextContainer');
        const displayBox = document.getElementById('mainTextDisplay');
        
        textContainer.style.display = 'flex';
        displayBox.classList.add('active');
        displayBox.classList.remove('void-state');
        
        cloudTextsForNumber = await fetchTextsFromCloud(num);

        if (cloudTextsForNumber.length === 0) {
            displayBox.textContent = "VOID - No history found";
            displayBox.classList.add('void-state');
            document.getElementById('statusDisplay').textContent = `NO TEXTS FOR ${num}`;
        } else {
            displayBox.textContent = cloudTextsForNumber[searchIndex]; 
            document.getElementById('statusDisplay').textContent = `FOUND ${cloudTextsForNumber.length} TEXTS`;
        }
    }

    async function handleMainTextClick() {
        if (currentMode === 'add') { copyMainText(); } 
        else if (currentMode === 'search') {
            copyMainText();
            if (searchIndex < cloudTextsForNumber.length - 1) {
                searchIndex++;
                document.getElementById('mainTextDisplay').textContent = cloudTextsForNumber[searchIndex];
                document.getElementById('statusDisplay').textContent = `VIEWING ${searchIndex + 1} OF ${cloudTextsForNumber.length}`;
            } else {
                document.getElementById('mainTextDisplay').textContent = "VOID - End of history";
                document.getElementById('mainTextDisplay').classList.add('void-state');
                document.getElementById('statusDisplay').textContent = `END OF HISTORY`;
            }
        }
    }

    async function assignNextFromQueue() {
        const displayBox = document.getElementById('mainTextDisplay');
        if (masterQueue.length === 0) {
            displayBox.textContent = "VOID - No texts left in Page 1 Queue!";
            displayBox.classList.add('void-state');
            return;
        }

        const nextText = masterQueue.shift(); 
        displayBox.textContent = nextText;
        document.getElementById('statusDisplay').textContent = `SAVING TO ${currentNumber}...`;

        const success = await saveTextToCloud(currentNumber, nextText);

        if (success) {
            await updateCloudQueue();
            cloudTextsForNumber.push(nextText);
            document.getElementById('statusDisplay').textContent = `SAVED TO ${currentNumber}`;
            document.getElementById('statusDisplay').style.color = '#10b981'; 
        } else {
            masterQueue.unshift(nextText);
            document.getElementById('statusDisplay').textContent = `ERROR SAVING TO CLOUD!`;
            document.getElementById('statusDisplay').style.color = '#ef4444'; 
            displayBox.textContent = "Error saving to database.";
            displayBox.classList.add('void-state');
        }
    }

    async function updateCloudQueue() {
        try {
            const docRef = window.doc(window.db, "clbomb_queue", "current_queue");
            await window.setDoc(docRef, { texts: masterQueue });
        } catch (e) { console.error("Failed to update queue", e); }
    }

    async function saveTextToCloud(number, text) {
        try {
            const docRef = window.doc(window.db, "clbomb_data", number);
            const docSnap = await window.getDoc(docRef);
            let currentTexts = docSnap.exists() ? docSnap.data().assigned_texts || [] : [];
            currentTexts.push(text);
            await window.setDoc(docRef, { assigned_texts: currentTexts });
            return true;
        } catch (err) { console.error("Firebase Save Error:", err); return false; }
    }

    async function fetchTextsFromCloud(number) {
        try {
            const docRef = window.doc(window.db, "clbomb_data", number);
            const docSnap = await window.getDoc(docRef);
            return docSnap.exists() ? docSnap.data().assigned_texts || [] : [];
        } catch (err) { console.error("Firebase Fetch Error:", err); return []; }
    }

    function copyMainText() {
        const text = document.getElementById('mainTextDisplay').textContent;
        if (text.includes("VOID") || text.includes("Waiting") || text === "") return;
        navigator.clipboard.writeText(text);
        const box = document.getElementById('mainTextDisplay');
        const originalBg = box.style.backgroundColor;
        box.style.backgroundColor = "#10b981"; 
        setTimeout(() => { box.style.backgroundColor = originalBg; }, 300);
    }

    function nextAndCopy(type, boxNum) {
        // Dynamically determine the flat key based on the active tab and the button clicked
        const activeCategory = currentTab.category; 
        const key = `${type}-${activeCategory}-${boxNum}`;
        const list = data[key];

        if (!list || list.length === 0) {
            alert("No texts saved in this specific line yet. Click the + button to add one!");
            return;
        }

        let currentPointer = (boxNum === 1) ? pointer1 : pointer2;
        const textToCopy = list[currentPointer % list.length];

        navigator.clipboard.writeText(textToCopy).then(() => {
            const btnId = type + '-btn-' + boxNum;
            const btn = document.getElementById(btnId);
            const originalText = btn.textContent;
            btn.textContent = "✅";
            setTimeout(() => { btn.textContent = originalText; }, 1000);

            if (boxNum === 1) pointer1 = (pointer1 + 1) % list.length;
            else pointer2 = (pointer2 + 1) % list.length;
        });
    }

    function switchTab(type, category) {
        currentTab = { type, category };
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${type}-${category}`).classList.add('active');

        if (type === 'pca') {
            document.getElementById('panel-pca').style.display = 'block';
            document.getElementById('panel-pva').style.display = 'none';
        } else {
            document.getElementById('panel-pca').style.display = 'none';
            document.getElementById('panel-pva').style.display = 'block';
        }
        
        pointer1 = 0;
        pointer2 = 0;
    }

    // FIXED: It now reads currentTab.category so the + button uses the active tab
    function openModal(type, boxNum) {
        // Get the currently active category
        const activeCategory = currentTab.category;
        
        // Create the specific key for this exact box
        currentModalKey = `${type}-${activeCategory}-${boxNum}`;
        
        const categoryNames = { standard: "Standard", followup1: "1", followup2: "2" };
        const title = document.getElementById('modalTitle');
        title.textContent = `Manage Texts for ${type.toUpperCase()} ${categoryNames[activeCategory]} - Line ${boxNum}`;
        
        document.getElementById('addModal').classList.add('active');
        
        editingIndex = -1;
        document.getElementById('modalInput').value = "";
        document.getElementById('modalAddBtn').textContent = "+ Add";
        document.getElementById('modalAddBtn').onclick = saveModalText;
        
        renderModalList();
        setTimeout(() => document.getElementById('modalInput').focus(), 100);
    }

    function closeModal() {
        document.getElementById('addModal').classList.remove('active');
    }

    function renderModalList() {
        const container = document.getElementById('modalList');
        container.innerHTML = '';
        
        const list = data[currentModalKey];

        if (list.length === 0) {
            container.innerHTML = `<p style="color:#888; font-size:12px; text-align:center;">No texts yet.</p>`;
            return;
        }

        list.forEach((text, index) => {
            const item = document.createElement('div');
            item.className = 'modal-list-item';
            item.innerHTML = `
                <span>${text}</span>
                <div style="display:flex; gap:5px;">
                    <button class="modal-btn-edit" onclick="editFromModal(${index})">✏️</button>
                    <button class="modal-btn-del" onclick="deleteFromModal(${index})">X</button>
                </div>
            `;
            container.appendChild(item);
        });
    }

    function saveModalText() {
        const text = document.getElementById('modalInput').value.trim();
        if (!text) return;
        
        const list = data[currentModalKey];

        if (editingIndex === -1) {
            list.push(text);
        } else {
            list[editingIndex] = text;
            editingIndex = -1; 
            document.getElementById('modalAddBtn').textContent = "+ Add";
            document.getElementById('modalAddBtn').onclick = saveModalText;
        }

        localStorage.setItem('clbomb_data_v11', JSON.stringify(data));
        
        document.getElementById('modalInput').value = "";
        renderModalList();
    }

    function editFromModal(index) {
        const list = data[currentModalKey];
        document.getElementById('modalInput').value = list[index];
        document.getElementById('modalInput').focus();
        
        editingIndex = index;
        
        const btn = document.getElementById('modalAddBtn');
        btn.textContent = "Save Edit";
        btn.onclick = saveModalText;
    }

    function deleteFromModal(index) {
        const list = data[currentModalKey];
        list.splice(index, 1);
        localStorage.setItem('clbomb_data_v11', JSON.stringify(data));
        
        if (editingIndex === index) {
            editingIndex = -1;
            document.getElementById('modalInput').value = "";
            document.getElementById('modalAddBtn').textContent = "+ Add";
        }
        
        renderModalList();
    }

    switchTab('pca', 'standard'); 
</script>
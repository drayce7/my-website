---
title: "Home - Connect"
permalink: "/home/"
layout: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connect - Home</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-auth.js";
      import { getFirestore, doc, getDoc, collection, getDocs, addDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      window.auth = getAuth(app);
      window.db = getFirestore(app);
      
      window.onAuthStateChanged = onAuthStateChanged;
      window.signOut = signOut;
      window.doc = doc;
      window.getDoc = getDoc;
      window.collection = collection;
      window.getDocs = getDocs;
      window.addDoc = addDoc;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        :root {
            --bg-dark: #0f0c29;
            --bg-gradient: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            --sidebar-bg: rgba(15, 12, 41, 0.85);
            --glass: rgba(255, 255, 255, 0.05);
            --border-glass: rgba(255, 255, 255, 0.1);
            --primary: #00d2ff;
            --text-main: #ffffff;
            --text-muted: #a0a0b0;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: var(--bg-gradient); 
            color: var(--text-main); 
            height: 100vh; 
            width: 100vw; 
            display: flex; 
            overflow: hidden; 
        }

        /* --- SIDEBAR --- */
        .sidebar { 
            width: 280px; 
            background: var(--sidebar-bg); 
            backdrop-filter: blur(20px); 
            border-right: 1px solid var(--border-glass); 
            display: flex; 
            flex-direction: column; 
            padding: 20px; 
            transition: transform 0.3s ease;
            z-index: 100;
        }

        .brand { font-size: 24px; font-weight: bold; color: var(--primary); margin-bottom: 30px; letter-spacing: 1px; }
        
        .user-profile { display: flex; align-items: center; gap: 12px; padding: 15px; background: var(--glass); border-radius: 12px; border: 1px solid var(--border-glass); margin-bottom: 30px; cursor: pointer; transition: 0.3s; }
        .user-profile:hover { background: rgba(255,255,255,0.1); box-shadow: 0 0 15px rgba(0, 210, 255, 0.2); }
        .avatar { width: 45px; height: 45px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-weight: bold; font-size: 20px; flex-shrink: 0;}
        
        .rainbow-text { background: linear-gradient(90deg, #ff00cc, #3333ff, #00ffff, #33ff33, #ffff33, #ff9933, #ff00cc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: bold; letter-spacing: 0.5px; }
        
        .user-info h4 { font-size: 15px; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px;}
        .user-info p { font-size: 12px; color: var(--text-muted); }

        .nav-links { display: flex; flex-direction: column; gap: 5px; }
        .nav-item { padding: 12px 15px; border-radius: 8px; cursor: pointer; color: var(--text-muted); font-weight: 600; transition: 0.2s; display: flex; align-items: center; gap: 10px; white-space: nowrap; }
        .nav-item:hover, .nav-item.active { background: var(--glass); color: var(--text-main); }
        .nav-item.active { border-left: 3px solid var(--primary); }

        .spacer { flex-grow: 1; }
        .btn-logout { background: transparent; border: 1px solid rgba(255, 75, 75, 0.3); color: #ff4b4b; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: 0.2s; text-align: center; }
        .btn-logout:hover { background: rgba(255, 75, 75, 0.1); }

        /* --- MAIN CONTENT --- */
        .main-content { flex-grow: 1; padding: 30px; display: flex; flex-direction: column; overflow-y: auto; scroll-behavior: smooth; }
        
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .header h1 { font-size: 28px; }
        .btn-create { background: var(--primary); color: #000; border: none; padding: 12px 24px; border-radius: 12px; font-weight: bold; cursor: pointer; transition: 0.2s; font-size: 14px; }
        .btn-create:hover { background: #00b8e6; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(0,210,255,0.4); }

        /* --- ROOM CARDS --- */
        .feed-grid { display: flex; flex-direction: column; gap: 20px; padding-bottom: 80px; }
        
        .room-card { 
            background: var(--glass); border: 1px solid var(--border-glass); 
            border-radius: 20px; padding: 25px; display: flex; align-items: center; gap: 20px; 
            cursor: pointer; transition: 0.3s; position: relative; overflow: hidden;
        }
        .room-card:hover { background: rgba(255,255,255,0.08); transform: translateY(-3px); border-color: var(--primary); box-shadow: 0 10px 25px rgba(0,210,255,0.15); }
        
        .room-icon { 
            width: 70px; height: 70px; border-radius: 18px; 
            background: linear-gradient(135deg, #ff00cc, #333399); 
            display: flex; justify-content: center; align-items: center; 
            font-size: 28px; font-weight: bold; flex-shrink: 0; position: relative;
        }
        
        /* The little green "Online" dot */
        .room-icon::after {
            content: ''; position: absolute; bottom: -2px; right: -2px; width: 18px; height: 18px;
            background: #10b981; border-radius: 50%; border: 3px solid #1e1e2f;
        }

        .room-info { flex-grow: 1; }
        .room-info h3 { font-size: 20px; margin-bottom: 6px; color: var(--primary); display: flex; align-items: center; gap: 10px;}
        .room-info p { font-size: 14px; color: var(--text-muted); line-height: 1.5; margin-bottom: 12px; }
        
        .room-meta { display: flex; gap: 15px; font-size: 12px; color: #888; flex-wrap: wrap; }
        .meta-item { display: flex; align-items: center; gap: 5px; background: rgba(255,255,255,0.05); padding: 5px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);}
        .meta-item strong { color: white; }

        /* --- MODALS --- */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-overlay.active { display: flex; }
        .modal-box { background: #1e1e2f; padding: 30px; border-radius: 20px; width: 100%; max-width: 450px; border: 1px solid var(--primary); box-shadow: 0 0 40px rgba(0,210,255,0.15); margin: 20px;}
        .modal-box h2 { color: var(--primary); margin-bottom: 20px; }
        .modal-box input, .modal-box textarea { width: 100%; padding: 14px; background: rgba(0,0,0,0.3); border: 1px solid #444; border-radius: 10px; color: white; margin-bottom: 15px; font-family: inherit; outline: none;}
        .modal-box input:focus, .modal-box textarea:focus { border-color: var(--primary); }
        .modal-box textarea { resize: none; height: 100px; }
        
        .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }

        /* --- MOBILE RESPONSIVENESS --- */
        @media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { 
                width: 100%; height: 70px; flex-direction: row; padding: 10px 20px; 
                align-items: center; justify-content: space-between; border-right: none; border-bottom: 1px solid var(--border-glass);
            }
            .brand { margin-bottom: 0; font-size: 20px;}
            .user-profile { margin-bottom: 0; border: none; background: transparent; padding: 5px; }
            .user-info { display: none; } /* Hide text on mobile header */
            .nav-links { display: none; } /* Hide nav links on mobile for now */
            .btn-logout { display: none; }
            
            .main-content { padding: 20px; }
            .room-card { flex-direction: column; text-align: center; padding: 20px; }
            .room-info h3 { justify-content: center; }
            .room-meta { justify-content: center; }
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="brand">Connect</div>
        
        <div class="user-profile" onclick="openProfile()">
            <div class="avatar" id="sidebarAvatar">?</div>
            <div class="user-info">
                <h4 id="sidebarName" class="rainbow-text">Loading...</h4>
                <p id="sidebarHandle">@...</p>
            </div>
        </div>

        <div class="nav-links">
            <div class="nav-item active" onclick="location.reload()">🏠 Home Feed</div>
            <div class="nav-item" onclick="showComingSoon('Friends')">👥 Friends</div>
            <div class="nav-item" onclick="showComingSoon('Direct Messages')">💬 Direct Messages</div>
            <div class="nav-item" onclick="showComingSoon('Settings')">⚙️ Settings</div>
        </div>

        <div class="spacer"></div>
        <button class="btn-logout" onclick="handleLogout()">Log Out</button>
    </aside>

    <main class="main-content" id="mainContent">
        <div class="header">
            <h1>Discover</h1>
            <button class="btn-create" onclick="openCreateModal()">+ Create Room</button>
        </div>

        <div class="feed-grid" id="feedGrid">
            <!-- Content loads here -->
        </div>
    </main>

    <!-- CREATE ROOM MODAL -->
    <div class="modal-overlay" id="createModal">
        <div class="modal-box">
            <h2>Create a Room</h2>
            <input type="text" id="roomName" placeholder="Room Name">
            <textarea id="roomDesc" placeholder="What is this room about?"></textarea>
            <div class="modal-actions">
                <button class="btn-logout" style="border-color:#444; color:white; padding:12px 24px;" onclick="closeCreateModal()">Cancel</button>
                <button class="btn-create" onclick="createRoom()">Create Room</button>
            </div>
        </div>
    </div>

    <!-- COMING SOON MODAL -->
    <div class="modal-overlay" id="comingSoonModal">
        <div class="modal-box" style="text-align:center;">
            <h2 id="csTitle">Coming Soon</h2>
            <p style="margin-bottom:20px; color:var(--text-muted);">We are building this feature right now. Check back later!</p>
            <button class="btn-create" onclick="document.getElementById('comingSoonModal').classList.remove('active')">Got it</button>
        </div>
    </div>

<script>
    let currentUserData = null;
    let autoScrollInterval;
    let isAutoScrolling = true;

    window.addEventListener('firebaseLoaded', () => {
        window.onAuthStateChanged(window.auth, async (user) => {
            if (user) {
                const docRef = window.doc(window.db, "users", user.uid);
                const docSnap = await window.getDoc(docRef);
                
                if (docSnap.exists()) {
                    currentUserData = docSnap.data();
                    
                    const avatar = document.getElementById('sidebarAvatar');
                    avatar.textContent = currentUserData.name.charAt(0).toUpperCase();
                    avatar.style.background = currentUserData.avatarColor || '#3a7bd5';
                    
                    document.getElementById('sidebarName').textContent = currentUserData.nickname || currentUserData.name;
                    document.getElementById('sidebarHandle').textContent = "@" + currentUserData.username;
                }

                loadFeed();
                startAutoScroll();
            } else {
                window.location.href = '/my-website/login/';
            }
        });
    });

    // --- AUTO SCROLL LOGIC (FIXED) ---
    function startAutoScroll() {
        const mainContent = document.getElementById('mainContent');
        
        function scrollStep() {
            if (!isAutoScrolling) return;
            
            // If we reached the bottom, scroll back to top smoothly
            if (mainContent.scrollHeight - mainContent.scrollTop - mainContent.clientHeight < 5) {
                mainContent.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                mainContent.scrollBy({ top: 200, behavior: 'smooth' });
            }
            
            // Random wait between 5 and 9 seconds
            const randomDelay = Math.floor(Math.random() * 4000) + 5000;
            autoScrollInterval = setTimeout(scrollStep, randomDelay);
        }

        autoScrollInterval = setTimeout(scrollStep, 5000);
    }

    // Pause only when the mouse hovers EXACTLY over a card (not the whole page)
    document.getElementById('feedGrid').addEventListener('mouseenter', () => { isAutoScrolling = false; });
    document.getElementById('feedGrid').addEventListener('mouseleave', () => { isAutoScrolling = true; });

    // --- LOAD FEED ---
    async function loadFeed() {
        const grid = document.getElementById('feedGrid');
        grid.innerHTML = '<div style="color: var(--text-muted); padding: 20px;">Loading rooms...</div>';

        try {
            const querySnapshot = await window.getDocs(window.collection(window.db, "rooms"));
            grid.innerHTML = ''; 

            if (querySnapshot.empty) {
                grid.innerHTML = '<div style="color: var(--text-muted); text-align:center; padding: 40px;">No rooms yet. Create the first one!</div>';
                return;
            }

            querySnapshot.forEach((doc) => {
                const data = doc.data();
                const div = document.createElement('div');
                div.className = 'room-card';
                div.onclick = () => { window.location.href = `/my-website/room/?id=${doc.id}`; };
                
                // Simulated member count and status for now
                const memberCount = Math.floor(Math.random() * 50) + 3; 

                div.innerHTML = `
                    <div class="room-icon">${data.name.charAt(0).toUpperCase()}</div>
                    <div class="room-info">
                        <h3>${data.name} <span style="font-size:12px; color:#10b981; background:rgba(16,185,129,0.1); padding:2px 8px; border-radius:10px; border:1px solid rgba(16,185,129,0.3);">Active</span></h3>
                        <p>${data.description || "A public room."}</p>
                        <div class="room-meta">
                            <div class="meta-item">👥 <strong>${memberCount}</strong> Members</div>
                            <div class="meta-item">👑 Created by @${data.createdBy}</div>
                        </div>
                    </div>
                `;
                grid.appendChild(div);
            });

        } catch (e) {
            console.error("Error loading feed: ", e);
            grid.innerHTML = '<div style="color: #ff4b4b; text-align:center; padding: 40px;">Failed to load feed.</div>';
        }
    }

    function openCreateModal() { document.getElementById('createModal').classList.add('active'); }
    function closeCreateModal() { document.getElementById('createModal').classList.remove('active'); }

    async function createRoom() {
        const name = document.getElementById('roomName').value.trim();
        const desc = document.getElementById('roomDesc').value.trim();

        if (!name) return alert("Please enter a room name.");

        try {
            await window.addDoc(window.collection(window.db, "rooms"), {
                name: name,
                description: desc,
                createdBy: currentUserData ? currentUserData.username : "Unknown",
                createdAt: new Date().toISOString()
            });
            closeCreateModal();
            loadFeed(); 
        } catch (e) {
            console.error("Error creating room: ", e);
            alert("Failed to create room.");
        }
    }

    function showComingSoon(title) {
        document.getElementById('csTitle').textContent = title + " Coming Soon";
        document.getElementById('comingSoonModal').classList.add('active');
    }

    function openProfile() { showComingSoon("Profile Settings"); }

    async function handleLogout() {
        await window.signOut(window.auth);
        window.location.href = '/my-website/login/';
    }
</script>
</body>
</html>
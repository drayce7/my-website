{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <title>Welcome</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, query, where, getDocs, addDoc, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      window.db = getFirestore(app);
      window.collection = collection;
      window.query = query; window.where = where;
      window.getDocs = getDocs; window.addDoc = addDoc;
      window.doc = doc; window.getDoc = getDoc;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
        html, body { height: 100%; overscroll-behavior: none; background: #150d12; font-family: 'Playfair Display', serif; overflow: hidden; }
        
        /* Splash Screen */
        .splash-screen {
            position: fixed; inset: 0; background: #150d12;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 9999; transition: opacity 1s ease;
        }
        .splash-screen.hidden { opacity: 0; pointer-events: none; }
        
        .splash-text {
            font-family: 'Caveat', cursive; font-size: 36px; color: #d4c4a8;
            margin-bottom: 10px; text-shadow: 0 0 20px rgba(212, 196, 168, 0.4);
            animation: pulseSplash 2s infinite alternate;
        }
        .splash-sub {
            font-family: sans-serif; font-size: 12px; color: #8a7b72;
            text-transform: uppercase; letter-spacing: 4px;
        }
        @keyframes pulseSplash { from { opacity: 0.7; } to { opacity: 1; } }

        /* Login Box */
        .bg-mesh {
            position: fixed; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle at 50% 50%, rgba(75, 20, 30, 0.4), transparent 60%);
            animation: meshMove 20s ease-in-out infinite alternate; z-index: 0; pointer-events: none;
        }
        @keyframes meshMove { 0% { transform: rotate(0deg) scale(1); } 100% { transform: rotate(10deg) scale(1.1); } }

        .main-wrapper {
            position: relative; z-index: 10; height: 100vh;
            display: flex; justify-content: center; align-items: center;
            opacity: 0; transition: opacity 1s ease;
        }
        .main-wrapper.visible { opacity: 1; }

        .login-wrapper {
            width: 90%; max-width: 400px; background: rgba(20, 15, 18, 0.85);
            backdrop-filter: blur(10px); border: 1px solid rgba(212, 196, 168, 0.2);
            border-radius: 20px; padding: 40px 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }

        .brand-title { font-family: 'Caveat', cursive; font-size: 42px; color: #d4c4a8; text-align: center; margin-bottom: 5px; }
        .brand-sub { font-size: 12px; text-align: center; color: #8a7b72; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 30px; }

        .tab-container { display: flex; justify-content: center; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid rgba(212, 196, 168, 0.1); padding-bottom: 10px; }
        .tab-btn { background: none; border: none; color: #8a7b72; font-family: 'Playfair Display', serif; font-size: 16px; cursor: pointer; padding: 5px 10px; }
        .tab-btn.active { color: #d4c4a8; border-bottom: 2px solid #d4c4a8; }

        .form-group { margin-bottom: 15px; display: none; }
        .form-group.active { display: block; }

        .input-wrap input {
            width: 100%; padding: 14px 15px; background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(212, 196, 168, 0.2); border-radius: 10px; color: #fff;
            font-size: 15px; outline: none; margin-bottom: 15px;
        }
        .btn-submit {
            width: 100%; padding: 15px; background: linear-gradient(45deg, #2a1b18, #4a3026);
            border: 1px solid #d4c4a8; color: #d4c4a8; font-family: sans-serif; font-weight: bold;
            font-size: 16px; border-radius: 10px; cursor: pointer; margin-top: 10px;
        }
        .error-msg { color: #ef4444; font-size: 13px; text-align: center; margin-top: 15px; min-height: 18px; font-family: sans-serif; }

        .success-overlay { position: fixed; inset: 0; background: #150d12; display: none; justify-content: center; align-items: center; flex-direction: column; z-index: 100; }
        .success-overlay.active { display: flex; }
        .spinner { width: 50px; height: 50px; border: 3px solid rgba(212, 196, 168, 0.1); border-top-color: #d4c4a8; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>

    <!-- SPLASH SCREEN -->
    <div class="splash-screen" id="splashScreen">
        <div class="splash-text" id="splashSupported">Supported by Drayce</div>
        <div class="splash-sub" id="splashPowered">Powered by Menai</div>
    </div>

    <div class="bg-mesh"></div>

    <div class="main-wrapper" id="mainWrapper">
        <div class="login-wrapper">
            <div class="brand-title" data-i18n="welcome_title">Welcome</div>
            <div class="brand-sub" data-i18n="welcome_sub">Your exclusive access</div>

            <div class="tab-container">
                <button class="tab-btn active" onclick="switchTab('signin')">Sign In</button>
                <button class="tab-btn" onclick="switchTab('signup')">Sign Up</button>
            </div>

            <div class="form-group active" id="form-signin">
                <div class="input-wrap"><input type="text" id="signinUsername" placeholder="Username"></div>
                <div class="input-wrap"><input type="password" id="signinPin1" placeholder="PIN 1"></div>
                <button class="btn-submit" onclick="handleSignIn()">Enter</button>
            </div>

            <div class="form-group" id="form-signup">
                <div class="input-wrap"><input type="text" id="signupUsername" placeholder="Username"></div>
                <div class="input-wrap"><input type="email" id="signupEmail" placeholder="Email"></div>
                <div class="input-wrap"><input type="password" id="signupPin1" placeholder="Create PIN 1"></div>
                <div class="input-wrap"><input type="password" id="signupPin2" placeholder="Create PIN 2"></div>
                <button class="btn-submit" onclick="handleSignUp()">Create Account</button>
            </div>

            <div class="error-msg" id="errorMsg"></div>
        </div>
    </div>

    <div class="success-overlay" id="successOverlay">
        <div class="spinner"></div>
    </div>

<script>
    // Load Splash Settings & Start Animation
    window.addEventListener('firebaseLoaded', async function() {
        try {
            const snap = await window.getDoc(window.doc(window.db, "app_settings", "login"));
            if (snap.exists()) {
                const data = snap.data();
                if(data.supportedBy) document.getElementById('splashSupported').innerText = data.supportedBy;
                if(data.poweredBy) document.getElementById('splashPowered').innerText = data.poweredBy;
            }
        } catch(e) { console.log(e); }
        
        // Fade out splash after 3 seconds
        setTimeout(() => {
            document.getElementById('splashScreen').classList.add('hidden');
            document.getElementById('mainWrapper').classList.add('visible');
            setTimeout(() => { document.getElementById('splashScreen').style.display = 'none'; }, 1000);
        }, 3000);
    });

    function switchTab(tab) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.form-group').forEach(form => form.classList.remove('active'));
        if (tab === 'signin') {
            document.querySelectorAll('.tab-btn')[0].classList.add('active');
            document.getElementById('form-signin').classList.add('active');
        } else {
            document.querySelectorAll('.tab-btn')[1].classList.add('active');
            document.getElementById('form-signup').classList.add('active');
        }
        document.getElementById('errorMsg').textContent = '';
    }

    function showError(msg) { document.getElementById('errorMsg').textContent = msg; }

    async function handleSignUp() {
        const username = document.getElementById('signupUsername').value.trim();
        const email = document.getElementById('signupEmail').value.trim();
        const pin1 = document.getElementById('signupPin1').value.trim();
        const pin2 = document.getElementById('signupPin2').value.trim();

        if (!username || !email || !pin1 || !pin2) { showError("Please fill all fields"); return; }
        
        try {
            const q = window.query(window.collection(window.db, "users"), window.where("username", "==", username));
            const snapshot = await window.getDocs(q);
            if (!snapshot.empty) { showError("Username taken"); return; }

            await window.addDoc(window.collection(window.db, "users"), { username, email, pin1, pin2, createdAt: new Date().toISOString() });
            sessionStorage.setItem('loggedInFan', username);
            runSuccessAnimation();
        } catch(e) { showError("Network error."); }
    }

    async function handleSignIn() {
        const username = document.getElementById('signinUsername').value.trim();
        const pin1 = document.getElementById('signinPin1').value.trim();

        if (!username || !pin1) { showError("Fill all fields"); return; }
        
        try {
            const q = window.query(window.collection(window.db, "users"), window.where("username", "==", username));
            const snapshot = await window.getDocs(q);
            if (snapshot.empty) { showError("Account not found"); return; }
            
            if (snapshot.docs[0].data().pin1 !== pin1) { showError("Wrong PIN"); return; }
            
            sessionStorage.setItem('loggedInFan', username);
            runSuccessAnimation();
        } catch(e) { showError("Network error."); }
    }

    function runSuccessAnimation() {
        document.getElementById('successOverlay').classList.add('active');
        setTimeout(() => { window.location.href = '/my-website/nselect/'; }, 1500);
    }
</script>
</body>
</html>
{% endraw %}
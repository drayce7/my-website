{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Welcome</title>
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, query, where, getDocs, addDoc, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";
      const firebaseConfig = { apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw", authDomain: "clbomb.firebaseapp.com", projectId: "clbomb", storageBucket: "clbomb.firebasestorage.app", messagingSenderId: "515939060816", appId: "1:515939060816:web:8a68d9d5f40b02c9029555" };
      const app = initializeApp(firebaseConfig); window.db = getFirestore(app);
      window.collection = collection; window.query = query; window.where = where; window.getDocs = getDocs; window.addDoc = addDoc; window.doc = doc; window.getDoc = getDoc;
      window.firebaseReady = true; window.dispatchEvent(new Event('firebaseLoaded'));
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; user-select: none; }
        html, body { height: 100%; background: #150d12; font-family: 'Playfair Display', serif; overflow: hidden; }
        
        .splash-screen { position: fixed; inset: 0; background: #150d12; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 9999; transition: opacity 1s ease; }
        .splash-screen.hidden { opacity: 0; pointer-events: none; }
        .splash-text { font-family: 'Caveat', cursive; font-size: 36px; color: #d4c4a8; margin-bottom: 10px; text-shadow: 0 0 20px rgba(212, 196, 168, 0.4); }
        .splash-sub { font-family: sans-serif; font-size: 12px; color: #8a7b72; text-transform: uppercase; letter-spacing: 4px; }

        .main-wrapper { position: relative; z-index: 10; height: 100vh; display: flex; justify-content: center; align-items: center; opacity: 0; transition: opacity 1s ease; }
        .main-wrapper.visible { opacity: 1; }

        .login-wrapper { width: 90%; max-width: 400px; background: rgba(20, 15, 18, 0.85); border: 1px solid rgba(212, 196, 168, 0.2); border-radius: 20px; padding: 40px 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.8); text-align: center; }
        .brand-title { font-family: 'Caveat', cursive; font-size: 42px; color: #d4c4a8; margin-bottom: 30px; }
        .input-wrap input { width: 100%; padding: 14px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(212, 196, 168, 0.2); border-radius: 10px; color: #fff; font-size: 16px; outline: none; margin-bottom: 15px; text-align: center; }
        .btn-submit { width: 100%; padding: 15px; background: linear-gradient(45deg, #2a1b18, #4a3026); border: 1px solid #d4c4a8; color: #d4c4a8; font-family: sans-serif; font-weight: bold; font-size: 16px; border-radius: 10px; cursor: pointer; margin-top: 10px; }
        
        .code-display { display: none; background: #111827; border: 2px dashed #d4c4a8; padding: 20px; border-radius: 12px; margin-top: 20px; text-align: center; }
        .code-display h3 { color: #e2e8f0; font-family: sans-serif; font-size: 22px; letter-spacing: 2px; margin-bottom: 10px; }
        .code-display p { color: #8a7b72; font-size: 12px; margin-bottom: 15px; }
        .btn-copy { background: #3b82f6; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; width: 100%; }
        .error-msg { color: #ef4444; font-size: 13px; margin-top: 15px; min-height: 18px; }
    </style>
</head>
<body>

    <div class="splash-screen" id="splashScreen">
        <div class="splash-text" id="splashSupported">Supported by Drayce</div>
        <div class="splash-sub" id="splashPowered">Powered by Menai</div>
    </div>

    <div class="main-wrapper" id="mainWrapper">
        <div class="login-wrapper">
            <div class="brand-title">Welcome</div>
            <div id="formArea">
                <div class="input-wrap"><input type="text" id="loginInput" placeholder="Username or Email"></div>
                <button class="btn-submit" onclick="handleLogin()">GO</button>
                <div class="error-msg" id="errorMsg"></div>
            </div>

            <div class="code-display" id="codeDisplay">
                <h3 id="displayCode">XXXX-****-****-XXXX</h3>
                <p>Save this code for future reference.</p>
                <button class="btn-copy" onclick="copyCode()">Copy Code</button>
            </div>
        </div>
    </div>

<script>
    let generatedCode = "";
    
    window.addEventListener('firebaseLoaded', async () => {
        const snap = await window.getDoc(window.doc(window.db, "app_settings", "login"));
        if(snap.exists()) {
            if(snap.data().supportedBy) document.getElementById('splashSupported').innerText = snap.data().supportedBy;
            if(snap.data().poweredBy) document.getElementById('splashPowered').innerText = snap.data().poweredBy;
        }
        
        // 7 Seconds Splash
        setTimeout(() => {
            document.getElementById('splashScreen').classList.add('hidden');
            document.getElementById('mainWrapper').classList.add('visible');
            setTimeout(() => document.getElementById('splashScreen').style.display = 'none', 1000);
        }, 7000);
    });

    async function handleLogin() {
        const val = document.getElementById('loginInput').value.trim();
        if(!val) return;

        try {
            // Check if user exists by username OR email
            const q1 = window.query(window.collection(window.db, "users"), window.where("username", "==", val));
            const s1 = await window.getDocs(q1);
            
            const q2 = window.query(window.collection(window.db, "users"), window.where("email", "==", val));
            const s2 = await window.getDocs(q2);

            if(!s1.empty || !s2.empty) {
                // Existing user -> Go straight to nselect
                const username = !s1.empty ? s1.docs[0].data().username : s2.docs[0].data().username;
                sessionStorage.setItem('loggedInFan', username);
                window.location.href = '/my-website/nselect/';
            } else {
                // New User -> Generate Code
                generatedCode = generate16CharCode();
                const masked = generatedCode.substring(0,4) + '-****-****-' + generatedCode.substring(14);
                document.getElementById('displayCode').innerText = masked;
                
                await window.addDoc(window.collection(window.db, "users"), { 
                    username: val, email: val, code: generatedCode, createdAt: new Date().toISOString() 
                });
                
                document.getElementById('formArea').style.display = 'none';
                document.getElementById('codeDisplay').style.display = 'block';
                sessionStorage.setItem('loggedInFan', val);

                // Wait 5 seconds then go to nselect
                setTimeout(() => {
                    window.location.href = '/my-website/nselect/';
                }, 5000);
            }
        } catch(e) {
            document.getElementById('errorMsg').innerText = "Network Error.";
        }
    }

    function generate16CharCode() {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let code = '';
        for(let i=0; i<16; i++) {
            if(i > 0 && i % 4 === 0) code += '-';
            code += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        return code;
    }

    function copyCode() {
        navigator.clipboard.writeText(generatedCode);
        alert("Code Copied!");
    }
</script>
</body>
</html>
{% endraw %}
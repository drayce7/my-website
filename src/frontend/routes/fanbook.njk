    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
        html, body { height: 100%; overscroll-behavior: none; }
        body { background: #2a1b18; height: 100vh; width: 100vw; display: flex; justify-content: center; align-items: center; overflow: hidden; font-family: 'Playfair Display', serif; touch-action: manipulation; }
        .app-wrapper { position: relative; width: 100vw; height: 100vh; display: flex; flex-direction: column; background: #fdf6e3; background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" opacity="0.05"><filter id="noise"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23noise)"/></svg>'); overflow: hidden; }
        
        .top-region { position: relative; width: 100%; height: 150px; background: rgba(20, 15, 30, 0.95); backdrop-filter: blur(10px); border-bottom: 2px solid #d4c4a8; display: flex; flex-direction: column; padding: 15px; z-index: 50; flex-shrink: 0; overflow: hidden; }
        
        .ticker-container { margin-top: 5px; height: 90px; overflow: hidden; position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 5px; mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent); }
        .comment-line { font-size: 12px; font-weight: 600; color: #e0e0e0; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; animation: slideUp 0.4s ease-out forwards; font-family: sans-serif; padding: 0 5px; line-height: 1.2; }
        @keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .rainbow-username { font-family: 'Caveat', cursive; font-size: 16px; font-weight: 700; background: linear-gradient(90deg, #ff00cc, #3333ff, #00ffff, #33ff33, #ffff33, #ff9933, #ff00cc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-right: 5px; }
        .search-container { margin-top: 10px; display: flex; align-items: center; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 20px; padding: 5px 10px; width: 100%; max-width: 250px; margin-left: auto; margin-right: auto; }
        .search-input { background: transparent; border: none; color: white; font-size: 12px; width: 100%; outline: none; }

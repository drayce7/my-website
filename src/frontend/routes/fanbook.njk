        .fan-area { flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; padding: 0 10px 100px 10px; -webkit-overflow-scrolling: touch; }
        
        .artist-sticky-header {
            position: sticky; top: 0; z-index: 40;
            background: #fdf6e3;
            padding: 15px 10px 12px 10px;

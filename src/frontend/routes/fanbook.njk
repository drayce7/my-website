<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artist Fanbook</title>
    
    <script type="module">
      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #2a1b18; 
            background: radial-gradient(circle, #3d2c28 0%, #1a0f0d 100%);
            height: 100vh;
            width: 100vw;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: 'Playfair Display', serif;
            perspective: 1500px;
        }

        /* --- THE BOOK CONTAINER --- */
        .book-container {
            position: relative;
            width: 95vw;
            max-width: 1000px;
            height: 85vh;
            max-height: 700px;
            display: flex;
            transform-style: preserve-3d;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            border-radius: 10px;
        }

        /* --- THE PAPER PAGES --- */
        .page {
            position: relative;
            width: 50%;
            height: 100%;
            background: #fdf6e3;
            background: linear-gradient(to right, #fdf6e3 0%, #f4e8c1 100%);
            border: 1px solid #d4c4a8;
            display: flex;
            flex-direction: column;
            padding: 30px;
            overflow-y: auto;
            scrollbar-width: none; /* Hide scrollbar */
        }
        .page::-webkit-scrollbar { display: none; }

        /* Left Page styling */
        .page-left {
            border-radius: 10px 0 0 10px;
            box-shadow: inset -15px 0 30px rgba(0,0,0,0.05), inset 0 0 30px rgba(180, 150, 110, 0.2);
            transform-origin: right center;
            background: linear-gradient(to left, #f4e8c1 0%, #fdf6e3 100%);
        }

        /* Right Page styling */
        .page-right {
            border-radius: 0 10px 10px 0;
            box-shadow: inset 15px 0 30px rgba(0,0,0,0.05), inset 0 0 30px rgba(180, 150, 110, 0.2);
            transform-origin: left center;
            background: linear-gradient(to right, #f4e8c1 0%, #fdf6e3 100%);
        }

        /* Spine in the middle */
        .book-spine {
            position: absolute;
            left: 50%;
            top: 0;
            width: 6px;
            height: 100%;
            background: #d4c4a8;
            transform: translateX(-50%);
            box-shadow: 0 0 15px rgba(0,0,0,0.4);
            z-index: 10;
        }

        /* --- FAN GRID (TIGHTLY PACKED) --- */
        .fan-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            gap: 20px 15px;
            padding: 10px 0;
        }

        .fan-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .fan-card:hover { transform: scale(1.05); }

        /* THE THICK CIRCLE AVATAR */
        .fan-avatar {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 30px;
            color: white;
            /* The thicker border ring */
            border: 6px solid #d4c4a8; 
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
            margin-bottom: 10px;
            background-size: cover;
            background-position: center;
        }

        /* THE RECTANGULAR EMAIL BOX */
        .fan-email {
            background: #f0e4d0;
            border: 1.5px solid #c4b4a8;
            padding: 4px 6px;
            border-radius: 4px;
            font-family: monospace;
            font-size: 10px;
            color: #6a5b52;
            width: 100%;
            max-width: 110px;
            letter-spacing: 0.2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* --- PAGE CONTROLS --- */
        .controls {
            position: absolute;
            bottom: -70px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 20px;
            z-index: 20;
        }

        .btn {
            background: #fdf6e3;
            color: #4a3b32;
            border: 2px solid #d4c4a8;
            padding: 12px 25px;
            border-radius: 30px;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: 0.2s;
        }

        .btn:hover { background: #fff; transform: translateY(-2px); }
        .btn:active { transform: translateY(0); }

        /* --- ANIMATION --- */
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* --- MOBILE RESPONSIVENESS --- */
        @media (max-width: 768px) {
            .book-container { 
                width: 90vw; 
                height: 80vh; 
                flex-direction: column; 
                border-radius: 10px;
            }
            .page { width: 100%; height: 100%; padding: 20px; }
            .page-left { display: none; } /* Hide left page on mobile, act like a single sheet */
            .page-right { border-radius: 10px; }
            .book-spine { display: none; }
            .fan-grid { grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 15px 10px; }
            .fan-avatar { width: 70px; height: 70px; font-size: 24px; border-width: 5px; }
        }
    </style>
</head>
<body>

    <div class="book-container">
        
        <!-- Left Page -->
        <div class="page page-left" id="pageLeft">
            <h1 style="font-family: 'Caveat', cursive; font-size: 36px; color: #4a3b32; text-align: center; margin-bottom: 20px;">The Fans</h1>
            <div class="fan-grid" id="leftGrid">
                <!-- Fans go here -->
            </div>
        </div>

        <!-- Spine -->
        <div class="book-spine"></div>

        <!-- Right Page -->
        <div class="page page-right" id="pageRight">
            <h1 style="font-family: 'Caveat', cursive; font-size: 36px; color: #4a3b32; text-align: center; margin-bottom: 20px;">The Supporters</h1>
            <div class="fan-grid" id="rightGrid">
                <!-- Fans go here -->
            </div>
        </div>

        <!-- Controls -->
        <div class="controls">
            <button class="btn" onclick="nextPage()">Swipe Page →</button>
        </div>

    </div>

<script>
    // 30 Imaginary fans
    const fanData = [
        { email: "sarah.m@email.com", color: "#ffb3ba" },
        { email: "mike.t@email.com", color: "#bae1ff" },
        { email: "jess.r@email.com", color: "#ffffba" },
        { email: "alex.j@email.com", color: "#baffc9" },
        { email: "emma.w@email.com", color: "#e6b3ff" },
        { email: "david.l@email.com", color: "#ffccb3" },
        { email: "chloe.b@email.com", color: "#b3e6ff" },
        { email: "ryan.g@email.com", color: "#ffb3e6" },
        { email: "olivia.k@email.com", color: "#ccffb3" },
        { email: "james.p@email.com", color: "#ffd9b3" },
        { email: "sophia.r@email.com", color: "#b3ffcc" },
        { email: "daniel.m@email.com", color: "#e6ccff" },
        { email: "mia.s@email.com", color: "#ffb3cc" },
        { email: "noah.t@email.com", color: "#ccb3ff" },
        { email: "isabella.d@email.com", color: "#ffffcc" },
        { email: "liam.h@email.com", color: "#ffccf2" },
        { email: "ava.c@email.com", color: "#ccfff2" },
        { email: "ethan.b@email.com", color: "#ffebcc" },
        { email: "amelia.f@email.com", color: "#ebccff" },
        { email: "lucas.g@email.com", color: "#ccffeb" },
        { email: "harper.j@email.com", color: "#ffccd9" },
        { email: "mason.k@email.com", color: "#ccd9ff" },
        { email: "evelyn.l@email.com", color: "#e6ffcc" },
        { email: "logan.m@email.com", color: "#ffccb3" },
        { email: "abigail.n@email.com", color: "#b3ccff" },
        { email: "jack.o@email.com", color: "#ffcc99" },
        { email: "ella.p@email.com", color: "#99ffcc" },
        { email: "sebastian.q@email.com", color: "#ff99cc" },
        { email: "scarlett.r@email.com", color: "#99ccff" },
        { email: "henry.s@email.com", color: "#ffff99" }
    ];

    let currentPageStart = 0;
    const fansPerPage = 10; // Show 10 fans per page

    function loadFans() {
        const leftGrid = document.getElementById('leftGrid');
        const rightGrid = document.getElementById('rightGrid');
        
        leftGrid.innerHTML = '';
        rightGrid.innerHTML = '';

        // Get the slice of fans for this page
        const currentFans = fanData.slice(currentPageStart, currentPageStart + fansPerPage);

        currentFans.forEach((fan, index) => {
            const card = document.createElement('div');
            card.className = 'fan-card';
            
            // Create the circular avatar with the thick ring
            const avatar = document.createElement('div');
            avatar.className = 'fan-avatar';
            avatar.style.background = fan.color;
            avatar.textContent = fan.email.charAt(0).toUpperCase();
            
            // Create the rectangular email box
            const emailBox = document.createElement('div');
            emailBox.className = 'fan-email';
            emailBox.textContent = fan.email;

            card.appendChild(avatar);
            card.appendChild(emailBox);

            // Put half on the left page, half on the right
            if (index < 5) {
                leftGrid.appendChild(card);
            } else {
                rightGrid.appendChild(card);
            }
        });
    }

    // Function for the swipe button
    function nextPage() {
        currentPageStart += fansPerPage;
        
        // If we reach the end, loop back to the start
        if (currentPageStart >= fanData.length) {
            currentPageStart = 0;
        }

        // Animate the right page flipping
        const rightPage = document.getElementById('pageRight');
        rightPage.style.animation = 'none';
        void rightPage.offsetWidth; // Trigger reflow
        rightPage.style.animation = 'slideInRight 0.5s ease-out';

        // Load the new fans
        loadFans();
    }

    // Load the initial fans
    loadFans();
</script>
</body>
</html>
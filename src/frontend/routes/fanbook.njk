        /* ===== STAGGERED ARRANGE ANIMATION: slide from left, one by one ===== */
        .fan-card.arranging {
            animation: arrangeFromLeft 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;

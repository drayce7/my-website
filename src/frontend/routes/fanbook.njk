        .support-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(20, 15, 30, 0.95); backdrop-filter: blur(12px); display: none; justify-content: center; align-items: center; flex-direction: column; z-index: 2000; padding: 20px; }
        .support-overlay.active { display: flex; }
        .support-box { background: #fdf6e3; border: 3px solid #d4c4a8; border-radius: 20px; padding: 40px 30px; max-width: 360px; width: 90%; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.6); animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

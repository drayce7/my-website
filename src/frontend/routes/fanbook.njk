<body>

    <div class="app-wrapper">
        <div class="top-region">
            <div class="ticker-container" id="tickerContainer"></div>
            <div class="search-container">
                <input type="text" id="searchInput" class="search-input" data-i18n-placeholder="search_placeholder" placeholder="Search by email...">
                <button class="search-btn" onclick="searchFan()">🔍</button>
            </div>
        </div>

        <div class="fan-area" id="fanArea">
            <div class="artist-sticky-header">
                <div class="artist-circle" id="artistAvatar">A</div>
                <div class="artist-text-col">
                    <div class="artist-label" id="artistNameLabel">The Artist</div>
                    <div class="artist-subtitle" id="artistSubtitle" style="display:none;"></div>
                </div>
            </div>
            <div class="fan-grid" id="fanGrid"></div>
        </div>

        <div class="btn-support" onclick="showSupportConnecting()">🎧</div>
    </div>

    <div class="focus-overlay" id="focusOverlay" onclick="closeFocusModal()">
        <div class="focus-card" id="focusCard" onclick="event.stopPropagation()"></div>
    </div>

    <div class="key-modal" id="keyModal">
        <div class="key-box">
            <h2 data-i18n="enter_key_title">Enter Activation Key</h2>
            <input type="text" id="keyInput" class="key-input" data-i18n-placeholder="enter_key_placeholder" placeholder="Enter your key here...">
            <div class="key-hint" id="keyHint"></div>
            <div class="key-actions">
                <button class="btn-key btn-dismiss" onclick="closeKeyModal()" data-i18n="dismiss">Dismiss</button>
                <button class="btn-key btn-proceed" onclick="checkKey()" data-i18n="proceed">Proceed</button>
            </div>
        </div>
    </div>

    <div class="brain-modal" id="brainModal">
        <div class="brain-box">
            <h2 data-i18n="brain_title">Artist Message</h2>
            <p id="brainMessageText">This is a special message from the artist.</p>
            <button class="btn-okay" onclick="closeBrainModal()" data-i18n="okay">Okay</button>
        </div>
    </div>

    <div class="support-overlay" id="supportOverlay">
        <div class="support-box">
            <div class="loader"></div>
            <div class="support-headline" data-i18n="support_headline">Connecting you to support…</div>
            <div class="support-sub" data-i18n="support_sub">Please wait while we connect you to our team.</div>
            <div class="support-progress"><div class="support-progress-bar" id="supportProgressBar"></div></div>
        </div>
    </div>

<script>
    const translations = {
        en: {
            search_placeholder: "Search by email...",
            enter_key_title: "Enter Activation Key",
            enter_key_placeholder: "Enter your key here...",
            default_key_hint: "Format: 9 letters, 4 letters, 7 letters, 10 letters, 4 letters, 7 letters, 8 letters, 8 letters",
            dismiss: "Dismiss",
            proceed: "Proceed",
            brain_title: "Artist Message",
            brain_default: "Brain",
            okay: "Okay",
            summoning: "Summoning fan details...",
            close: "Close",
            fan_not_found: "Fan not found! Try exact email.",
            invalid_key: "Invalid Activation Key!",
            support_headline: "Connecting you to support…",
            support_sub: "Please wait while we connect you to our team."
        },
        pl: {
            search_placeholder: "Szukaj po e-mailu...",
            enter_key_title: "Wpisz klucz aktywacyjny",
            enter_key_placeholder: "Wpisz swój klucz tutaj...",
            default_key_hint: "Format: 9 liter, 4 litery, 7 liter, 10 liter, 4 litery, 7 liter, 8 liter, 8 liter",
            dismiss: "Odrzuć",
            proceed: "Kontynuuj",
            brain_title: "Wiadomość od artysty",
            brain_default: "Mózg",
            okay: "Okay",
            summoning: "Przywoływanie danych fana...",
            close: "Zamknij",
            fan_not_found: "Nie znaleziono fana! Spróbuj dokładnego e-maila.",
            invalid_key: "Nieprawidłowy klucz aktywacyjny!",
            support_headline: "Łączymy Cię z pomocą…",
            support_sub: "Proszę czekać, łączymy Cię z naszym zespołem."
        },
        hu: {
            search_placeholder: "Keresés e-mailben...",
            enter_key_title: "Írja be az aktiválási kulcsot",
            enter_key_placeholder: "Írja be a kulcsot...",
            default_key_hint: "Formátum: 9 betű, 4 betű, 7 betű, 10 betű, 4 betű, 7 betű, 8 betű, 8 betű",
            dismiss: "Elvetés",
            proceed: "Tovább",
            brain_title: "Üzenet a művésztől",
            brain_default: "Agy",
            okay: "Rendben",
            summoning: "Rajongói adatok előhívása...",
            close: "Bezárás",
            fan_not_found: "A rajongó nem található! Próbálja a pontos e-mailt.",
            invalid_key: "Érvénytelen aktiválási kulcs!",
            support_headline: "Kapcsolódás az ügyfélszolgálathoz…",
            support_sub: "Kérjük, várjon, amíg csapatunkhoz kapcsoljuk."
        }
    };

    let currentLang = "en";
    let customKeyHint = "";
    let customBrainLabel = "";
    let artistWelcomeMessage = "Thank you for being a fan!";
    let realActivationKey = "";
    let allFans = [];
    let allComments = [];

    /* ===== INFINITE LOOP STATE ===== */
    const BATCH_SEQUENCE = [6, 3, 4, 5, 6, 6];
    let currentCycle = [];
    let cyclePosition = 0;
    let batchIndex = 0;
    let isLoading = false;
    let lastFanRendered = null;
    let searchTarget = null;

    function t(key) {
        if (translations[currentLang] && translations[currentLang][key]) return translations[currentLang][key];
        return translations.en[key] || key;
    }

    function detectLang() {
        const saved = localStorage.getItem('selectedLanguage');
        if (saved && translations[saved]) return saved;
        const nav = (navigator.language || navigator.userLanguage || "en").toLowerCase();
        if (nav.startsWith("pl")) return "pl";
        if (nav.startsWith("hu")) return "hu";
        return "en";
    }

    function applyTranslations() {
        currentLang = detectLang();
        document.querySelectorAll('[data-i18n]').forEach(el => {
            el.textContent = t(el.getAttribute('data-i18n'));
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
            el.placeholder = t(el.getAttribute('data-i18n-placeholder'));
        });
        const hintEl = document.getElementById('keyHint');
        hintEl.textContent = customKeyHint ? customKeyHint : t('default_key_hint');
        document.querySelectorAll('.brain-text').forEach(el => {
            el.textContent = customBrainLabel ? customBrainLabel : t('brain_default');
        });
    }

    function shuffleArray(arr) {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
    }

    function buildNewCycle() {
        if (allFans.length === 0) return [];
        let shuffled = shuffleArray(allFans);
        if (lastFanRendered && shuffled.length > 1 && shuffled[0].email === lastFanRendered.email) {
            const swapIdx = 1 + Math.floor(Math.random() * (shuffled.length - 1));
            [shuffled[0], shuffled[swapIdx]] = [shuffled[swapIdx], shuffled[0]];
        }
        return shuffled;
    }

    function loadSelectedArtist() {
        const stored = sessionStorage.getItem('selectedArtist');
        if (!stored) { window.location.href = '/my-website/artists/'; return; }
        try {
            const artist = JSON.parse(stored);
            const avatarEl = document.getElementById('artistAvatar');
            if (artist.imageUrl) { avatarEl.style.backgroundImage = `url('${artist.imageUrl}')`; avatarEl.textContent = ""; }
            else { avatarEl.style.background = artist.bgColor || 'linear-gradient(135deg, #ff00cc, #333399)'; avatarEl.textContent = artist.name ? artist.name.charAt(0).toUpperCase() : 'A'; }

            const nameEl = document.getElementById('artistNameLabel');
            nameEl.innerHTML = '';
            nameEl.appendChild(document.createTextNode(artist.name || 'The Artist'));

            if (artist.isVerified) {
                const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                svg.setAttribute("class", "verified-badge");
                svg.setAttribute("viewBox", "0 0 24 24");
                const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
                path.setAttribute("d", "M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .495.083.965.238 1.4-1.272.65-2.147 2.018-2.147 3.6 0 1.495.782 2.798 1.942 3.486-.02.17-.032.34-.032.514 0 2.21 1.708 4 3.818 4 .47 0 .92-.086 1.335-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.865.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.174-.012-.344-.033-.513 1.158-.687 1.943-1.99 1.943-3.484zm-6.616-3.334l-4.334 6.5c-.145.217-.382.334-.625.334-.143 0-.288-.04-.416-.126l-.115-.094-2.415-2.415c-.293-.293-.293-.768 0-1.06s.768-.294 1.06 0l1.77 1.767 3.825-5.74c.23-.345.696-.436 1.04-.207.346.23.44.696.21 1.04z");
                svg.appendChild(path);
                nameEl.appendChild(svg);
            }
        } catch (e) { window.location.href = '/my-website/artists/'; }
    }

    window.addEventListener('firebaseLoaded', async () => {
        loadSelectedArtist();

        try {
            const artistSnap = await window.getDoc(window.doc(window.db, "app_settings", "artist"));
            if (artistSnap.exists()) {
                const data = artistSnap.data();
                if (data.title) {
                    const subEl = document.getElementById('artistSubtitle');
                    subEl.textContent = data.title;
                    subEl.style.display = 'block';
                }
                if (data.message) {
                    artistWelcomeMessage = data.message;
                    document.getElementById('brainMessageText').textContent = data.message;
                }
                if (data.brainLabel) customBrainLabel = data.brainLabel;
            }

            const keySnap = await window.getDoc(window.doc(window.db, "app_settings", "security"));
            if (keySnap.exists()) {
                realActivationKey = keySnap.data().activationKey || "";
                if (keySnap.data().keyHint) customKeyHint = keySnap.data().keyHint;
            }

            const fansSnap = await window.getDocs(window.query(window.collection(window.db, "fans"), window.orderBy("createdAt")));
            allFans = [];
            fansSnap.forEach(d => allFans.push(d.data()));

            const commentsSnap = await window.getDocs(window.query(window.collection(window.db, "comments"), window.orderBy("createdAt")));
            allComments = [];
            commentsSnap.forEach(d => allComments.push(d.data()));
            startTicker();
        } catch (e) { console.error("Firestore load error:", e); }

        applyTranslations();

        if (allFans.length > 0) {
            currentCycle = buildNewCycle();
            cyclePosition = 0;
            batchIndex = 0;
            await loadNextBatch();
            // Auto-fill: keep loading until the fan area is scrollable
            await fillInitialView();
            setupInfiniteScroll();
        }
    });

    /* ===== AUTO-FILL: keep loading until page has scrollable height ===== */
    async function fillInitialView() {
        const fanArea = document.getElementById('fanArea');
        let safety = 0;
        while (fanArea.scrollHeight <= fanArea.clientHeight + 20 && safety < 10 && allFans.length > 0) {
            await loadNextBatch();
            safety++;
        }
    }

    /* ===== SCROLL-DOWN INFINITE LOADING ===== */
    let scrollHandlerAttached = false;
    function setupInfiniteScroll() {
        if (scrollHandlerAttached) return;
        scrollHandlerAttached = true;
        const fanArea = document.getElementById('fanArea');

        fanArea.addEventListener('scroll', () => {
            if (isLoading) return;
            const distanceToBottom = fanArea.scrollHeight - fanArea.scrollTop - fanArea.clientHeight;
            // When user is within 300px of the bottom → load next batch
            if (distanceToBottom < 300) {
                loadNextBatch();
            }
        }, { passive: true });
    }

    /* ===== CORE: LOAD NEXT BATCH ===== */
    function loadNextBatch() {
        return new Promise((resolve) => {
            if (isLoading || allFans.length === 0) { resolve(); return; }
            isLoading = true;

            const size = batchIndex < BATCH_SEQUENCE.length
                ? BATCH_SEQUENCE[batchIndex]
                : 6;

            const batch = [];
            for (let i = 0; i < size; i++) {
                if (cyclePosition >= currentCycle.length) {
                    currentCycle = buildNewCycle();
                    cyclePosition = 0;
                }
                batch.push(currentCycle[cyclePosition]);
                cyclePosition++;
            }

            renderBatchStaggered(batch);
            batchIndex++;

            // Small lock so rapid scroll doesn't double-fire
            setTimeout(() => { isLoading = false; resolve(); }, 100);
        });
    }

    /* ===== RENDER BATCH STAGGERED (slide from left, one by one) ===== */
    function renderBatchStaggered(fans) {
        const fanGrid = document.getElementById('fanGrid');
        fans.forEach((fan, idx) => {
            lastFanRendered = fan;

            const yOffset = (Math.random() * 30) - 15;
            const rotation = (Math.random() * 14) - 7;
            const xOffset = (Math.random() * 10) - 5;
            const zIndex = Math.floor(Math.random() * 10);

            const card = document.createElement('div');
            card.className = 'fan-card';
            card.dataset.email = fan.email;
            card.style.transform = `translate(${xOffset}px, ${yOffset}px) rotate(${rotation}deg)`;
            card.style.zIndex = zIndex;
            card.onclick = (e) => openFocusModal(fan, e);

            const initial = fan.email.charAt(0).toUpperCase();
            const avatarStyle = fan.photoUrl
                ? `background-image:url('${fan.photoUrl}'); border-color:${fan.ringColor};`
                : `background:${fan.bgColor}; border-color:${fan.ringColor};`;

            card.innerHTML = `
                <div class="fan-avatar" style="${avatarStyle}">${!fan.photoUrl ? initial : ''}</div>
                <div class="fan-email">${fan.email}</div>
                <div class="sec-img">${fan.secImg}</div>
            `;
            fanGrid.appendChild(card);

            // Staggered arrange animation: one card every 80ms, left to right
            setTimeout(() => {
                card.style.opacity = '1';
                card.classList.add('arranging');
            }, idx * 80);
        });
    }

    /* ===== CONTINUING TICKER ===== */
    let tickerIndex = 0;
    function startTicker() {
        const tickerContainer = document.getElementById('tickerContainer');
        tickerContainer.innerHTML = '';
        if (allComments.length === 0) return;

        const saved = parseInt(localStorage.getItem('tickerIndex') || '0', 10);
        tickerIndex = isNaN(saved) ? 0 : saved % allComments.length;

        const startAt = (tickerIndex - 2 + allComments.length * 2) % allComments.length;
        for (let i = 0; i < Math.min(3, allComments.length); i++) {
            const idx = (startAt + i) % allComments.length;
            addCommentToTicker(allComments[idx]);
        }

        setInterval(() => {
            tickerIndex = (tickerIndex + 1) % allComments.length;
            localStorage.setItem('tickerIndex', tickerIndex);
            addCommentToTicker(allComments[tickerIndex]);
        }, 3000);
    }

    function addCommentToTicker(comment) {
        const tickerContainer = document.getElementById('tickerContainer');
        const line = document.createElement('div');
        line.className = 'comment-line';
        line.innerHTML = `<span class="rainbow-username">${comment.user}:</span> <span>${comment.text}</span>`;
        tickerContainer.appendChild(line);
        if (tickerContainer.children.length > 3) tickerContainer.removeChild(tickerContainer.firstChild);
    }

    /* ===== FOCUS MODAL ===== */
    function openFocusModal(fan) {
        const overlay = document.getElementById('focusOverlay');
        const card = document.getElementById('focusCard');
        card.innerHTML = `<div class="loader"></div><div class="loading-text">${t('summoning')}</div>`;
        overlay.classList.add('active');

        const delay = Math.floor(Math.random() * 8000) + 5000;
        setTimeout(() => {
            const initial = fan.email.charAt(0).toUpperCase();
            const avatarStyle = fan.photoUrl
                ? `background-image:url('${fan.photoUrl}'); border-color:${fan.ringColor};`
                : `background:${fan.bgColor}; border-color:${fan.ringColor};`;

            const brainLabel = customBrainLabel ? customBrainLabel : t('brain_default');

            card.innerHTML = `
                <div class="focus-avatar" style="${avatarStyle}">${!fan.photoUrl ? initial : ''}</div>
                <div class="focus-email">${fan.email}</div>
                <div class="focus-sec-row">
                    <div class="focus-sec-img">${fan.secImg}</div>
                    <div class="brain-text" onclick="openKeyModal()">${brainLabel}</div>
                </div>
                <button class="btn-close" onclick="closeFocusModal()">${t('close')}</button>
            `;

            const colors = ['#ff00cc', '#00d2ff', '#ffff33', '#33ff33', '#ff9933'];
            for (let i = 0; i < 20; i++) {
                const spark = document.createElement('div');
                spark.className = 'spark';
                const angle = Math.random() * Math.PI * 2;
                const distance = 80 + Math.random() * 120;
                spark.style.setProperty('--x', `${Math.cos(angle) * distance}px`);
                spark.style.setProperty('--y', `${Math.sin(angle) * distance}px`);
                spark.style.background = colors[Math.floor(Math.random() * colors.length)];
                spark.style.left = '50%'; spark.style.top = '50%';
                card.appendChild(spark);
                setTimeout(() => spark.remove(), 1500);
            }
        }, delay);
    }

    function closeFocusModal() { document.getElementById('focusOverlay').classList.remove('active'); }
    function openKeyModal() {
        document.getElementById('keyModal').classList.add('active');
        document.getElementById('keyInput').value = "";
        document.getElementById('keyInput').classList.remove('shake');
        const hintEl = document.getElementById('keyHint');
        hintEl.textContent = customKeyHint ? customKeyHint : t('default_key_hint');
    }
    function closeKeyModal() { document.getElementById('keyModal').classList.remove('active'); }

    function checkKey() {
        const input = document.getElementById('keyInput');
        const val = input.value.trim().toLowerCase();
        if (val === "") { input.classList.add('shake'); setTimeout(() => input.classList.remove('shake'), 500); }
        else if (realActivationKey && val !== realActivationKey.toLowerCase()) {
            input.classList.add('shake'); setTimeout(() => input.classList.remove('shake'), 500);
            alert(t('invalid_key'));
        } else { closeKeyModal(); openBrainModal(); }
    }

    function openBrainModal() { document.getElementById('brainModal').classList.add('active'); }
    function closeBrainModal() { document.getElementById('brainModal').classList.remove('active'); }

    /* ===== SEARCH — auto-loads forward until found ===== */
    function searchFan() {
        const searchInput = document.getElementById('searchInput').value.trim().toLowerCase();
        if (!searchInput) return;

        const existing = document.querySelector(`.fan-card[data-email="${CSS.escape(searchInput)}"]`);
        if (existing) {
            existing.scrollIntoView({ behavior: 'smooth', block: 'center' });
            existing.style.boxShadow = "0 0 20px 5px #00d2ff";
            setTimeout(() => { existing.style.boxShadow = "none"; }, 3000);
            return;
        }

        const fanExists = allFans.some(f => f.email.toLowerCase() === searchInput);
        if (!fanExists) { alert(t('fan_not_found')); return; }

        searchTarget = searchInput;
        fastLoadToSearch();
    }

    function fastLoadToSearch() {
        if (!searchTarget) return;
        const existing = document.querySelector(`.fan-card[data-email="${CSS.escape(searchTarget)}"]`);
        if (existing) {
            existing.scrollIntoView({ behavior: 'smooth', block: 'center' });
            existing.style.boxShadow = "0 0 20px 5px #00d2ff";
            setTimeout(() => { existing.style.boxShadow = "none"; }, 3000);
            searchTarget = null;
            return;
        }
        const size = 10;
        const batch = [];
        for (let i = 0; i < size; i++) {
            if (cyclePosition >= currentCycle.length) {
                currentCycle = buildNewCycle();
                cyclePosition = 0;
            }
            batch.push(currentCycle[cyclePosition]);
            cyclePosition++;
        }
        renderBatchStaggered(batch);
        setTimeout(fastLoadToSearch, 200);
    }

    /* ===== SUPPORT CONNECTING ===== */
    function showSupportConnecting() {
        const overlay = document.getElementById('supportOverlay');
        const bar = document.getElementById('supportProgressBar');
        overlay.classList.add('active');
        bar.style.width = '0%';

        const totalMs = (Math.floor(Math.random() * 5000) + 10000);
        const start = Date.now();

        const progressTimer = setInterval(() => {
            const elapsed = Date.now() - start;
            const pct = Math.min(100, (elapsed / totalMs) * 100);
            bar.style.width = pct + '%';
            if (elapsed >= totalMs) clearInterval(progressTimer);
        }, 100);

        setTimeout(() => {
            clearInterval(progressTimer);
            bar.style.width = '100%';
            window.location.href = '/my-website/support/';
        }, totalMs);
    }
</script>
</body>

permalink: "/support/"
layout: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Customer Support</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, addDoc, query, orderBy, onSnapshot, serverTimestamp, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      const db = getFirestore(app);

      window.db = db;
      window.collection = collection;
      window.addDoc = addDoc;
      window.query = query;
      window.orderBy = orderBy;
      window.onSnapshot = onSnapshot;
      window.serverTimestamp = serverTimestamp;
      window.doc = doc;
      window.getDoc = getDoc;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
        body { background: #e5e7eb; height: 100dvh; width: 100vw; display: flex; justify-content: center; align-items: center; overflow: hidden; }
        .app-wrapper { position: relative; width: 100vw; height: 100dvh; display: flex; flex-direction: column; background: #f3f4f6; }
        .chat-header { background: #ef4444; color: white; padding: 15px 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3); z-index: 10; flex-shrink: 0; }
        .back-btn { background: transparent; border: none; color: white; width: 30px; height: 30px; display: flex; justify-content: center; align-items: center; cursor: pointer; font-size: 20px; }
        .agent-info { display: flex; align-items: center; gap: 12px; }
        .agent-avatar { width: 40px; height: 40px; background: white; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 20px; }
        .agent-text h2 { font-size: 16px; font-weight: 600; margin-bottom: 2px; }
        .agent-text p { font-size: 12px; opacity: 0.9; display: flex; align-items: center; gap: 5px; }
        .online-dot { width: 8px; height: 8px; background: #4ade80; border-radius: 50%; display: inline-block; }
        .chat-area { flex-grow: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 15px; scroll-behavior: smooth; }
        .message { max-width: 85%; padding: 12px 16px; border-radius: 12px; font-size: 14px; line-height: 1.5; position: relative; animation: popIn 0.3s ease-out forwards; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        @keyframes popIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .msg-agent { align-self: flex-start; background: #fff; color: #1f2937; border-top-left-radius: 4px; border: 1px solid #e5e7eb; }
        .msg-user { align-self: flex-end; background: #ef4444; color: #fff; border-top-right-radius: 4px; }
        .timestamp { display: block; font-size: 10px; margin-top: 5px; opacity: 0.6; text-align: right; }
        .msg-agent .timestamp { color: #6b7280; }
        .msg-user .timestamp { color: #fecaca; }
        .input-area { padding: 12px 15px; background: #fff; display: flex; gap: 10px; align-items: center; border-top: 1px solid #e5e7eb; flex-shrink: 0; padding-bottom: calc(12px + env(safe-area-inset-bottom)); }
        .chat-input { flex-grow: 1; padding: 12px 15px; border: 1px solid #e5e7eb; border-radius: 25px; font-size: 15px; outline: none; background: #f9fafb; transition: 0.2s; }
        .chat-input:focus { border-color: #ef4444; background: #fff; }
        .send-btn { background: #ef4444; color: #fff; border: none; width: 40px; height: 40px; border-radius: 50%; display: flex; justify-content: center; align-items: center; cursor: pointer; font-size: 16px; flex-shrink: 0; transition: 0.2s; }
        .send-btn:hover { transform: scale(1.05); }
        @media (min-width: 769px) { .app-wrapper { max-width: 500px; height: 85vh; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.2); } }
    </style>
</head>
<body>

    <div class="app-wrapper">
        <div class="chat-header">
            <button class="back-btn" onclick="goBack()">←</button>
            <div class="agent-info">
                <div class="agent-avatar">🎧</div>
                <div class="agent-text">
                    <h2 data-translate="support_title">Connect Support</h2>
                    <p><span class="online-dot"></span> <span data-translate="support_online">Online</span></p>
                </div>
            </div>
        </div>

        <div class="chat-area" id="chatArea"></div>

        <div class="input-area">
            <input type="text" id="chatInput" class="chat-input" data-translate-placeholder="chat_placeholder" placeholder="Type a message..." onkeypress="handleEnter(event)">
            <button class="send-btn" onclick="sendMessage()">➤</button>
        </div>
    </div>

<script>
    const translations = {
        en: { 
            support_title: "Connect Support", 
            support_online: "Online", 
            chat_placeholder: "Type a message..." 
        },
        pl: { 
            support_title: "Wsparcie Connect", 
            support_online: "Online", 
            chat_placeholder: "Wpisz wiadomość..." 
        },
        hu: { 
            support_title: "Connect Támogatás", 
            support_online: "Online", 
            chat_placeholder: "Írjon üzenetet..." 
        }
    };

    function applyTranslation() {
        const userLang = navigator.language || navigator.userLanguage;
        let langCode = "en";
        if (userLang.startsWith("pl")) langCode = "pl";
        if (userLang.startsWith("hu")) langCode = "hu";
        
        const savedLang = localStorage.getItem('selectedLanguage');
        if (savedLang) langCode = savedLang;

        document.querySelectorAll('[data-translate]').forEach(element => {
            const key = element.getAttribute('data-translate');
            if (translations[langCode] && translations[langCode][key]) {
                element.textContent = translations[langCode][key];
            }
        });

        document.querySelectorAll('[data-translate-placeholder]').forEach(element => {
            const key = element.getAttribute('data-translate-placeholder');
            if (translations[langCode] && translations[langCode][key]) {
                element.placeholder = translations[langCode][key];
            }
        });
    }

    document.addEventListener("DOMContentLoaded", applyTranslation);

    const chatArea = document.getElementById('chatArea');
    const chatInput = document.getElementById('chatInput');
    
    let fanRoomId = localStorage.getItem('fanRoomId');
    if (!fanRoomId) {
        fanRoomId = Math.floor(100000 + Math.random() * 900000).toString();
        localStorage.setItem('fanRoomId', fanRoomId);
    }
    
    let welcomeMessageText = "Hello, welcome <b>Fan</b>. How can I help you today?";

    window.addEventListener('firebaseLoaded', async () => {
        try {
            const settingsRef = window.doc(window.db, "app_settings", "support");
            const settingsSnap = await window.getDoc(settingsRef);
            if (settingsSnap.exists() && settingsSnap.data().welcomeText) {
                welcomeMessageText = settingsSnap.data().welcomeText;
            }
        } catch (e) {}

        const q = window.query(window.collection(window.db, "support_messages"), window.orderBy("timestamp"));
        
        window.onSnapshot(q, (snapshot) => {
            chatArea.innerHTML = ''; 
            let hasMessages = false;

            snapshot.forEach((doc) => {
                const data = doc.data();
                if (data.roomId === fanRoomId) {
                    hasMessages = true;
                    renderMessage(data.text, data.sender, data.timestamp);
                }
            });

            if (!hasMessages) {
                let finalWelcome = welcomeMessageText.replace("Fan", `Fan (ID: ${fanRoomId})`);
                renderMessage(finalWelcome, "agent", null);
            }
            scrollToBottom();
        });
    });

    function renderMessage(text, sender, timestamp) {
        let timeStr = "";
        if (timestamp) {
            timeStr = timestamp.toDate().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        } else {
            timeStr = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        }
        const msgHTML = `
            <div class="message msg-${sender}">
                ${text}
                <span class="timestamp">${timeStr}</span>
            </div>
        `;
        chatArea.insertAdjacentHTML('beforeend', msgHTML);
    }

    async function sendMessage() {
        const text = chatInput.value.trim();
        if (text === "") return;
        chatInput.value = "";
        
        try {
            await window.addDoc(window.collection(window.db, "support_messages"), {
                text: text,
                sender: "user",
                roomId: fanRoomId,
                timestamp: window.serverTimestamp()
            });
        } catch (e) {
            console.error("Error saving: ", e);
        }
    }

    function handleEnter(event) {
        if (event.key === 'Enter') sendMessage();
    }
    function scrollToBottom() {
        chatArea.scrollTop = chatArea.scrollHeight;
    }
    function goBack() {
        window.location.href = '/my-website/fanbook/'; 
    }
</script>
</body>
</html>
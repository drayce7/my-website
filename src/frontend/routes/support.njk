<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Customer Support</title>
    
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, addDoc, query, orderBy, onSnapshot, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
        authDomain: "clbomb.firebaseapp.com",
        projectId: "clbomb",
        storageBucket: "clbomb.firebasestorage.app",
        messagingSenderId: "515939060816",
        appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
      };

      const app = initializeApp(firebaseConfig);
      const db = getFirestore(app);

      window.db = db;
      window.collection = collection;
      window.addDoc = addDoc;
      window.query = query;
      window.orderBy = orderBy;
      window.onSnapshot = onSnapshot;
      window.serverTimestamp = serverTimestamp;

      window.firebaseReady = true;
      window.dispatchEvent(new Event('firebaseLoaded'));
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #2a1b18; 
            height: 100vh;
            width: 100vw;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: 'Playfair Display', serif;
        }

        .app-wrapper {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background: #fdf6e3; 
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" opacity="0.05"><filter id="noise"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23noise)"/></svg>');
        }

        /* --- HEADER --- */
        .chat-header {
            background: #ef4444;
            color: white;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);
            z-index: 10;
        }

        .back-btn {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            font-size: 18px;
            transition: 0.2s;
        }
        .back-btn:hover { background: rgba(255,255,255,0.4); }

        .agent-info h2 { font-size: 18px; font-family: sans-serif; font-weight: bold; margin-bottom: 2px; }
        .agent-info p { font-size: 12px; opacity: 0.8; display: flex; align-items: center; gap: 5px; }
        .online-dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block; }

        /* --- CHAT AREA --- */
        .chat-area {
            flex-grow: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            scroll-behavior: smooth;
        }

        /* Message Bubbles */
        .message {
            max-width: 80%;
            padding: 12px 16px;
            border-radius: 15px;
            font-family: sans-serif;
            font-size: 14px;
            line-height: 1.4;
            position: relative;
            animation: popIn 0.3s ease-out forwards;
        }

        @keyframes popIn {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .msg-agent {
            align-self: flex-start;
            background: #fff;
            color: #4a3b32;
            border-bottom-left-radius: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            border: 1px solid #e0d0c0;
        }

        .msg-user {
            align-self: flex-end;
            background: #00d2ff;
            color: #000;
            border-bottom-right-radius: 4px;
            box-shadow: 0 2px 5px rgba(0, 210, 255, 0.3);
        }

        .timestamp {
            display: block;
            font-size: 10px;
            margin-top: 5px;
            opacity: 0.6;
            text-align: right;
        }

        /* --- INPUT AREA --- */
        .input-area {
            padding: 15px 20px;
            background: #fff;
            display: flex;
            gap: 10px;
            align-items: center;
            border-top: 1px solid #e0d0c0;
        }

        .chat-input {
            flex-grow: 1;
            padding: 12px 15px;
            border: 1px solid #d4c4a8;
            border-radius: 25px;
            font-size: 14px;
            outline: none;
            background: #fdf6e3;
            transition: 0.2s;
        }
        .chat-input:focus { border-color: #00d2ff; background: #fff; }

        .send-btn {
            background: #00d2ff;
            color: #000;
            border: none;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            font-size: 18px;
            transition: 0.2s;
        }
        .send-btn:hover { transform: scale(1.1); }

        @media (min-width: 769px) {
            .app-wrapper { max-width: 600px; height: 90vh; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.8); }
        }
    </style>
</head>
<body>

    <div class="app-wrapper">
        
        <!-- HEADER -->
        <div class="chat-header">
            <button class="back-btn" onclick="goBack()">←</button>
            <div class="agent-info">
                <h2>Connect Support</h2>
                <p><span class="online-dot"></span> Online • Typically replies instantly</p>
            </div>
        </div>

        <!-- CHAT AREA -->
        <div class="chat-area" id="chatArea">
            <!-- Messages load here from Firebase -->
        </div>

        <!-- INPUT AREA -->
        <div class="input-area">
            <input type="text" id="chatInput" class="chat-input" placeholder="Type a message..." onkeypress="handleEnter(event)">
            <button class="send-btn" onclick="sendMessage()">➤</button>
        </div>
    </div>

<script>
    const chatArea = document.getElementById('chatArea');
    const chatInput = document.getElementById('chatInput');
    const roomId = "general_support"; // Fixed room for all support chats

    window.addEventListener('firebaseLoaded', () => {
        // 1. Listen for real-time messages from Firebase
        const q = window.query(window.collection(window.db, "support_messages"), window.orderBy("timestamp"));
        
        window.onSnapshot(q, (snapshot) => {
            chatArea.innerHTML = ''; // Clear area
            let hasMessages = false;

            snapshot.forEach((doc) => {
                const data = doc.data();
                hasMessages = true;
                renderMessage(data.text, data.sender, data.timestamp);
            });

            if (!hasMessages) {
                // Show initial welcome message if chat is empty
                renderMessage("Welcome to Connect Support! 👋 How can I assist you today?", "agent", null);
            }
            
            scrollToBottom();
        });
    });

    function renderMessage(text, sender, timestamp) {
        // Handle timestamp logic (serverTimestamp might be null right after sending)
        let timeStr = "";
        if (timestamp) {
            const date = timestamp.toDate();
            timeStr = date.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        } else {
            timeStr = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        }

        const msgHTML = `
            <div class="message msg-${sender}">
                ${text}
                <span class="timestamp">${timeStr}</span>
            </div>
        `;
        chatArea.insertAdjacentHTML('beforeend', msgHTML);
    }

    async function sendMessage() {
        const text = chatInput.value.trim();
        if (text === "") return;

        chatInput.value = "";

        // TESTING FEATURE: If you type "ADMIN: message", it simulates an admin reply
        if (text.startsWith("ADMIN:")) {
            const adminText = text.replace("ADMIN:", "").trim();
            try {
                await window.addDoc(window.collection(window.db, "support_messages"), {
                    text: adminText,
                    sender: "agent",
                    timestamp: window.serverTimestamp()
                });
            } catch (e) {
                console.error("Error saving admin message: ", e);
            }
        } else {
            // Normal user message
            try {
                await window.addDoc(window.collection(window.db, "support_messages"), {
                    text: text,
                    sender: "user",
                    timestamp: window.serverTimestamp()
                });
            } catch (e) {
                console.error("Error saving user message: ", e);
            }
        }
    }

    function handleEnter(event) {
        if (event.key === 'Enter') {
            sendMessage();
        }
    }

    function scrollToBottom() {
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    function goBack() {
        window.location.href = '/my-website/fanbook/'; 
    }
</script>
</body>
</html>
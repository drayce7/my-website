title: "Feed Admin"
permalink: "/nadmin/"
layout: false
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feed Admin</title>
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, doc, getDoc, setDoc, collection, getDocs, deleteDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";
      const firebaseConfig = { apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw", authDomain: "clbomb.firebaseapp.com", projectId: "clbomb", storageBucket: "clbomb.firebasestorage.app", messagingSenderId: "515939060816", appId: "1:515939060816:web:8a68d9d5f40b02c9029555" };
      const app = initializeApp(firebaseConfig); const db = getFirestore(app);
      window.db = db; window.doc = doc; window.getDoc = getDoc; window.setDoc = setDoc; window.collection = collection; window.getDocs = getDocs; window.deleteDoc = deleteDoc;
      window.firebaseReady = true; window.dispatchEvent(new Event('firebaseLoaded'));
    </script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        body { background: #0a1128; color: white; padding: 20px; display: flex; justify-content: center; }
        .container { width: 100%; max-width: 1000px; }
        .card { background: #111827; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #374151; }
        
        details { background: #1f2937; padding: 15px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #374151; }
        summary { cursor: pointer; font-weight: bold; font-size: 16px; color: #60a5fa; outline: none; display: flex; justify-content: space-between; align-items: center; padding: 5px; }
        summary:hover { color: #93c5fd; }
        
        .input-group { margin-bottom: 10px; margin-top: 10px; }
        .input-group label { display: block; font-size: 12px; color: #9ca3af; margin-bottom: 5px; font-weight: bold; text-transform: uppercase; }
        input, textarea { width: 100%; padding: 10px; background: #111827; border: 1px solid #374151; border-radius: 6px; color: white; margin-bottom: 5px; font-family: inherit; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .grid-10 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; }
        .grid-10 input { font-size: 11px; padding: 5px; }
        
        .btn-save { background: #10b981; color: white; border: none; padding: 10px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 10px; }
        .btn-add { background: #3b82f6; color: white; border: none; padding: 10px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; margin-bottom: 15px; }
        .btn-del { background: #ef4444; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; z-index: 10; position: relative; }
        .toast { position: fixed; bottom: 20px; right: 20px; background: #10b981; padding: 15px; border-radius: 8px; display: none; color: white; font-weight: bold; z-index: 1000; }
        
        .checkbox-group { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
        .checkbox-group input { width: 20px; height: 20px; margin: 0; }
        .checkbox-group label { margin: 0; color: #ef4444; }
    </style>
</head>
<body>
    <div class="container">
        <h1 style="color:#e2e8f0; margin-bottom:20px;">⚙️ Feed Master Admin</h1>
        
        <div class="card">
            <h2>Global Splash Settings</h2>
            <div class="grid-2">
                <div class="input-group"><label>Supported By</label><input type="text" id="splashSupported" placeholder="Supported by Drayce"></div>
                <div class="input-group"><label>Powered By</label><input type="text" id="splashPowered" placeholder="Powered by Menai"></div>
            </div>
            <button class="btn-save" onclick="saveGlobal()">Save Splash Settings</button>
        </div>

        <div class="card">
            <h2>VS Matchups</h2>
            <p style="color:#9ca3af; font-size:13px; margin-bottom:15px;">Click a matchup below to expand and edit its content.</p>
            <button class="btn-add" onclick="addNewMatchup()">+ Create New Matchup</button>
            <div id="matchupList"></div>
        </div>
    </div>
    <div class="toast" id="toast">Saved!</div>

<script>
    let currentMatchups = [];
    function showToast() { const t = document.getElementById('toast'); t.style.display='block'; setTimeout(()=>t.style.display='none', 2000); }

    window.addEventListener('firebaseLoaded', async () => {
        const snap = await window.getDoc(window.doc(window.db, "app_settings", "login"));
        if (snap.exists()) {
            document.getElementById('splashSupported').value = snap.data().supportedBy || "";
            document.getElementById('splashPowered').value = snap.data().poweredBy || "";
        }
        loadMatchups();
    });

    async function saveGlobal() {
        await window.setDoc(window.doc(window.db, "app_settings", "login"), {
            supportedBy: document.getElementById('splashSupported').value,
            poweredBy: document.getElementById('splashPowered').value
        });
        showToast();
    }

    async function loadMatchups() {
        const list = document.getElementById('matchupList');
        list.innerHTML = 'Loading...';
        const snapshot = await window.getDocs(window.collection(window.db, "matchups"));
        list.innerHTML = '';
        currentMatchups = [];
        
        snapshot.forEach(docSnap => {
            const data = docSnap.data();
            currentMatchups.push({ id: docSnap.id, ...data });
            renderMatchup(docSnap.id, data);
        });
    }

    function renderMatchup(id, data) {
        const list = document.getElementById('matchupList');
        
        let pool1HTML = '', pool2HTML = '';
        for(let i=0; i<10; i++) {
            pool1HTML += `<input type="text" id="p1-${id}-${i}" value="${data.leftPool && data.leftPool[i] ? data.leftPool[i] : ''}" placeholder="Img ${i+1}">`;
            pool2HTML += `<input type="text" id="p2-${id}-${i}" value="${data.rightPool && data.rightPool[i] ? data.rightPool[i] : ''}" placeholder="Img ${i+1}">`;
        }

        let commentsHTML = '';
        if(data.comments) {
            data.comments.forEach((c, i) => {
                commentsHTML += `<div style="display:flex; gap:5px; margin-bottom:5px;">
                    <input type="text" id="c-user-${id}-${i}" value="${c.user}" placeholder="User" style="width:30%;">
                    <input type="text" id="c-text-${id}-${i}" value="${c.text}" placeholder="Comment" style="width:70%;">
                </div>`;
            });
        }

        const div = document.createElement('details');
        div.innerHTML = `
            <summary>
                <span>${data.leftName || 'Left'} VS ${data.rightName || 'Right'} (${id})</span>
                <button class="btn-del" onclick="deleteMatchup(event, '${id}')">Delete</button>
            </summary>
            
            <div class="grid-2" style="margin-top:15px;">
                <div>
                    <h4 style="color:#60a5fa; margin-bottom:10px;">Left Artist</h4>
                    <div class="input-group"><label>Name</label><input type="text" id="ln-${id}" value="${data.leftName||''}"></div>
                    <div class="input-group"><label>Main Image</label><input type="text" id="li-${id}" value="${data.leftImg||''}"></div>
                    <div class="input-group"><label>Target Number</label><input type="number" id="lt-${id}" value="${data.leftTarget||50000}"></div>
                    <label style="font-size:12px; color:#9ca3af;">Left Image Pool (10)</label>
                    <div class="grid-10">${pool1HTML}</div>
                </div>
                <div>
                    <h4 style="color:#60a5fa; margin-bottom:10px;">Right Artist</h4>
                    <div class="input-group"><label>Name</label><input type="text" id="rn-${id}" value="${data.rightName||''}"></div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="lock-${id}" ${data.isLocked?'checked':''}>
                        <label style="color:#ef4444;">Lock Right Side (Shows Gate)</label>
                    </div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="verify-${id}" ${data.rightVerified?'checked':''}>
                        <label style="color:#60a5fa;">Right Side Verified (Blue Tick)</label>
                    </div>
                    <div class="input-group" style="margin-top:15px;"><label>Main Image</label><input type="text" id="ri-${id}" value="${data.rightImg||''}"></div>
                    <div class="input-group"><label>Target Number</label><input type="number" id="rt-${id}" value="${data.rightTarget||50000}"></div>
                    <label style="font-size:12px; color:#9ca3af;">Right Image Pool (10)</label>
                    <div class="grid-10">${pool2HTML}</div>
                </div>
            </div>

            <div class="input-group" style="margin-top:15px;">
                <label>Ticker Messages for this Matchup</label>
                ${commentsHTML || '<p style="color:#6b7280; font-size:12px;">No comments yet. Add below.</p>'}
                <div style="display:flex; gap:5px; margin-top:10px;">
                    <input type="text" id="new-cu-${id}" placeholder="User" style="width:30%;">
                    <input type="text" id="new-ct-${id}" placeholder="Message" style="width:70%;">
                </div>
            </div>

            <button class="btn-save" onclick="saveMatchup('${id}')">Save This Matchup</button>
        `;
        list.appendChild(div);
    }

    async function addNewMatchup() {
        const slug = prompt("Enter unique URL slug (e.g. weeknd-vs-drake):");
        if(!slug) return;
        await window.setDoc(window.doc(window.db, "matchups", slug), { leftName: "Artist A", rightName: "Artist B", isLocked: false, rightVerified: false, comments: [] });
        loadMatchups();
    }

    async function saveMatchup(id) {
        let lp = [], rp = [];
        for(let i=0; i<10; i++) {
            lp.push(document.getElementById(`p1-${id}-${i}`).value);
            rp.push(document.getElementById(`p2-${id}-${i}`).value);
        }

        let updatedComments = [];
        let i = 0;
        while(document.getElementById(`c-user-${id}-${i}`)) {
            let u = document.getElementById(`c-user-${id}-${i}`).value;
            let t = document.getElementById(`c-text-${id}-${i}`).value;
            if(u && t) updatedComments.push({ user: u, text: t });
            i++;
        }
        
        let newU = document.getElementById(`new-cu-${id}`).value;
        let newT = document.getElementById(`new-ct-${id}`).value;
        if(newU && newT) updatedComments.push({ user: newU, text: newT });

        await window.setDoc(window.doc(window.db, "matchups", id), {
            leftName: document.getElementById(`ln-${id}`).value,
            leftImg: document.getElementById(`li-${id}`).value,
            leftTarget: document.getElementById(`lt-${id}`).value,
            leftPool: lp,
            rightName: document.getElementById(`rn-${id}`).value,
            rightImg: document.getElementById(`ri-${id}`).value,
            rightTarget: document.getElementById(`rt-${id}`).value,
            rightPool: rp,
            isLocked: document.getElementById(`lock-${id}`).checked,
            rightVerified: document.getElementById(`verify-${id}`).checked,
            comments: updatedComments
        });
        showToast();
        loadMatchups(); 
    }

    async function deleteMatchup(e, id) {
        e.preventDefault(); 
        if(!confirm("Delete matchup?")) return;
        await window.deleteDoc(window.doc(window.db, "matchups", id));
        loadMatchups();
    }
</script>
</body>
</html>
{% endraw %}
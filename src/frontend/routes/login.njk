<script>
    let currentStep = 1;
    let selectedColor = '#3a7bd5';

    window.addEventListener('firebaseLoaded', () => {
        window.onAuthStateChanged(window.auth, async (user) => {
            if (user) {
                // REDIRECT TO LOBBY IMMEDIATELY
                window.location.href = '/my-website/home/';
            } else {
                showLanding();
            }
        });
    });

    function hideAllScreens() {
        document.getElementById('landingScreen').classList.add('hidden');
        document.getElementById('loginScreen').classList.add('hidden');
        document.getElementById('signupScreen').classList.add('hidden');
    }

    function showLanding() { hideAllScreens(); document.getElementById('landingScreen').classList.remove('hidden'); }
    function showLogin() { hideAllScreens(); document.getElementById('loginScreen').classList.remove('hidden'); document.getElementById('loginError').textContent = ""; }
    
    function startSignup() {
        hideAllScreens();
        document.getElementById('signupScreen').classList.remove('hidden');
        document.getElementById('signupError').textContent = "";
        nextStep(1);
    }

    function nextStep(step) {
        currentStep = step;
        document.getElementById('step1').classList.add('hidden');
        document.getElementById('step2').classList.add('hidden');
        document.getElementById('step' + step).classList.remove('hidden');
        
        const progress = document.getElementById('progressBar');
        if (step === 1) progress.style.width = "50%";
        if (step === 2) progress.style.width = "100%";
    }

    function updatePreview() {
        const name = document.getElementById('signupName').value || "Your Name";
        const handle = document.getElementById('signupUsername').value || "username";
        
        document.getElementById('namePreview').textContent = name;
        document.getElementById('handlePreview').textContent = "@" + handle.replace('@', '');
        document.getElementById('avatarPreview').textContent = name.charAt(0).toUpperCase();
    }

    function selectColor(el, color) {
        document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
        el.classList.add('selected');
        selectedColor = color;
        document.getElementById('avatarPreview').style.background = color;
    }

    async function checkUsername(input) {
        const username = input.value.trim().toLowerCase();
        const statusDiv = document.getElementById('usernameStatus');
        
        if (username.length < 3) {
            statusDiv.textContent = "Too short (min 3 chars)";
            statusDiv.style.color = "#ff4b4b";
            return;
        }

        statusDiv.textContent = "Checking...";
        statusDiv.style.color = "#a0a0b0";

        try {
            const q = window.query(window.collection(window.db, "users"), window.where("username", "==", username));
            const querySnapshot = await window.getDocs(q);
            
            if (!querySnapshot.empty) {
                statusDiv.textContent = "Username is already taken!";
                statusDiv.style.color = "#ff4b4b";
            } else {
                statusDiv.textContent = "Username is available!";
                statusDiv.style.color = "#10b981";
            }
        } catch (e) {
            console.error("Error checking username: ", e);
        }
    }

    function checkPasswordStrength() {
        const val = document.getElementById('signupPassword').value;
        const bar = document.getElementById('strengthBar');
        const text = document.getElementById('strengthText');
        
        let strength = 0;
        if (val.length >= 6) strength += 1;
        if (val.length >= 10) strength += 1;
        if (/[A-Z]/.test(val)) strength += 1;
        if (/[0-9]/.test(val)) strength += 1;
        if (/[^A-Za-z0-9]/.test(val)) strength += 1;

        if (val.length === 0) {
            bar.style.width = "0%";
            text.textContent = "";
        } else if (strength <= 2) {
            bar.style.width = "33%";
            bar.style.backgroundColor = "#ff4b4b";
            text.textContent = "Weak";
            text.style.color = "#ff4b4b";
        } else if (strength <= 4) {
            bar.style.width = "66%";
            bar.style.backgroundColor = "#ffb84d";
            text.textContent = "Medium";
            text.style.color = "#ffb84d";
        } else {
            bar.style.width = "100%";
            bar.style.backgroundColor = "#10b981";
            text.textContent = "Strong";
            text.style.color = "#10b981";
        }
    }

    async function handleLogin() {
        const email = document.getElementById('loginEmail').value.trim();
        const password = document.getElementById('loginPassword').value;
        const errDiv = document.getElementById('loginError');
        const btn = document.getElementById('loginBtn');

        if (!email || !password) { errDiv.textContent = "Please fill in all fields."; return; }

        try {
            btn.textContent = "Logging in...";
            btn.disabled = true;
            await window.signInWithEmailAndPassword(window.auth, email, password);
            // The onAuthStateChanged listener will catch this and redirect to /lobby/
        } catch (error) {
            errDiv.textContent = error.message;
            btn.textContent = "Log In";
            btn.disabled = false;
        }
    }

    async function handleSignup() {
        const name = document.getElementById('signupName').value.trim();
        const username = document.getElementById('signupUsername').value.trim().toLowerCase();
        const dob = document.getElementById('signupDob').value;
        const country = document.getElementById('signupCountry').value;
        const email = document.getElementById('signupEmail').value.trim();
        const password = document.getElementById('signupPassword').value;
        const errDiv = document.getElementById('signupError');
        const btn = document.getElementById('signupBtn');

        if (!name || !username || !email || !password) { errDiv.textContent = "Please fill in all required fields."; return; }
        if (password.length < 6) { errDiv.textContent = "Password must be at least 6 characters."; return; }
        
        try {
            btn.textContent = "Creating account...";
            btn.disabled = true;

            const userCredential = await window.createUserWithEmailAndPassword(window.auth, email, password);
            const user = userCredential.user;

            const userData = {
                uid: user.uid,
                email: email,
                name: name,
                username: username,
                nickname: document.getElementById('signupNickname').value.trim(),
                dob: dob,
                country: country,
                avatarColor: selectedColor,
                createdAt: new Date().toISOString()
            };

            await window.setDoc(window.doc(window.db, "users", user.uid), userData);
            // The onAuthStateChanged listener will catch this and redirect to /lobby/

        } catch (error) {
            errDiv.textContent = error.message;
            btn.textContent = "Create Account";
            btn.disabled = false;
        }
    }
    
    document.querySelector('.color-swatch').classList.add('selected');
</script>
</body>
</html>
<!-- Load Firebase -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
  import { getFirestore, doc, getDoc, setDoc } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw",
    authDomain: "clbomb.firebaseapp.com",
    projectId: "clbomb",
    storageBucket: "clbomb.firebasestorage.app",
    messagingSenderId: "515939060816",
    appId: "1:515939060816:web:8a68d9d5f40b02c9029555"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  window.db = db;
  window.doc = doc;
  window.getDoc = getDoc;
  window.setDoc = setDoc;
  
  window.firebaseReady = true;
  window.dispatchEvent(new Event('firebaseLoaded'));
</script>

<style>
    footer { display: none !important; }
    .home-content { max-width: 800px; margin: 20px auto; padding: 20px; }
    .main-title { text-align: center; margin-bottom: 20px; font-size: 24px;}

    /* --- TOP COUNTERS & CLEAR BTN --- */
    .top-bar {
        display: flex; justify-content: space-between; align-items: center; 
        background: #1e1e1e; padding: 10px 20px; border-radius: 8px; 
        border: 1px solid #333; margin-bottom: 20px;
    }
    .counters { display: flex; gap: 15px; align-items: center; }
    .counter { font-size: 14px; color: #ccc; font-weight: bold; }
    .counter span { color: #3b82f6; font-size: 16px; }
    
    .btn-clear-all { 
        background-color: #ef4444; color: white; border: none; padding: 8px 15px; 
        border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s;
    }
    .btn-clear-all:hover { background-color: #dc2626; }

    /* --- TOGGLE CONTAINER --- */
    .toggle-container {
        display: flex; justify-content: center; align-items: center; gap: 30px; 
        margin-bottom: 20px; padding: 20px; background: #1e1e1e; border-radius: 12px; border: 1px solid #333;
    }
    .toggle-shape {
        width: 70px; height: 70px; cursor: pointer; transition: all 0.3s ease;
        border: 3px solid #333; display: flex; justify-content: center; align-items: center;
        font-weight: bold; font-size: 24px; color: white; user-select: none;
    }
    .toggle-shape:hover { opacity: 0.8; }

    .shape-circle { border-radius: 50%; }
    .shape-square { border-radius: 12px; }
    .shape-triangle {
        width: 0; height: 0; background-color: transparent !important;
        border-left: 40px solid transparent; border-right: 40px solid transparent;
        border-bottom: 70px solid #ef4444; border-radius: 0; position: relative;
    }
    .triangle-text { position: absolute; top: 25px; left: -10px; font-size: 18px; color: white; }

    .is-green.toggle-shape:not(.shape-triangle) { background-color: #10b981; box-shadow: 0 0 15px rgba(16, 185, 129, 0.5); }
    .is-green.shape-triangle { border-bottom-color: #10b981; box-shadow: 0 15px 15px -10px rgba(16, 185, 129, 0.5); }
    .is-red.toggle-shape:not(.shape-triangle) { background-color: #ef4444; box-shadow: 0 0 15px rgba(239, 68, 68, 0.5); }
    .is-red.shape-triangle { border-bottom-color: #ef4444; box-shadow: 0 15px 15px -10px rgba(239, 68, 68, 0.5); }

    /* --- INPUT AREA --- */
    .input-area { background: #1e1e1e; border: 1px solid #333; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    textarea {
        width: 100%; height: 120px; padding: 15px; font-size: 16px; background: #111; 
        border: 2px solid #444; border-radius: 8px; color: white; resize: vertical; 
        font-family: sans-serif; outline: none; margin-bottom: 15px; box-sizing: border-box;
    }
    textarea:focus { border-color: #3b82f6; }
    
    .btn { padding: 12px 20px; font-size: 16px; font-weight: bold; border: none; border-radius: 8px; cursor: pointer; color: white; transition: 0.2s; }
    .btn-add { background-color: #2e8555; width: 100%; }
    .btn-add:hover { background-color: #236b43; }
    .btn-apply { background-color: #3b82f6; width: 100%; margin-top: 20px; font-size: 18px; padding: 15px; }
    .btn-apply:hover { background-color: #2563eb; }

    /* List Area */
    .list-container { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
    .list-item {
        background: #222; border: 1px solid #444; border-radius: 8px; padding: 15px;
        display: flex; justify-content: space-between; align-items: center; gap: 15px; transition: 0.3s;
    }
    .list-item.confirmed { border-color: #2e8555; background: #1a2a22; }
    .list-item p { margin: 0; flex-grow: 1; font-size: 15px; line-height: 1.4; white-space: pre-wrap; word-break: break-word;}
    
    .edit-input {
        flex-grow: 1; padding: 8px 12px; font-size: 15px; background: #111; 
        border: 2px solid #3b82f6; border-radius: 6px; color: white; outline: none;
    }
    
    .item-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0;}
    
    .btn-go { background-color: #f59e0b; color: #000; font-weight: bold; padding: 8px 15px; border-radius: 6px; cursor: pointer; border: none; transition: 0.2s; }
    .btn-go:hover { background-color: #d97706; }
    .btn-go:disabled { background-color: #444; color: #888; cursor: not-allowed; }
    
    .btn-edit { background-color: #eab308; color: #000; padding: 8px 12px; border-radius: 6px; cursor: pointer; border: none; transition: 0.2s; font-weight: bold;}
    .btn-edit:hover { background-color: #ca8a04; }
    
    .btn-save { background-color: #10b981; color: white; padding: 8px 12px; border-radius: 6px; cursor: pointer; border: none; transition: 0.2s; font-weight: bold;}
    .btn-save:hover { background-color: #059669; }

    .btn-search { background-color: #8b5cf6; color: white; padding: 8px 12px; border-radius: 6px; cursor: pointer; border: none; transition: 0.2s; font-size: 16px; }
    .btn-search:hover { background-color: #7c3aed; }

    .btn-delete { background-color: #ef4444; color: white; padding: 8px 15px; border-radius: 6px; cursor: pointer; border: none; transition: 0.2s; }
    .btn-delete:hover { background-color: #dc2626; }
</style>

<main class="home-content">
    <div class="top-bar">
        <div class="counters">
            <div class="counter">Total: <span id="totalCount">0</span></div>
            <div class="counter">Confirmed: <span id="confirmedCount">0</span></div>
        </div>
        <button class="btn-clear-all" onclick="clearAllText()">🗑️ Clear All</button>
    </div>

    <div class="toggle-container">
        <div class="toggle-shape shape-circle is-red" id="circleToggle" onclick="toggleShape('circle')"></div>
        <div class="toggle-shape shape-triangle is-red" id="triangleToggle" onclick="clickTriangle()">
            <span class="triangle-text" id="triangleCount">7</span>
        </div>
        <div class="toggle-shape shape-square is-red" id="squareToggle" onclick="toggleShape('square')"></div>
    </div>

    <div class="input-area">
        <textarea id="bulkInput" placeholder="Paste or type multiple lines of text here. Click 'Split into Items' below."></textarea>
        <button class="btn btn-add" onclick="splitText()">Split into Items ⬇️</button>
    </div>

    <div class="list-container" id="listContainer"></div>

    <button class="btn btn-apply" onclick="applyAndGo()">Apply & Go to CLbomb ➔</button>
</main>

<script>
    let triangleClicks = 7;
    let items = [];
    let idCounter = 0;

    function toggleShape(shape) {
        const circle = document.getElementById('circleToggle');
        const square = document.getElementById('squareToggle');
        const triangle = document.getElementById('triangleToggle');

        if (shape === 'circle') {
            circle.classList.remove('is-red'); circle.classList.add('is-green');
            square.classList.remove('is-green'); square.classList.add('is-red');
            triangle.classList.remove('is-green'); triangle.classList.add('is-red');
            triangleClicks = 7; document.getElementById('triangleCount').textContent = triangleClicks;
        } 
        else if (shape === 'square') {
            square.classList.remove('is-red'); square.classList.add('is-green');
            circle.classList.remove('is-green'); circle.classList.add('is-red');
            triangle.classList.remove('is-green'); triangle.classList.add('is-red');
            triangleClicks = 7; document.getElementById('triangleCount').textContent = triangleClicks;
        }
    }

    function clickTriangle() {
        const triangle = document.getElementById('triangleToggle');
        const circle = document.getElementById('circleToggle');
        const square = document.getElementById('squareToggle');
        const countText = document.getElementById('triangleCount');

        if (triangle.classList.contains('is-green')) {
            triangleClicks = 7; countText.textContent = triangleClicks;
            triangle.classList.remove('is-green'); triangle.classList.add('is-red');
            return;
        }

        triangleClicks--;
        countText.textContent = triangleClicks;

        if (triangleClicks <= 0) {
            triangle.classList.remove('is-red'); triangle.classList.add('is-green');
            countText.textContent = "✓";
            circle.classList.remove('is-green'); circle.classList.add('is-red');
            square.classList.remove('is-green'); square.classList.add('is-red');
        }
    }

    function updateCounts() {
        document.getElementById('totalCount').textContent = items.length;
        document.getElementById('confirmedCount').textContent = items.filter(i => i.confirmed).length;
    }

    function splitText() {
        const rawText = document.getElementById('bulkInput').value;
        if (!rawText.trim()) return;

        const lines = rawText.split('\n').map(line => line.trim()).filter(line => line.length > 0);
        
        lines.forEach(line => {
            const isDuplicate = items.some(item => item.text === line);
            if (!isDuplicate) {
                items.push({ id: idCounter++, text: line, confirmed: false, isEditing: false });
            }
        });

        document.getElementById('bulkInput').value = "";
        renderList();
    }

    function clearAllText() {
        if(confirm("Are you sure you want to delete ALL texts in this list?")) {
            items = [];
            renderList();
        }
    }

    function renderList() {
        const container = document.getElementById('listContainer');
        container.innerHTML = '';
        
        items.forEach(item => {
            const div = document.createElement('div');
            div.className = `list-item ${item.confirmed ? 'confirmed' : ''}`;
            
            const safeText = item.text.replace(/'/g, "\\'");
            
            let textHtml = '';
            let actionHtml = '';

            if (item.isEditing) {
                textHtml = `<input type="text" class="edit-input" id="edit-input-${item.id}" value="${item.text.replace(/"/g, '&quot;')}" onkeypress="handleEditEnter(event, ${item.id})">`;
                actionHtml = `<div class="item-actions"><button class="btn-save" onclick="saveEdit(${item.id})">💾 Save</button></div>`;
            } else {
                textHtml = `<p>${item.text}</p>`;
                actionHtml = `
                    <div class="item-actions">
                        ${!item.confirmed ? `<button class="btn-go" onclick="confirmItem(${item.id})">GO</button>` : `<button class="btn-go" disabled>✅ Locked</button>`}
                        <button class="btn-edit" onclick="startEdit(${item.id})" title="Edit this text">✏️</button>
                        <button class="btn-search" onclick="searchInternet('${safeText}')" title="Search Google for this text">🌐</button>
                        <button class="btn-delete" onclick="deleteItem(${item.id})">❌</button>
                    </div>
                `;
            }

            div.innerHTML = textHtml + actionHtml;
            container.appendChild(div);
        });

        updateCounts();
    }

    function confirmItem(id) {
        const item = items.find(i => i.id === id);
        if (item) { item.confirmed = true; renderList(); }
    }

    function deleteItem(id) {
        items = items.filter(i => i.id !== id);
        renderList();
    }

    function searchInternet(text) {
        const query = encodeURIComponent(text);
        const url = `https://www.google.com/search?q=${query}`;
        const newWindow = window.open(url, '_blank', 'width=1200,height=900,menubar=yes,toolbar=yes,location=yes,status=yes');
        
        if (newWindow) {
            newWindow.moveTo(screen.width / 2, 0);
            newWindow.resizeTo(screen.width / 2, screen.height);
            newWindow.blur();
            window.focus();
        }
    }

    function startEdit(id) {
        const item = items.find(i => i.id === id);
        if (item) {
            item.isEditing = true;
            renderList();
            setTimeout(() => {
                const input = document.getElementById(`edit-input-${id}`);
                if (input) input.focus();
            }, 50);
        }
    }

    function saveEdit(id) {
        const input = document.getElementById(`edit-input-${id}`);
        if (!input) return;
        const newText = input.value.trim();
        if (newText === "") { alert("Text cannot be empty."); return; }

        const item = items.find(i => i.id === id);
        if (item) {
            const isDuplicate = items.some(i => i.id !== id && i.text === newText);
            if (isDuplicate) { alert("This text already exists in your list!"); return; }

            item.text = newText;
            item.isEditing = false;
            renderList();
        }
    }

    function handleEditEnter(event, id) {
        if (event.key === 'Enter') { saveEdit(id); }
    }

    // --- SAVE TO FIREBASE AND JUMP ---
    async function applyAndGo() {
        const confirmedTexts = items.filter(i => i.confirmed).map(i => i.text);
        if (confirmedTexts.length === 0) { alert("Please click 'GO' on at least one item before applying!"); return; }
        if (!window.firebaseReady) { alert("Database still loading, please try again."); return; }

        const btn = event.target;
        btn.textContent = "Saving to Cloud...";
        btn.disabled = true;

        try {
            // We save the queue in a special document called "current_queue"
            const docRef = window.doc(window.db, "clbomb_queue", "current_queue");
            const docSnap = await window.getDoc(docRef);
            
            let existingQueue = [];
            if (docSnap.exists()) {
                existingQueue = docSnap.data().texts || [];
            }

            // Combine the new texts with any old ones, then save
            let newQueue = [...confirmedTexts, ...existingQueue];
            await window.setDoc(docRef, { texts: newQueue });

            // Clear local page and jump
            items = [];
            renderList();
            window.location.href = '/my-website/clbomb/';

        } catch (error) {
            console.error("Error saving queue:", error);
            alert("Failed to save to database. Check internet connection.");
            btn.textContent = "Apply & Go to CLbomb ➔";
            btn.disabled = false;
        }
    }
</script>
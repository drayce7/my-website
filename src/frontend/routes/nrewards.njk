{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Fanbook Access</title>
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
      import { getFirestore, collection, getDocs } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore.js";
      const firebaseConfig = { apiKey: "AIzaSyBEqRVYykZiYnH6R1FdZDQ5XtkCRb5EsIw", authDomain: "clbomb.firebaseapp.com", projectId: "clbomb", storageBucket: "clbomb.firebasestorage.app", messagingSenderId: "515939060816", appId: "1:515939060816:web:8a68d9d5f40b02c9029555" };
      const app = initializeApp(firebaseConfig); window.db = getFirestore(app);
      window.collection = collection; window.getDocs = getDocs;
      window.firebaseReady = true; window.dispatchEvent(new Event('firebaseLoaded'));
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        body { background: #0a1128; min-height: 100vh; font-family: 'Playfair Display', serif; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        h1 { color: #e2e8f0; font-family: 'Caveat', cursive; font-size: 42px; margin: 30px 0; text-align: center; }
        .list-area { width: 100%; max-width: 600px; display: flex; flex-direction: column; gap: 15px; padding-bottom: 50px; }
        .artist-card { background: rgba(17, 24, 39, 0.8); border: 2px solid rgba(226, 232, 240, 0.2); border-radius: 15px; padding: 15px; display: flex; align-items: center; gap: 15px; cursor: pointer; transition: 0.2s; }
        .artist-card:hover { transform: scale(1.02); border-color: #3b82f6; }
        .artist-img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; }
        .artist-info h2 { color: #fff; font-size: 20px; margin-bottom: 5px; }
        .artist-info p { color: #8a7b72; font-size: 14px; }
    </style>
</head>
<body>
    <h1>Select Artist Fanbook</h1>
    <div class="list-area" id="listArea"><p style="color:white; text-align:center;">Loading...</p></div>

<script>
    window.addEventListener('firebaseLoaded', async () => {
        const snapshot = await window.getDocs(window.collection(window.db, "celebrities"));
        const list = document.getElementById('listArea');
        list.innerHTML = '';
        
        snapshot.forEach(doc => {
            const data = doc.data();
            const card = document.createElement('div');
            card.className = 'artist-card';
            
            const imgUrl = data.imageUrl || 'https://i.postimg.cc/k47Z4Y3F/pexels-photo-220453.jpg';
            
            card.innerHTML = `
                <img src="${imgUrl}" class="artist-img">
                <div class="artist-info">
                    <h2>${data.name}</h2>
                    <p>Click to view fanbook</p>
                </div>
            `;
            
            card.onclick = () => {
                sessionStorage.setItem('selectedArtist', JSON.stringify(data));
                window.location.href = '/my-website/fanbook/';
            };
            list.appendChild(card);
        });
    });
</script>
</body>
</html>
{% endraw %}